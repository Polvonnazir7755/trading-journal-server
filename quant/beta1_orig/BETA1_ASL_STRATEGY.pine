//@version=6
// ==============================================================
//  BETA 1 + LAOL — STRATEGY (ASL KODNING AYNAN O'ZI)
//
//  ASL INDIKATORDAN FARQI FAQAT SHU:
//    1) indicator(...)  ->  strategy(...)
//    2) alert(...) o'rniga strategy.entry/exit qo'shildi
//
//  MANTIQ, PARAMETRLAR, TAYMFREYMLAR — HAMMASI O'ZGARMAGAN:
//    - 25 ta taymfreym
//    - TP_MULTIPLIER = 8
//    - SL: f_find_next_extreme_candle(500 bar)
//    - S1/S2/S3/S4 ta'riflari asl holicha
//    - request.security asl holicha (yopilmagan sham)
// ==============================================================
strategy("BETA 1 + LAOL — Strategy", overlay=true,
     max_lines_count = 500, max_bars_back = 500,
     max_labels_count = 500, max_boxes_count = 500,
     initial_capital = 1000,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 100,
     commission_type = strategy.commission.cash_per_order,
     commission_value = 0,
     slippage = 0,
     calc_on_every_tick = false,
     process_orders_on_close = true,
     margin_long = 0, margin_short = 0)

// ---- FAQAT SAVDO SOZLAMALARI (asl mantiqqa tegmaydi) ----
gTR = "SAVDO (asl mantiqqa ta'sir qilmaydi)"
sigMode = input.string("FINAL ENTRY", "Qaysi signalda savdo?",
     options = ["FINAL ENTRY", "CONFIRMED", "IKKALASI"], group = gTR,
     tooltip = "Asl kodda 3 xil alert bor: FORMING, CONFIRMED, FINAL ENTRY.\nQaysi biri savdo ochishini tanlang.")
riskMode = input.string("Dollar $", "Risk turi", options = ["Foiz %", "Dollar $"], group = gTR)
riskPct  = input.float(2.0, "Risk %", minval = 0.1, step = 0.1, group = gTR)
riskUsd  = input.float(20.0, "Risk $", minval = 1.0, step = 5.0, group = gTR)
useComm  = input.bool(true, "Komissiya/slippage hisobga olinsin", group = gTR,
     tooltip = "Realistik natija uchun yoqing")
commUsd  = input.float(0.15, "Komissiya $ (bir tomonga)", minval = 0, step = 0.05, group = gTR)
slipTick = input.int(2, "Slippage (tick)", minval = 0, group = gTR)
useTP40  = input.bool(false, "TP = 40 pip (8R o'rniga)", group = gTR,
     tooltip = "Asl kodda ikkala target ham chiziladi. Qaysi biri asosiy - tanlang.")

gRD = "RADAR — yo'ldagi to'siqlar (asl mantiqqa tegmaydi)"
useRadar   = input.bool(false, "Radarni yoqish", group = gRD,
     tooltip = "TP yo'lidagi qarama-qarshi zonalarni va yechilmagan likvidlikni topadi")
radarMode  = input.string("Dinamik TP", "Radar rejimi",
     options = ["Dinamik TP", "Kirish filtri", "Adaptiv SL", "Hammasi"], group = gRD,
     tooltip = "Dinamik TP  = TP ni to'siqdan oldin qo'yadi (TAVSIYA)\nKirish filtri = to'siq yaqin bo'lsa kirmaydi\nAdaptiv SL  = xavf yaqinlashsa SL ni BE ga suradi")
scanOB     = input.bool(true,  "Qarama-qarshi OB/FVG", group = gRD)
scanLQ     = input.bool(true,  "Yechilmagan likvidlik (LAOL)", group = gRD)
scanHCS    = input.bool(true,  "HCS zonalar", group = gRD)
radarBuf   = input.float(0.15, "To'siq buferi (R)", minval = 0.0, step = 0.05, group = gRD,
     tooltip = "TP to'siqdan shuncha R oldin qo'yiladi")
minTPr     = input.float(1.5, "Minimal TP (R)", minval = 0.5, step = 0.5, group = gRD,
     tooltip = "To'siq juda yaqin bo'lsa — shu masofadan kam TP qo'yilmaydi")
blockBelow = input.float(2.0, "Kirish filtri: min bo'sh yo'l (R)", minval = 0.5, step = 0.5, group = gRD,
     tooltip = "To'siqqacha shundan kam bo'lsa savdoga kirmaydi")

gBE = "POZITSIYA BOSHQARUVI (asl mantiqqa tegmaydi)"
useBE    = input.bool(false, "Breakeven ko'chirish", group = gBE,
     tooltip = "Narx belgilangan R ga yetsa, SL kirish narxiga ko'chadi.\nZararni kamaytiradi, lekin ba'zi yutuqlarni ham yo'qotadi.")
beAtR    = input.float(1.5, "BE ga ko'chirish (R)", minval = 0.2, step = 0.1, group = gBE)
beOffset = input.float(0.0, "BE ofset (R) — kichik foyda qoldirish", minval = 0.0, step = 0.1, group = gBE,
     tooltip = "0.1 = SL kirishdan 0.1R yuqoriga qo'yiladi (komissiyani qoplaydi)")

useTrail = input.bool(false, "Trailing stop", group = gBE,
     tooltip = "SL narx ortidan suriladi. Foydani ushlaydi, lekin erta chiqarishi mumkin.")
trailR   = input.float(2.0, "Trailing masofa (R)", minval = 0.5, step = 0.5, group = gBE)
trailStartR = input.float(3.0, "Trailing boshlanishi (R)", minval = 0.5, step = 0.5, group = gBE)

usePartial = input.bool(false, "Qismiy chiqish (partial TP)", group = gBE,
     tooltip = "Pozitsiyaning bir qismini yaqinroq TP da yopadi.\n'6R ga borib SL oldi' muammosini hal qiladi.")
p1Pct    = input.int(50, "1-qism hajmi (%)", minval = 10, maxval = 90, group = gBE)
p1R      = input.float(2.0, "1-qism TP (R)", minval = 0.5, step = 0.5, group = gBE)
p2Pct    = input.int(30, "2-qism hajmi (%)", minval = 0, maxval = 60, group = gBE,
     tooltip = "0 = ikkinchi qism yo'q")
p2R      = input.float(4.0, "2-qism TP (R)", minval = 1.0, step = 0.5, group = gBE)

soft_start = input.bool(false, "SOFT START", group="||--- MUST BE ENABLED ---||")

show_hcs_boxes = true

