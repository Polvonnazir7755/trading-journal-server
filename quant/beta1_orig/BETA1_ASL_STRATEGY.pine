    f_calculate_patterns(22, tf23_o2, tf23_h2, tf23_l2, tf23_c2, tf23_o1, tf23_h1, tf23_l1, tf23_c1, tf23_o, tf23_h, tf23_l, tf23_c, tf23_t, tf23_conf)
    f_calculate_patterns(23, tf24_o2, tf24_h2, tf24_l2, tf24_c2, tf24_o1, tf24_h1, tf24_l1, tf24_c1, tf24_o, tf24_h, tf24_l, tf24_c, tf24_t, tf24_conf)
    f_calculate_patterns(24, tf25_o2, tf25_h2, tf25_l2, tf25_c2, tf25_o1, tf25_h1, tf25_l1, tf25_c1, tf25_o, tf25_h, tf25_l, tf25_c, tf25_t, tf25_conf)

f_add_or_merge_laol_line(laol_line_data[] lines, float level, string tf_label, bool is_bear, string category) =>
    tolerance = syminfo.mintick * 2
    merged = false
    bool found_broken = false
    if array.size(lines) > 0
        for laol in lines
            if math.abs(laol.level - level) < tolerance
                if laol.is_broken
                    found_broken := true
                    break
                if not str.contains(laol.tf_labels, tf_label)
                    laol.tf_labels := laol.tf_labels + "," + tf_label
                    laol.tf_count  := laol.tf_count + 1
                    if category == "INTRA"
                        laol.has_intra := true
                    else if category == "SCALP"
                        laol.has_scalp := true
                    else
                        laol.has_entry := true
                merged := true
                break
    if not merged and not found_broken
        new_laol = laol_line_data.new()
        new_laol.level      := level
        new_laol.tf_labels  := tf_label
        new_laol.creation_bar := bar_index
        new_laol.is_bear    := is_bear
        new_laol.tf_count   := 1
        new_laol.has_entry  := category == "ENTRY"
        new_laol.has_scalp  := category == "SCALP"
        new_laol.has_intra  := category == "INTRA"
        array.push(lines, new_laol)
    0

f_update_laol_lines(laol_line_data[] lines, bool is_bear, float current_price) =>
    int break_time = 0
    string break_tf = ""
    int intra_break_time = 0
    string intra_break_tf = ""
    int scalp_break_time = 0
    string scalp_break_tf = ""
    if array.size(lines) > 0
        for idx = array.size(lines) - 1 to 0
            if idx >= array.size(lines)
                continue
            laol = array.get(lines, idx)
            crossed = is_bear ? (current_price > laol.level) : (current_price < laol.level)
            if crossed and not laol.is_broken
                laol.is_broken  := true
                laol.break_bar  := bar_index
                if laol.has_intra
                    intra_break_time := time
                    intra_break_tf   := laol.tf_labels
                else if laol.has_scalp
                    scalp_break_time := time
                    scalp_break_tf   := laol.tf_labels
                else
                    break_time := time
                    break_tf   := laol.tf_labels
            if laol.is_broken and bar_index >= laol.break_bar + LAOL_DELETE_DELAY
                array.remove(lines, idx)
    [break_time, break_tf, intra_break_time, intra_break_tf, scalp_break_time, scalp_break_tf]

f_get_broken_laol(laol_line_data[] lines, bool require_multi) =>
    float result_level = na
    int result_tf_count = 0
    if array.size(lines) > 0
        for laol in lines
            if laol.is_broken and bar_index == laol.break_bar
                if not require_multi or laol.tf_count >= 2
                    result_level := laol.level
                    result_tf_count := laol.tf_count
                    break
    [result_level, result_tf_count]

f_merge_cross_category(laol_line_data[] entry_lines, laol_line_data[] scalp_lines, laol_line_data[] intra_lines, float level, string tf_label, bool is_bear) =>
    tolerance = syminfo.mintick * 2
    bool merged = false
    if array.size(intra_lines) > 0
        for laol in intra_lines
            if math.abs(laol.level - level) < tolerance and not laol.is_broken
                if not str.contains(laol.tf_labels, tf_label)
                    laol.tf_labels := laol.tf_labels + "," + tf_label
                    laol.tf_count  += 1
                merged := true
                break
    if not merged and array.size(scalp_lines) > 0
        for laol in scalp_lines
            if math.abs(laol.level - level) < tolerance and not laol.is_broken
                if not str.contains(laol.tf_labels, tf_label)
                    laol.tf_labels := laol.tf_labels + "," + tf_label
                    laol.tf_count  += 1
                merged := true
                break
    if not merged and array.size(entry_lines) > 0
        for laol in entry_lines
            if math.abs(laol.level - level) < tolerance and not laol.is_broken
                if not str.contains(laol.tf_labels, tf_label)
                    laol.tf_labels := laol.tf_labels + "," + tf_label
                    laol.tf_count  += 1
                merged := true
                break
    merged

f_scan_laol_in_box(laol_line_data[] laol_arr, float xtop, float xbot, bool is_bear, string laol_cat, string box_cat) =>
    color col  = laol_cat == "ENTRY" ? color.new(color.blue,  0) : color.new(color.green, 0)
    color lcol = laol_cat == "ENTRY" ? color.new(color.blue, 50) : color.new(color.green, 50)
    int   off  = laol_cat == "ENTRY" ? 15 : 30
    float tol  = syminfo.mintick * 3
    for ll in laol_arr
        if ll.is_broken
            continue
        if ll.level <= xtop and ll.level >= xbot
            bool already = false
            int  sz = array.size(xlaol_levels)
            if sz > 0
                for ei = 0 to sz - 1
                    if math.abs(array.get(xlaol_levels, ei) - ll.level) < tol and array.get(xlaol_cat, ei) == laol_cat
                        elbl = array.get(xlaol_labels, ei)
                        if not na(elbl)
                            cur_txt = label.get_text(elbl)
                            if not str.contains(cur_txt, box_cat)
                                label.set_text(elbl, cur_txt + "+" + box_cat)
                                label.set_color(elbl, color.new(color.purple, 40))
                        already := true
                        break
            if not already
                ln = line.new(bar_index, ll.level, bar_index + off, ll.level, color=col, width=1, style=line.style_dashed, extend=extend.none)
                lb = label.new(bar_index + off, ll.level, laol_cat + " LAOL [" + ll.tf_labels + "] in " + box_cat, style=label.style_label_left, color=lcol, textcolor=color.white, size=size.tiny)
                array.push(xlaol_lines,  ln)
                array.push(xlaol_labels, lb)
                array.push(xlaol_levels, ll.level)
                array.push(xlaol_bear,   is_bear)
                array.push(xlaol_cat,    laol_cat)
                array.push(xlaol_off,    off)
    0

f_manage_tf_boxes(tracked_box[] boxes, float p_h, float p_l, int p_t, bool p_conf, string tf_str) =>
    bear_retesting = false
    bull_retesting = false
    bear_retest_pattern = ""
    bull_retest_pattern = ""
    bear_retest_level = float(na)
    bull_retest_level = float(na)
    bear_est_retest = false
    bull_est_retest = false
    bear_est_retest_valid = false
    bull_est_retest_valid = false
    if array.size(boxes) > 0
        for idx = array.size(boxes) - 1 to 0
            if idx >= array.size(boxes)
                continue
            bx = array.get(boxes, idx)
            bool is_em = f_is_em_pattern(bx.pattern_text)
            if bx.state == "FORMING" and na(bx.box_obj) and p_conf
                bx.box_obj := box.new(bar_index, bx.top_val, bar_index + 50, bx.bottom_val, border_color = is_em ? color.new(bx.border_color, unretested_border_transparency) : bx.border_color, bgcolor = bx.box_color, extend = extend.right, border_style = line.style_dashed, border_width = 1, text = is_em ? bx.pattern_text : "", text_size = size.small, text_color = color.new(color.white, 100), text_halign = text.align_left, text_valign = text.align_top)
            if not na(bx.box_obj)
                if bx.has_been_retested
                    box.set_border_style(bx.box_obj, line.style_solid)
                    box.set_border_color(bx.box_obj, bx.border_color)
                else
                    box.set_border_style(bx.box_obj, line.style_dashed)
                    box.set_border_color(bx.box_obj, color.new(bx.border_color, unretested_border_transparency))
                box.set_bgcolor(bx.box_obj, bx.box_color)
            if bx.direction == "bear"
                if not na(p_h) and p_h > bx.original_top
                    if not na(bx.box_obj)
                        box.delete(bx.box_obj)
                    array.remove(boxes, idx)
                    continue
                if bx.state == "FORMING"
                    if p_conf
                        bx.state               := "ESTABLISHED"
                        bx.just_established    := true
                        tf_seconds              = timeframe.in_seconds(tf_str)
                        protection_candles      = f_is_entry(tf_str) ? 3 : 1
                        bx.protection_end_time := p_t + (tf_seconds * 1000 * protection_candles)
                        bx.protection_active   := true
                        bx.est_wick_high       := p_h
                        bx.est_wick_low        := p_l
                else if bx.state == "ESTABLISHED"
                    wick_zone_touched = not na(p_h) and p_h >= bx.bottom_val and p_h < bx.original_top
                    if bx.protection_active
                        if wick_zone_touched
                            wick_in_range = not na(bx.est_wick_high) and not na(bx.est_wick_low) and p_h >= bx.est_wick_low and p_h <= bx.est_wick_high
                            if wick_in_range
                                bx.state             := "EST_RETEST"
                                bx.has_est_retest    := true
                                bx.has_been_retested := true
                                bx.retest_type       := "EST+RETEST"
                                bear_est_retest      := true
                                bear_retest_pattern  := bx.pattern_text + " [EST+RET]"
                                bear_retest_level    := bx.original_top
                                if not na(bx.box_obj)
                                    box.set_border_style(bx.box_obj, line.style_solid)
                                    box.set_border_color(bx.box_obj, bx.border_color)
                            else
                                bx.state             := "FORMING_FRESH"
                                bx.has_been_retested := true
                                bear_retesting       := true
                                bear_retest_pattern  := bx.pattern_text + " [FRESH FORMING]"
                                bear_retest_level    := bx.original_top
                        if p_conf and p_t >= bx.protection_end_time
                            bx.protection_active := false
                            if bx.state == "ESTABLISHED"
                                bx.retest_type          := "FRESH"
                                bx.completed_est_retest := true
                    else
                        if wick_zone_touched
                            bx.state             := "RESPECTED"
                            bx.has_been_retested := true
                            bear_retesting       := true
                            bear_retest_pattern  := bx.pattern_text + " [FRESH]"
                            bear_retest_level    := bx.original_top
                            if not na(bx.box_obj)
                                box.set_border_style(bx.box_obj, line.style_solid)
                                box.set_border_color(bx.box_obj, bx.border_color)
                            if p_h > bx.bottom_val and p_h < bx.top_val
                                bx.bottom_val := p_h
                                if not na(bx.box_obj)
                                    box.set_bottom(bx.box_obj, bx.bottom_val)
                else if bx.state == "FORMING_FRESH"
                    wick_zone_touched = not na(p_h) and p_h >= bx.bottom_val and p_h < bx.original_top
                    if wick_zone_touched
                        bear_retesting      := true
                        bear_retest_pattern := bx.pattern_text + " [FRESH FORMING]"
                        bear_retest_level   := bx.original_top
                    if p_conf and p_t >= bx.protection_end_time
                        bx.state                := "RESPECTED"
                        bx.protection_active    := false
                        bx.retest_type          := "FRESH"
                        bx.completed_est_retest := true
                else if bx.state == "EST_RETEST"
                    wick_zone_touched = not na(p_h) and p_h >= bx.bottom_val and p_h < bx.original_top
                    bear_est_retest     := true
                    bear_retest_pattern := bx.pattern_text + " [EST+RET]"
                    bear_retest_level   := bx.original_top
                    if wick_zone_touched
                        bear_retesting := true
                    if p_conf and p_t >= bx.protection_end_time
                        bear_est_retest_valid   := true
                        bx.state                := "RESPECTED"
                        bx.protection_active    := false
                        bx.retest_type          := "FRESH"
                        bx.completed_est_retest := true
                else if bx.state == "RESPECTED"
                    is_touching = not na(p_h) and p_h >= bx.bottom_val and p_l <= bx.top_val
                    if is_touching
                        bear_retesting      := true
                        bear_retest_pattern := bx.pattern_text + " [" + bx.retest_type + "]"
                        bear_retest_level   := bx.original_top
                        if p_h > bx.bottom_val and p_h < bx.top_val
                            bx.bottom_val := p_h
                            if not na(bx.box_obj)
                                box.set_bottom(bx.box_obj, bx.bottom_val)
            else if bx.direction == "bull"
                if not na(p_l) and p_l < bx.original_bottom
                    if not na(bx.box_obj)
                        box.delete(bx.box_obj)
                    array.remove(boxes, idx)
                    continue
                if bx.state == "FORMING"
                    if p_conf
                        bx.state               := "ESTABLISHED"
                        bx.just_established    := true
                        tf_seconds              = timeframe.in_seconds(tf_str)
                        protection_candles      = f_is_entry(tf_str) ? 3 : 1
                        bx.protection_end_time := p_t + (tf_seconds * 1000 * protection_candles)
                        bx.protection_active   := true
                        bx.est_wick_high       := p_h
                        bx.est_wick_low        := p_l
                else if bx.state == "ESTABLISHED"
                    wick_zone_touched = not na(p_l) and p_l <= bx.top_val and p_l > bx.original_bottom
                    if bx.protection_active
                        if wick_zone_touched
                            wick_in_range = not na(bx.est_wick_high) and not na(bx.est_wick_low) and p_l >= bx.est_wick_low and p_l <= bx.est_wick_high
                            if wick_in_range
                                bx.state             := "EST_RETEST"
                                bx.has_est_retest    := true
                                bx.has_been_retested := true
                                bx.retest_type       := "EST+RETEST"
                                bull_est_retest      := true
                                bull_retest_pattern  := bx.pattern_text + " [EST+RET]"
                                bull_retest_level    := bx.original_bottom
                                if not na(bx.box_obj)
                                    box.set_border_style(bx.box_obj, line.style_solid)
                                    box.set_border_color(bx.box_obj, bx.border_color)
                            else
                                bx.state             := "FORMING_FRESH"
                                bx.has_been_retested := true
                                bull_retesting       := true
                                bull_retest_pattern  := bx.pattern_text + " [FRESH FORMING]"
                                bull_retest_level    := bx.original_bottom
                        if p_conf and p_t >= bx.protection_end_time
                            bx.protection_active := false
                            if bx.state == "ESTABLISHED"
                                bx.retest_type          := "FRESH"
                                bx.completed_est_retest := true
                    else
                        if wick_zone_touched
                            bx.state             := "RESPECTED"
                            bx.has_been_retested := true
                            bull_retesting       := true
                            bull_retest_pattern  := bx.pattern_text + " [FRESH]"
                            bull_retest_level    := bx.original_bottom
                            if not na(bx.box_obj)
                                box.set_border_style(bx.box_obj, line.style_solid)
                                box.set_border_color(bx.box_obj, bx.border_color)
                            if p_l < bx.top_val and p_l > bx.bottom_val
                                bx.top_val := p_l
                                if not na(bx.box_obj)
                                    box.set_top(bx.box_obj, bx.top_val)
                else if bx.state == "FORMING_FRESH"
                    wick_zone_touched = not na(p_l) and p_l <= bx.top_val and p_l > bx.original_bottom
                    if wick_zone_touched
                        bull_retesting      := true
                        bull_retest_pattern := bx.pattern_text + " [FRESH FORMING]"
                        bull_retest_level   := bx.original_bottom
                    if p_conf and p_t >= bx.protection_end_time
                        bx.state                := "RESPECTED"
                        bx.protection_active    := false
                        bx.retest_type          := "FRESH"
                        bx.completed_est_retest := true
                else if bx.state == "EST_RETEST"
                    wick_zone_touched = not na(p_l) and p_l <= bx.top_val and p_l > bx.original_bottom
                    bull_est_retest     := true
                    bull_retest_pattern := bx.pattern_text + " [EST+RET]"
                    bull_retest_level   := bx.original_bottom
                    if wick_zone_touched
                        bull_retesting := true
                    if p_conf and p_t >= bx.protection_end_time
                        bull_est_retest_valid   := true
                        bx.state                := "RESPECTED"
                        bx.protection_active    := false
                        bx.retest_type          := "FRESH"
                        bx.completed_est_retest := true
                else if bx.state == "RESPECTED"
                    is_touching = not na(p_l) and p_l <= bx.top_val and p_h >= bx.bottom_val
                    if is_touching
                        bull_retesting      := true
                        bull_retest_pattern := bx.pattern_text + " [" + bx.retest_type + "]"
                        bull_retest_level   := bx.original_bottom
                        if p_l < bx.top_val and p_l > bx.bottom_val
                            bx.top_val := p_l
                            if not na(bx.box_obj)
                                box.set_top(bx.box_obj, bx.top_val)
    [bear_retesting, bull_retesting, bear_retest_pattern, bull_retest_pattern, bear_retest_level, bull_retest_level, bear_est_retest, bull_est_retest, bear_est_retest_valid, bull_est_retest_valid]

f_create_box(tracked_box[] boxes, string direction, float top_v, float bottom_v, int creation_t, string pattern, string tf_str, bool is_intra, bool should_show) =>
    bool result = false
    if pattern != "" and not na(top_v) and not na(bottom_v) and not na(creation_t)
        exists = false
        for bx in boxes
            if bx.creation_time == creation_t and bx.direction == direction and bx.timeframe == tf_str
                exists := true
                break
        if not exists
            new_box = tracked_box.new()
            new_box.direction      := direction
            new_box.state          := "FORMING"
            new_box.top_val        := top_v
            new_box.bottom_val     := bottom_v
            new_box.original_top   := top_v
            new_box.original_bottom := bottom_v
            new_box.creation_time  := creation_t
            new_box.pattern_text   := pattern
            new_box.base_pattern   := pattern
            new_box.timeframe      := tf_str
            new_box.is_intra       := is_intra
            bool is_em = f_is_em_pattern(pattern)
            new_box.is_em_forming  := is_em
            if is_em
                tf_category = f_get_full_category(tf_str)
                if tf_category == "ENTRY"
                    new_box.box_color    := entry_box_color
                    new_box.border_color := entry_border_color
                else if tf_category == "SCALP"
                    new_box.box_color    := scalp_box_color
                    new_box.border_color := scalp_border_color
                else
                    new_box.box_color    := intra_box_color
                    new_box.border_color := intra_border_color
            else
                new_box.box_color    := color.new(color.white, 100)
                new_box.border_color := color.new(color.white, 100)
            array.unshift(boxes, new_box)
            result := true
    result

f_manage_hcs_boxes(hcs_box_data[] hcs_boxes, bool is_bear) =>
    bool any_retesting = false
    if array.size(hcs_boxes) > 0
        for idx = array.size(hcs_boxes) - 1 to 0
            if idx >= array.size(hcs_boxes)
                continue
            hcs = array.get(hcs_boxes, idx)
            if is_bear
                if not hcs.is_broken and high > hcs.top_val
                    hcs.is_broken := true
                    hcs.box_obj := box.new(hcs.creation_bar, hcs.top_val, bar_index + 50, hcs.bottom_val, border_color = hcs_bear_border, bgcolor = hcs_bear_bg, extend = extend.right, border_width = 2, border_style = line.style_solid, text = "HCS BROKEN [" + hcs.tf_label + "]", text_size = size.small, text_color = color.white, text_halign = text.align_left, text_valign = text.align_top)
                if hcs.is_broken and not na(hcs.box_obj)
                    if high >= hcs.bottom_val and high <= hcs.top_val
                        any_retesting := true
                    if low < hcs.bottom_val
                        box.delete(hcs.box_obj)
                        array.remove(hcs_boxes, idx)
                        continue
                    if low <= hcs.top_val and low >= hcs.bottom_val
                        if low < hcs.top_val
                            hcs.top_val := low
                            box.set_top(hcs.box_obj, hcs.top_val)
            else
                if not hcs.is_broken and low < hcs.bottom_val
                    hcs.is_broken := true
                    hcs.box_obj := box.new(hcs.creation_bar, hcs.top_val, bar_index + 50, hcs.bottom_val, border_color = hcs_bull_border, bgcolor = hcs_bull_bg, extend = extend.right, border_width = 2, border_style = line.style_solid, text = "HCS BROKEN [" + hcs.tf_label + "]", text_size = size.small, text_color = color.white, text_halign = text.align_left, text_valign = text.align_top)
                if hcs.is_broken and not na(hcs.box_obj)
                    if low >= hcs.bottom_val and low <= hcs.top_val
                        any_retesting := true
                    if high > hcs.top_val
                        box.delete(hcs.box_obj)
                        array.remove(hcs_boxes, idx)
                        continue
                    if low >= hcs.bottom_val and low <= hcs.top_val
                        if low > hcs.bottom_val
                            hcs.bottom_val := low
                            box.set_bottom(hcs.box_obj, hcs.bottom_val)
    any_retesting

int entry_sn_bear_count = 0
int entry_sn_bull_count = 0
int scalp_sn_bear_count = 0
int scalp_sn_bull_count = 0
int intra_sn_bear_count = 0
int intra_sn_bull_count = 0

for i = 0 to TF_COUNT - 1
    tf_str = array.get(TFS, i)
    tf_category = array.get(TF_CATEGORIES, i)
    if tf_category == "NONE"
        continue
    should_show = tf_category == "ENTRY" or tf_category == "SCALP" or (tf_category == "INTRA" and soft_start)
    i_h = array.get(arr_tf_h, i)
    i_l = array.get(arr_tf_l, i)
    i_t = array.get(arr_tf_t, i)
    i_conf = array.get(arr_tf_conf, i)
    i_bt = array.get(arr_tf_bt, i)
    i_bb = array.get(arr_tf_bb, i)
    i_fu_bear = array.get(arr_fu_bear, i)
    i_fu_bull = array.get(arr_fu_bull, i)
    i_sn_bear = array.get(arr_sn_bear, i)
    i_sn_bull = array.get(arr_sn_bull, i)
    if i_sn_bear
        if tf_category == "ENTRY"
            entry_sn_bear_count += 1
        else if tf_category == "SCALP"
            scalp_sn_bear_count += 1
        else if tf_category == "INTRA"
            intra_sn_bear_count += 1
    if i_sn_bull
        if tf_category == "ENTRY"
            entry_sn_bull_count += 1
        else if tf_category == "SCALP"
            scalp_sn_bull_count += 1
        else if tf_category == "INTRA"
            intra_sn_bull_count += 1
    i_second_bear      = array.get(arr_second_bear, i)
    i_second_bull      = array.get(arr_second_bull, i)
    i_laol_first_bear  = array.get(arr_laol_first_bear, i)
    i_laol_first_bull  = array.get(arr_laol_first_bull, i)
    if array.get(arr_bear_third_step, i) == 1 and i_conf
        ref_time = array.get(arr_bear_third_ref_time, i)
        if not na(ref_time) and i_t > ref_time
            ref_h = array.get(arr_bear_third_ref_h, i)
            ref_l = array.get(arr_bear_third_ref_l, i)
            if not na(ref_h) and not na(ref_l) and i_h > ref_h and i_l > ref_l
                array.set(arr_third_bear, i, true)
            array.set(arr_bear_third_step,     i, 0)
            array.set(arr_bear_third_ref_h,    i, na)
            array.set(arr_bear_third_ref_l,    i, na)
            array.set(arr_bear_third_ref_time, i, na)
    if i_second_bear and i_conf
        array.set(arr_bear_third_step,     i, 1)
        array.set(arr_bear_third_ref_h,    i, i_h)
        array.set(arr_bear_third_ref_l,    i, i_l)
        array.set(arr_bear_third_ref_time, i, i_t)
    if array.get(arr_bull_third_step, i) == 1 and i_conf
        ref_time = array.get(arr_bull_third_ref_time, i)
        if not na(ref_time) and i_t > ref_time
            ref_h = array.get(arr_bull_third_ref_h, i)
            ref_l = array.get(arr_bull_third_ref_l, i)
            if not na(ref_h) and not na(ref_l) and i_l < ref_l and i_h < ref_h
                array.set(arr_third_bull, i, true)
            array.set(arr_bull_third_step,     i, 0)
            array.set(arr_bull_third_ref_h,    i, na)
            array.set(arr_bull_third_ref_l,    i, na)
            array.set(arr_bull_third_ref_time, i, na)
    if i_second_bull and i_conf
        array.set(arr_bull_third_step,     i, 1)
        array.set(arr_bull_third_ref_h,    i, i_h)
        array.set(arr_bull_third_ref_l,    i, i_l)
        array.set(arr_bull_third_ref_time, i, i_t)
    if array.get(arr_bear_laol_step, i) == 1 and i_conf
        ref_time = array.get(arr_bear_laol_ref_time, i)
        if not na(ref_time) and i_t > ref_time
            ref_h = array.get(arr_bear_laol_ref_h, i)
            ref_l = array.get(arr_bear_laol_ref_l, i)
            if not na(ref_h) and not na(ref_l) and i_h > ref_h and i_l > ref_l
                array.set(arr_laol_bear, i, true)
            array.set(arr_bear_laol_step,     i, 0)
            array.set(arr_bear_laol_ref_h,    i, na)
            array.set(arr_bear_laol_ref_l,    i, na)
            array.set(arr_bear_laol_ref_time, i, na)
    if i_laol_first_bear and i_conf
        array.set(arr_bear_laol_step,     i, 1)
        array.set(arr_bear_laol_ref_h,    i, i_h)
        array.set(arr_bear_laol_ref_l,    i, i_l)
        array.set(arr_bear_laol_ref_time, i, i_t)
    if array.get(arr_bull_laol_step, i) == 1 and i_conf
        ref_time = array.get(arr_bull_laol_ref_time, i)
        if not na(ref_time) and i_t > ref_time
            ref_h = array.get(arr_bull_laol_ref_h, i)
            ref_l = array.get(arr_bull_laol_ref_l, i)
            if not na(ref_h) and not na(ref_l) and i_h < ref_h and i_l < ref_l
                array.set(arr_laol_bull, i, true)
            array.set(arr_bull_laol_step,     i, 0)
            array.set(arr_bull_laol_ref_h,    i, na)
            array.set(arr_bull_laol_ref_l,    i, na)
            array.set(arr_bull_laol_ref_time, i, na)
    if i_laol_first_bull and i_conf
        array.set(arr_bull_laol_step,     i, 1)
        array.set(arr_bull_laol_ref_h,    i, i_h)
        array.set(arr_bull_laol_ref_l,    i, i_l)
        array.set(arr_bull_laol_ref_time, i, i_t)
    i_third_bear = array.get(arr_third_bear, i)
    i_third_bull = array.get(arr_third_bull, i)
    i_first_bear = array.get(arr_first_bear, i)
    i_first_bull = array.get(arr_first_bull, i)
    i_laol_bear = array.get(arr_laol_bear, i)
    i_laol_bull = array.get(arr_laol_bull, i)
    bear_seq = array.get(arr_bear_seq, i)
    bull_seq = array.get(arr_bull_seq, i)
    i_x3_bear = i_third_bear or i_first_bear
    i_x3_bull = i_third_bull or i_first_bull
    [bear_step, bear_tbe] = f_update_seq(bear_seq, i_fu_bear, i_x3_bear, i_fu_bull, i_x3_bull, i_h, i_bt, tf_str, i_conf, true, i_h, i_l)
    [bull_step, bull_tbe] = f_update_seq(bull_seq, i_fu_bull, i_x3_bull, i_fu_bear, i_x3_bear, i_l, i_bb, tf_str, i_conf, false, i_h, i_l)
    array.set(arr_bear_seq, i, bear_seq)
    array.set(arr_bull_seq, i, bull_seq)
    sn_dbl_bear = i_sn_bear and (tf_category == "ENTRY" ? entry_sn_bear_count >= 2 : tf_category == "SCALP" ? scalp_sn_bear_count >= 2 : intra_sn_bear_count >= 2)
    sn_dbl_bull = i_sn_bull and (tf_category == "ENTRY" ? entry_sn_bull_count >= 2 : tf_category == "SCALP" ? scalp_sn_bull_count >= 2 : intra_sn_bull_count >= 2)
    bear_hcs = false
    bull_hcs = false
    bear_hcs_forming = false
    bull_hcs_forming = false
    if should_show
        tracked_box[] boxes = f_get_boxes(i)
        new_bear_fu_sn = i_fu_bear or i_sn_bear
        new_bull_fu_sn = i_fu_bull or i_sn_bull
        if array.size(boxes) > 0 and (new_bear_fu_sn or new_bull_fu_sn)
            for bx in boxes
                if bx.timeframe != tf_str or bx.creation_time == i_t or bx.state == "FORMING"
                    continue
                bx_has_fu_sn = str.contains(bx.base_pattern, "FU") or str.contains(bx.base_pattern, "SN")
                if not bx_has_fu_sn
                    continue
                if bx.direction == "bear" and new_bear_fu_sn
                    if not na(i_h) and i_h >= bx.bottom_val and i_h <= bx.original_top
                        if i_conf
                            if array.get(arr_last_bear_hcs_time, i) != i_t
                                bear_hcs := true
                                bx.hcs_count := bx.hcs_count + 1
                                bx.pattern_text := bx.base_pattern + " [HCS X" + str.tostring(bx.hcs_count) + "]"
                                array.set(arr_last_bear_hcs_time, i, i_t)
                                if show_hcs_boxes and bx.hcs_count == 1 and (tf_str == "50" or tf_str == "60")
                                    new_hcs = hcs_box_data.new()
                                    new_hcs.top_val := bx.original_top
                                    new_hcs.bottom_val := bx.original_bottom
                                    new_hcs.creation_bar := bar_index
                                    new_hcs.tf_label := array.get(TF_LABELS, i)
                                    new_hcs.direction := "bear"
                                    new_hcs.is_broken := false
                                    array.push(hcs_boxes_bear, new_hcs)
                        else
                            bear_hcs_forming := true
                if bx.direction == "bull" and new_bull_fu_sn
                    if not na(i_l) and i_l <= bx.top_val and i_l >= bx.original_bottom
                        if i_conf
                            if array.get(arr_last_bull_hcs_time, i) != i_t
                                bull_hcs := true
                                bx.hcs_count := bx.hcs_count + 1
                                bx.pattern_text := bx.base_pattern + " [HCS X" + str.tostring(bx.hcs_count) + "]"
                                array.set(arr_last_bull_hcs_time, i, i_t)
                                if show_hcs_boxes and bx.hcs_count == 1 and (tf_str == "50" or tf_str == "60")
                                    new_hcs = hcs_box_data.new()
                                    new_hcs.top_val := bx.original_top
                                    new_hcs.bottom_val := bx.original_bottom
                                    new_hcs.creation_bar := bar_index
                                    new_hcs.tf_label := array.get(TF_LABELS, i)
                                    new_hcs.direction := "bull"
                                    new_hcs.is_broken := false
                                    array.push(hcs_boxes_bull, new_hcs)
                        else
                            bull_hcs_forming := true
        array.set(arr_bear_hcs, i, bear_hcs)
        array.set(arr_bull_hcs, i, bull_hcs)
        array.set(arr_bear_hcs_forming, i, bear_hcs_forming)
        array.set(arr_bull_hcs_forming, i, bull_hcs_forming)
        bear_pattern = f_pattern_str(true, i_third_bear, i_first_bear, i_laol_bear, i_sn_bear, sn_dbl_bear, i_fu_bear, bear_tbe, bear_hcs, bear_hcs_forming)
        bull_pattern = f_pattern_str(false, i_third_bull, i_first_bull, i_laol_bull, i_sn_bull, sn_dbl_bull, i_fu_bull, bull_tbe, bull_hcs, bull_hcs_forming)
        if bear_pattern != "" and not na(i_h) and not na(i_bt) and not na(i_t)
            f_create_box(boxes, "bear", i_h, i_bt, i_t, bear_pattern, tf_str, tf_category == "INTRA", should_show)
        if bull_pattern != "" and not na(i_l) and not na(i_bb) and not na(i_t)
            f_create_box(boxes, "bull", i_bb, i_l, i_t, bull_pattern, tf_str, tf_category == "INTRA", should_show)
        [bear_ret, bull_ret, bear_pat, bull_pat, bear_lvl, bull_lvl, bear_est, bull_est, bear_est_valid, bull_est_valid] = f_manage_tf_boxes(boxes, i_h, i_l, i_t, i_conf, tf_str)
        array.set(arr_bear_retesting, i, bear_ret)
        array.set(arr_bull_retesting, i, bull_ret)
        array.set(arr_bear_retest_pattern, i, bear_pat)
        array.set(arr_bull_retest_pattern, i, bull_pat)
        array.set(arr_bear_retest_level, i, bear_lvl)
        array.set(arr_bull_retest_level, i, bull_lvl)
        array.set(arr_bear_est_retest, i, bear_est)
        array.set(arr_bull_est_retest, i, bull_est)
        array.set(arr_bear_est_retest_VALID, i, bear_est_valid)
        array.set(arr_bull_est_retest_VALID, i, bull_est_valid)
        if tf_category == "SCALP"
            for bx2 in boxes
                if not bx2.just_established
                    continue
                if not f_is_em_pattern(bx2.pattern_text)
                    bx2.just_established := false
                    continue
                bx2.just_established := false
                f_scan_laol_in_box(bear_laol_lines, bx2.original_top, bx2.original_bottom, true,  "ENTRY", "SCALP")
                f_scan_laol_in_box(bull_laol_lines, bx2.original_top, bx2.original_bottom, false, "ENTRY", "SCALP")
        if tf_category == "INTRA" and soft_start
            for bx3 in boxes
                if not bx3.just_established
                    continue
                if not f_is_em_pattern(bx3.pattern_text)
                    bx3.just_established := false
                    continue
                bx3.just_established := false
                f_scan_laol_in_box(bear_scalp_laol_lines, bx3.original_top, bx3.original_bottom, true,  "SCALP", "INTRA")
                f_scan_laol_in_box(bull_scalp_laol_lines, bx3.original_top, bx3.original_bottom, false, "SCALP", "INTRA")
                f_scan_laol_in_box(bear_laol_lines,       bx3.original_top, bx3.original_bottom, true,  "ENTRY", "INTRA")
                f_scan_laol_in_box(bull_laol_lines,       bx3.original_top, bx3.original_bottom, false, "ENTRY", "INTRA")
    if tf_category == "ENTRY" and should_show and i_conf
        i_laol_candle_bear = array.get(arr_laol_candle_bear, i)
        i_laol_candle_bull = array.get(arr_laol_candle_bull, i)
        if i_laol_candle_bear
            if not f_merge_cross_category(bear_laol_lines, bear_scalp_laol_lines, bear_intra_laol_lines, i_h, array.get(TF_LABELS, i), true)
                f_add_or_merge_laol_line(bear_laol_lines, i_h, array.get(TF_LABELS, i), true, "ENTRY")
            last_bear_laol_tf := array.get(TF_LABELS, i)
        if i_laol_candle_bull
            if not f_merge_cross_category(bull_laol_lines, bull_scalp_laol_lines, bull_intra_laol_lines, i_l, array.get(TF_LABELS, i), false)
                f_add_or_merge_laol_line(bull_laol_lines, i_l, array.get(TF_LABELS, i), false, "ENTRY")
            last_bull_laol_tf := array.get(TF_LABELS, i)
    if tf_category == "SCALP" and should_show and i_conf
        i_laol_candle_bear = array.get(arr_laol_candle_bear, i)
        i_laol_candle_bull = array.get(arr_laol_candle_bull, i)
        if i_laol_candle_bear
            if not f_merge_cross_category(bear_laol_lines, bear_scalp_laol_lines, bear_intra_laol_lines, i_h, array.get(TF_LABELS, i), true)
                f_add_or_merge_laol_line(bear_scalp_laol_lines, i_h, array.get(TF_LABELS, i), true, "SCALP")
            last_bear_scalp_laol_tf := array.get(TF_LABELS, i)
        if i_laol_candle_bull
            if not f_merge_cross_category(bull_laol_lines, bull_scalp_laol_lines, bull_intra_laol_lines, i_l, array.get(TF_LABELS, i), false)
                f_add_or_merge_laol_line(bull_scalp_laol_lines, i_l, array.get(TF_LABELS, i), false, "SCALP")
            last_bull_laol_tf := array.get(TF_LABELS, i)
    if tf_category == "INTRA" and i_conf
        i_laol_candle_bear = array.get(arr_laol_candle_bear, i)
        i_laol_candle_bull = array.get(arr_laol_candle_bull, i)
        if i_laol_candle_bear
            if not f_merge_cross_category(bear_laol_lines, bear_scalp_laol_lines, bear_intra_laol_lines, i_h, array.get(TF_LABELS, i), true)
                f_add_or_merge_laol_line(bear_intra_laol_lines, i_h, array.get(TF_LABELS, i), true, "INTRA")
            last_bear_intra_laol_tf := array.get(TF_LABELS, i)
        if i_laol_candle_bull
            if not f_merge_cross_category(bull_laol_lines, bull_scalp_laol_lines, bull_intra_laol_lines, i_l, array.get(TF_LABELS, i), false)
                f_add_or_merge_laol_line(bull_intra_laol_lines, i_l, array.get(TF_LABELS, i), false, "INTRA")
            last_bull_intra_laol_tf := array.get(TF_LABELS, i)

[bear_break_time, bear_break_tf, bear_intra_bt, bear_intra_btf, bear_scalp_bt, bear_scalp_btf] = f_update_laol_lines(bear_laol_lines, true, high)
[bull_break_time, bull_break_tf, bull_intra_bt, bull_intra_btf, bull_scalp_bt, bull_scalp_btf] = f_update_laol_lines(bull_laol_lines, false, low)

if bear_break_time > 0
    last_bear_laol_break_time := bear_break_time
    last_bear_laol_tf := bear_break_tf
if bull_break_time > 0
    last_bull_laol_break_time := bull_break_time
    last_bull_laol_tf := bull_break_tf
if bear_intra_bt > 0
    last_bear_intra_laol_break_time := bear_intra_bt
    last_bear_intra_laol_tf := bear_intra_btf
if bull_intra_bt > 0
    last_bull_intra_laol_break_time := bull_intra_bt
    last_bull_intra_laol_tf := bull_intra_btf
if bear_scalp_bt > 0
    last_bear_scalp_laol_break_time := bear_scalp_bt
    last_bear_scalp_laol_tf := bear_scalp_btf
if bull_scalp_bt > 0
    last_bull_scalp_laol_break_time := bull_scalp_bt
    last_bull_scalp_laol_tf := bull_scalp_btf

[d1a, d1b, bear_intra_bt2, bear_intra_btf2, bear_scalp_bt2, bear_scalp_btf2] = f_update_laol_lines(bear_scalp_laol_lines, true, high)
[d2a, d2b, bull_intra_bt2, bull_intra_btf2, bull_scalp_bt2, bull_scalp_btf2] = f_update_laol_lines(bull_scalp_laol_lines, false, low)

if bear_intra_bt2 > 0
    last_bear_intra_laol_break_time := bear_intra_bt2
    last_bear_intra_laol_tf := bear_intra_btf2
if bull_intra_bt2 > 0
    last_bull_intra_laol_break_time := bull_intra_bt2
    last_bull_intra_laol_tf := bull_intra_btf2
if bear_scalp_bt2 > 0
    last_bear_scalp_laol_break_time := bear_scalp_bt2
    last_bear_scalp_laol_tf := bear_scalp_btf2
if bull_scalp_bt2 > 0
    last_bull_scalp_laol_break_time := bull_scalp_bt2
    last_bull_scalp_laol_tf := bull_scalp_btf2

[d3a, d3b, bear_intra_bt3, bear_intra_btf3, d3c, d3d] = f_update_laol_lines(bear_intra_laol_lines, true, high)
[d4a, d4b, bull_intra_bt3, bull_intra_btf3, d4c, d4d] = f_update_laol_lines(bull_intra_laol_lines, false, low)

if bear_intra_bt3 > 0
    last_bear_intra_laol_break_time := bear_intra_bt3
    last_bear_intra_laol_tf := bear_intra_btf3
if bull_intra_bt3 > 0
    last_bull_intra_laol_break_time := bull_intra_bt3
    last_bull_intra_laol_tf := bull_intra_btf3

if show_hcs_boxes
    bool bear_hcs_ret = f_manage_hcs_boxes(hcs_boxes_bear, true)
    bool bull_hcs_ret = f_manage_hcs_boxes(hcs_boxes_bull, false)

array.clear(entry_forming)
array.clear(scalp_forming)
array.clear(intra_forming)
array.clear(entry_retesting)
array.clear(scalp_retesting)
array.clear(intra_retesting)
array.clear(intra_negation)

int intra_bear_em_total = 0
int intra_bull_em_total = 0
int entry_bear_em_forming = 0
int entry_bull_em_forming = 0
int entry_bear_em_est = 0
int entry_bull_em_est = 0
int entry_bear_em_ret = 0
int entry_bull_em_ret = 0
int entry_bear_hcs_m1 = 0
int entry_bull_hcs_m1 = 0
int scalp_bear_em_forming = 0
int scalp_bull_em_forming = 0
int intra_bear_em_forming = 0
int intra_bull_em_forming = 0
int scalp_bear_em_est = 0
int scalp_bull_em_est = 0
int scalp_bear_em_ret = 0
int scalp_bull_em_ret = 0
bool intra_bear_retesting = false
bool intra_bull_retesting = false
bool entry_has_est_retest_bear = false
bool entry_has_est_retest_bull = false
bool scalp_has_est_retest_bear = false
bool scalp_has_est_retest_bull = false
bool intra_has_est_retest_bear = false
bool intra_has_est_retest_bull = false
int entry_bear_est_ret_count = 0
int entry_bull_est_ret_count = 0
int scalp_bear_est_ret_count = 0
int scalp_bull_est_ret_count = 0
int intra_bear_est_ret_count = 0
int intra_bull_est_ret_count = 0
bool intra_bear_est_ret_dir_found = false
bool intra_bull_est_ret_dir_found = false
bool intra_bear_est_ret_box_found = false
bool intra_bull_est_ret_box_found = false
bool intra_bear_em_form_found = false
bool intra_bull_em_form_found = false
bool intra_bear_hcs_retesting = false
bool intra_bull_hcs_retesting = false

for i = INTRA_MIN_IDX to INTRA_MAX_IDX
    if array.get(arr_bear_hcs_retesting, i)
        intra_bear_hcs_retesting := true
        txt = "[" + array.get(TF_LABELS, i) + "] Bear HCS RETESTING"
        array.push(intra_retesting, txt)
    if array.get(arr_bull_hcs_retesting, i)
        intra_bull_hcs_retesting := true
        txt = "[" + array.get(TF_LABELS, i) + "] Bull HCS RETESTING"
        array.push(intra_retesting, txt)

for i = 0 to TF_COUNT - 1
    tf_category = array.get(TF_CATEGORIES, i)
    if tf_category == "NONE"
        continue
    tf_label = array.get(TF_LABELS, i)
    i_conf = array.get(arr_tf_conf, i)
    i_h = array.get(arr_tf_h, i)
    i_l = array.get(arr_tf_l, i)
    i_third_bear = array.get(arr_third_bear, i)
    i_third_bull = array.get(arr_third_bull, i)
    i_first_bear = array.get(arr_first_bear, i)
    i_first_bull = array.get(arr_first_bull, i)
    i_laol_bear = array.get(arr_laol_bear, i)
    i_laol_bull = array.get(arr_laol_bull, i)
    i_sn_bear = array.get(arr_sn_bear, i)
    i_sn_bull = array.get(arr_sn_bull, i)
    bear_hcs = array.get(arr_bear_hcs, i)
    bull_hcs = array.get(arr_bull_hcs, i)
    bear_hcs_forming = array.get(arr_bear_hcs_forming, i)
    bull_hcs_forming = array.get(arr_bull_hcs_forming, i)
    bear_tbe = array.get(arr_bear_seq, i).step == 5
    bull_tbe = array.get(arr_bull_seq, i).step == 5
    i_bear_retesting = array.get(arr_bear_retesting, i)
    i_bull_retesting = array.get(arr_bull_retesting, i)
    i_bear_est_retest = array.get(arr_bear_est_retest, i)
    i_bull_est_retest = array.get(arr_bull_est_retest, i)
    i_bear_est_retest_valid = array.get(arr_bear_est_retest_VALID, i)
    i_bull_est_retest_valid = array.get(arr_bull_est_retest_VALID, i)
    i_bear_retest_pattern = array.get(arr_bear_retest_pattern, i)
    i_bull_retest_pattern = array.get(arr_bull_retest_pattern, i)
    sn_dbl_bear = i_sn_bear and (tf_category == "ENTRY" ? entry_sn_bear_count >= 2 : tf_category == "SCALP" ? scalp_sn_bear_count >= 2 : intra_sn_bear_count >= 2)
    sn_dbl_bull = i_sn_bull and (tf_category == "ENTRY" ? entry_sn_bull_count >= 2 : tf_category == "SCALP" ? scalp_sn_bull_count >= 2 : intra_sn_bull_count >= 2)
    bear_is_em = i_third_bear or i_first_bear or i_laol_bear or sn_dbl_bear or bear_tbe or bear_hcs or bear_hcs_forming
    bull_is_em = i_third_bull or i_first_bull or i_laol_bull or sn_dbl_bull or bull_tbe or bull_hcs or bull_hcs_forming
    if not i_conf
        if tf_category == "ENTRY"
            if bear_is_em
                entry_bear_em_forming += 1
            if bull_is_em
                entry_bull_em_forming += 1
        else if tf_category == "SCALP"
            if bear_is_em
                scalp_bear_em_forming += 1
            if bull_is_em
                scalp_bull_em_forming += 1
        else if tf_category == "INTRA"
            if bear_is_em
                intra_bear_em_forming += 1
            if bull_is_em
                intra_bull_em_forming += 1
        if bear_is_em
            bear_pattern_forming = f_pattern_str(true, i_third_bear, i_first_bear, i_laol_bear, i_sn_bear, sn_dbl_bear, false, bear_tbe, bear_hcs, bear_hcs_forming)
            if bear_pattern_forming != ""
                txt = "[" + tf_label + "] " + bear_pattern_forming
                if tf_category == "ENTRY"
                    array.push(entry_forming, txt)
                else if tf_category == "SCALP"
                    array.push(scalp_forming, txt)
                else if tf_category == "INTRA"
                    array.push(intra_forming, txt)
        if bull_is_em
            bull_pattern_forming = f_pattern_str(false, i_third_bull, i_first_bull, i_laol_bull, i_sn_bull, sn_dbl_bull, false, bull_tbe, bull_hcs, bull_hcs_forming)
            if bull_pattern_forming != ""
                txt = "[" + tf_label + "] " + bull_pattern_forming
                if tf_category == "ENTRY"
                    array.push(entry_forming, txt)
                else if tf_category == "SCALP"
                    array.push(scalp_forming, txt)
                else if tf_category == "INTRA"
                    array.push(intra_forming, txt)
    boxes = f_get_boxes(i)
    if array.size(boxes) > 0
        for bx in boxes
            bool is_em = f_is_em_pattern(bx.base_pattern)
            bool is_fu_sn = f_is_fu_pattern(bx.base_pattern)
            bool should_check = tf_category == "SCALP" ? (is_em or is_fu_sn) : is_em
            if not should_check
                continue
            is_active = bx.state == "FORMING" or bx.state == "ESTABLISHED" or bx.state == "EST_RETEST" or bx.state == "RESPECTED"
            if not is_active
                continue
            txt = "[" + tf_label + "] " + bx.pattern_text
            bool bear_touching = bx.direction == "bear" and not na(i_h) and i_h >= bx.bottom_val and i_h <= bx.top_val
            bool bull_touching = bx.direction == "bull" and not na(i_l) and i_l <= bx.top_val and i_l >= bx.bottom_val
            bool has_em_modifier = str.contains(bx.base_pattern, "Third") or str.contains(bx.base_pattern, "First") or str.contains(bx.base_pattern, "LAOL") or str.contains(bx.base_pattern, "[EM]") or str.contains(bx.base_pattern, "TBE") or str.contains(bx.base_pattern, "HCS")
            if bx.direction == "bear"
                if tf_category == "ENTRY"
                    if is_active and is_em
                        entry_bear_em_est += 1
                    if bear_touching and bx.state != "EST_RETEST" and bx.state != "FORMING"
                        entry_bear_em_ret += 1
                        f_push_unique(entry_retesting, txt)
                    if i == 0 and i_conf and is_active and bear_hcs and array.get(arr_last_bear_hcs_time, 0) == array.get(arr_tf_t, 0)
                        entry_bear_hcs_m1 += 1
                    if is_em and has_em_modifier and bx.state == "ESTABLISHED" and bx.creation_time > entry_bear_lv.est_time
                        entry_bear_lv.pattern_text := txt
                        entry_bear_lv.original_text := txt
                        entry_bear_lv.level := bx.original_top
                        entry_bear_lv.est_time := bx.creation_time
                        entry_bear_lv.direction := "bear"
                        entry_bear_lv.is_broken := false
                else if tf_category == "SCALP"
                    if is_active and is_em
                        scalp_bear_em_est += 1
                    if bear_touching and (is_em or is_fu_sn) and bx.state != "EST_RETEST" and bx.state != "FORMING"
                        scalp_bear_em_ret += 1
                        f_push_unique(scalp_retesting, txt)
                    if is_em and has_em_modifier and bx.state == "ESTABLISHED" and bx.creation_time > scalp_bear_lv.est_time
                        scalp_bear_lv.pattern_text := txt
                        scalp_bear_lv.original_text := txt
                        scalp_bear_lv.level := bx.original_top
                        scalp_bear_lv.est_time := bx.creation_time
                        scalp_bear_lv.direction := "bear"
                        scalp_bear_lv.is_broken := false
                else if tf_category == "INTRA"
                    if is_active and is_em
                        intra_bear_em_total += 1
                    if bear_touching and is_em and bx.state != "EST_RETEST" and bx.state != "FORMING"
                        intra_bear_retesting := true
                        f_push_unique(intra_retesting, txt)
                    if is_em and has_em_modifier and bx.state == "ESTABLISHED" and bx.creation_time > intra_bear_lv.est_time
                        intra_bear_lv.pattern_text := txt
                        intra_bear_lv.original_text := txt
                        intra_bear_lv.level := bx.original_top
                        intra_bear_lv.est_time := bx.creation_time
                        intra_bear_lv.direction := "bear"
                        intra_bear_lv.is_broken := false
                    if bx.has_est_retest and (bx.state == "EST_RETEST" or (bx.state == "RESPECTED" and bx.completed_est_retest))
                        intra_bear_est_ret_box_found := true
                    if bx.is_em_forming and (bx.state == "FORMING" or bx.state == "ESTABLISHED")
                        intra_bear_em_form_found := true
            else if bx.direction == "bull"
                if tf_category == "ENTRY"
                    if is_active and is_em
                        entry_bull_em_est += 1
                    if bull_touching and bx.state != "EST_RETEST" and bx.state != "FORMING"
                        entry_bull_em_ret += 1
                        f_push_unique(entry_retesting, txt)
                    if i == 0 and i_conf and is_active and bull_hcs and array.get(arr_last_bull_hcs_time, 0) == array.get(arr_tf_t, 0)
                        entry_bull_hcs_m1 += 1
                    if is_em and has_em_modifier and bx.state == "ESTABLISHED" and bx.creation_time > entry_bull_lv.est_time
                        entry_bull_lv.pattern_text := txt
                        entry_bull_lv.original_text := txt
                        entry_bull_lv.level := bx.original_bottom
                        entry_bull_lv.est_time := bx.creation_time
                        entry_bull_lv.direction := "bull"
                        entry_bull_lv.is_broken := false
                else if tf_category == "SCALP"
                    if is_active and is_em
                        scalp_bull_em_est += 1
                    if bull_touching and (is_em or is_fu_sn) and bx.state != "EST_RETEST" and bx.state != "FORMING"
                        scalp_bull_em_ret += 1
                        f_push_unique(scalp_retesting, txt)
                    if is_em and has_em_modifier and bx.state == "ESTABLISHED" and bx.creation_time > scalp_bull_lv.est_time
                        scalp_bull_lv.pattern_text := txt
                        scalp_bull_lv.original_text := txt
                        scalp_bull_lv.level := bx.original_bottom
                        scalp_bull_lv.est_time := bx.creation_time
                        scalp_bull_lv.direction := "bull"
                        scalp_bull_lv.is_broken := false
                else if tf_category == "INTRA"
                    if is_active and is_em
                        intra_bull_em_total += 1
                    if bull_touching and is_em and bx.state != "EST_RETEST" and bx.state != "FORMING"
                        intra_bull_retesting := true
                        f_push_unique(intra_retesting, txt)
                    if is_em and has_em_modifier and bx.state == "ESTABLISHED" and bx.creation_time > intra_bull_lv.est_time
                        intra_bull_lv.pattern_text := txt
                        intra_bull_lv.original_text := txt
                        intra_bull_lv.level := bx.original_bottom
                        intra_bull_lv.est_time := bx.creation_time
                        intra_bull_lv.direction := "bull"
                        intra_bull_lv.is_broken := false
                    if bx.has_est_retest and (bx.state == "EST_RETEST" or (bx.state == "RESPECTED" and bx.completed_est_retest))
                        intra_bull_est_ret_box_found := true
                    if bx.is_em_forming and (bx.state == "FORMING" or bx.state == "ESTABLISHED")
                        intra_bull_em_form_found := true
    if tf_category == "ENTRY"
        if i_bear_est_retest
            entry_bear_est_ret_count += 1
            if i_bear_retest_pattern != ""
                array.push(entry_forming, "[" + tf_label + "] " + i_bear_retest_pattern)
        if i_bull_est_retest
            entry_bull_est_ret_count += 1
            if i_bull_retest_pattern != ""
                array.push(entry_forming, "[" + tf_label + "] " + i_bull_retest_pattern)
        if i_bear_est_retest_valid
            entry_has_est_retest_bear := true
        if i_bull_est_retest_valid
            entry_has_est_retest_bull := true
    else if tf_category == "SCALP"
        if i_bear_est_retest
            scalp_bear_est_ret_count += 1
            if i_bear_retest_pattern != ""
                array.push(scalp_forming, "[" + tf_label + "] " + i_bear_retest_pattern)
        if i_bull_est_retest
            scalp_bull_est_ret_count += 1
            if i_bull_retest_pattern != ""
                array.push(scalp_forming, "[" + tf_label + "] " + i_bull_retest_pattern)
        if i_bear_est_retest_valid
            scalp_has_est_retest_bear := true
        if i_bull_est_retest_valid
            scalp_has_est_retest_bull := true
    else if tf_category == "INTRA"
        if i_bear_est_retest
            intra_bear_est_ret_count += 1
            intra_bear_est_ret_dir_found := true
            if i_bear_retest_pattern != ""
                array.push(intra_forming, "[" + tf_label + "] " + i_bear_retest_pattern)
        if i_bull_est_retest
            intra_bull_est_ret_count += 1
            intra_bull_est_ret_dir_found := true
            if i_bull_retest_pattern != ""
                array.push(intra_forming, "[" + tf_label + "] " + i_bull_retest_pattern)
        if i_bear_est_retest_valid
            intra_has_est_retest_bear := true
        if i_bull_est_retest_valid
            intra_has_est_retest_bull := true

f_check_break(entry_bear_lv, high, low)
f_check_break(entry_bull_lv, high, low)
f_check_break(scalp_bear_lv, high, low)
f_check_break(scalp_bull_lv, high, low)
f_check_break(intra_bear_lv, high, low)
f_check_break(intra_bull_lv, high, low)

[entry_last_valid_final, entry_last_valid_dir, entry_last_valid_original_dir, entry_lv_broken] = f_resolve_last_valid(entry_bear_lv, entry_bull_lv)
[scalp_last_valid_final, scalp_last_valid_dir, scalp_last_valid_original_dir, scalp_lv_broken] = f_resolve_last_valid(scalp_bear_lv, scalp_bull_lv)
[intra_last_valid_final, intra_last_valid_dir, intra_last_valid_original_dir, intra_lv_broken] = f_resolve_last_valid(intra_bear_lv, intra_bull_lv)

intra_bear_negating := false
intra_bull_negating := false
intra_bear_negating_pattern := ""
intra_bull_negating_pattern := ""

bool check_bear_neg = intra_last_valid_dir == "bull" and not intra_lv_broken
bool check_bull_neg = intra_last_valid_dir == "bear" and not intra_lv_broken

if check_bear_neg or check_bull_neg
    for i = INTRA_MIN_IDX to INTRA_MAX_IDX
        if intra_bear_negating and intra_bull_negating
            break
        tf_label = array.get(TF_LABELS, i)
        i_conf = array.get(arr_tf_conf, i)
        if check_bear_neg and not intra_bear_negating
            i_third_bear = array.get(arr_third_bear, i)
            i_first_bear = array.get(arr_first_bear, i)
            i_laol_bear = array.get(arr_laol_bear, i)
            i_sn_bear = array.get(arr_sn_bear, i)
            i_bear_hcs = array.get(arr_bear_hcs, i)
            i_bear_hcs_forming = array.get(arr_bear_hcs_forming, i)
            bear_seq = array.get(arr_bear_seq, i)
            bear_tbe = bear_seq.step == 5
            sn_dbl_bear = i_sn_bear and intra_sn_bear_count >= 2
            bool bear_em_detected = i_third_bear or i_first_bear or i_laol_bear or sn_dbl_bear or bear_tbe or i_bear_hcs or i_bear_hcs_forming
            if bear_em_detected
                intra_bear_negating := true
                bear_pattern = f_pattern_str(true, i_third_bear, i_first_bear, i_laol_bear, i_sn_bear, sn_dbl_bear, false, bear_tbe, i_bear_hcs, i_bear_hcs_forming)
                string conf_status = i_conf ? "" : " [FORMING]"
                intra_bear_negating_pattern := "[" + tf_label + "] " + bear_pattern + conf_status
        if check_bull_neg and not intra_bull_negating
            i_third_bull = array.get(arr_third_bull, i)
            i_first_bull = array.get(arr_first_bull, i)
            i_laol_bull = array.get(arr_laol_bull, i)
            i_sn_bull = array.get(arr_sn_bull, i)
            i_bull_hcs = array.get(arr_bull_hcs, i)
            i_bull_hcs_forming = array.get(arr_bull_hcs_forming, i)
            bull_seq = array.get(arr_bull_seq, i)
            bull_tbe = bull_seq.step == 5
            sn_dbl_bull = i_sn_bull and intra_sn_bull_count >= 2
            bool bull_em_detected = i_third_bull or i_first_bull or i_laol_bull or sn_dbl_bull or bull_tbe or i_bull_hcs or i_bull_hcs_forming
            if bull_em_detected
                intra_bull_negating := true
                bull_pattern = f_pattern_str(false, i_third_bull, i_first_bull, i_laol_bull, i_sn_bull, sn_dbl_bull, false, bull_tbe, i_bull_hcs, i_bull_hcs_forming)
                string conf_status = i_conf ? "" : " [FORMING]"
                intra_bull_negating_pattern := "[" + tf_label + "] " + bull_pattern + conf_status

if intra_bear_negating and intra_bear_negating_pattern != ""
    array.push(intra_negation, intra_bear_negating_pattern)
if intra_bull_negating and intra_bull_negating_pattern != ""
    array.push(intra_negation, intra_bull_negating_pattern)

for i = 0 to TF_COUNT - 1
    array.set(arr_fu_bear,              i, false)
    array.set(arr_fu_bull,              i, false)
    array.set(arr_sn_bear,              i, false)
    array.set(arr_sn_bull,              i, false)
    array.set(arr_first_bear,           i, false)
    array.set(arr_first_bull,           i, false)
    array.set(arr_second_bear,          i, false)
    array.set(arr_second_bull,          i, false)
    array.set(arr_third_bear,           i, false)
    array.set(arr_third_bull,           i, false)
    array.set(arr_laol_bear,            i, false)
    array.set(arr_laol_bull,            i, false)
    array.set(arr_bear_hcs,             i, false)
    array.set(arr_bull_hcs,             i, false)
    array.set(arr_bear_hcs_forming,     i, false)
    array.set(arr_bull_hcs_forming,     i, false)
    array.set(arr_bear_retesting,       i, false)
    array.set(arr_bull_retesting,       i, false)
    array.set(arr_bear_est_retest,      i, false)
    array.set(arr_bull_est_retest,      i, false)
    array.set(arr_bear_est_retest_VALID, i, false)
    array.set(arr_bull_est_retest_VALID, i, false)
    array.set(arr_bear_retest_pattern,  i, "")
    array.set(arr_bull_retest_pattern,  i, "")
    array.set(arr_bear_retest_level,    i, na)
    array.set(arr_bull_retest_level,    i, na)

bool m1_conf = array.get(arr_tf_conf, 0)

bool bear_base_s1 = false
bool bear_base_s2 = false
bool bear_base_s3 = false
bool bear_base_s4 = false
bool bear_base_valid = false
string bear_base_type = ""

if entry_last_valid_dir == "bear" and not entry_lv_broken and scalp_last_valid_dir == "bear" and not scalp_lv_broken
    int scalp_bear_total = scalp_bear_em_est + scalp_bear_em_forming
    int entry_bear_total = entry_bear_em_est + entry_bear_em_forming
    bear_base_s1 := scalp_bear_total > 0 and entry_bear_total > 0 and entry_bear_em_ret > 0
    bear_base_s2 := scalp_bear_total > 0 and scalp_bear_em_ret > 0 and entry_bear_total > 0 and entry_bear_em_ret > 0
    bear_base_s3 := scalp_bear_em_forming >= 1 and entry_bear_total > 0 and entry_bear_em_ret > 0
    bear_base_s4 := entry_bear_hcs_m1 >= 1
    bear_base_valid := bear_base_s1 or bear_base_s2 or bear_base_s3 or bear_base_s4
    if bear_base_s4
        bear_base_type := "S4"
    else
        string[] bear_parts = array.new_string()
        if bear_base_s1
            array.push(bear_parts, "S1")
        if bear_base_s2
            array.push(bear_parts, "S2")
        if bear_base_s3
            array.push(bear_parts, "S3")
        bear_base_type := array.size(bear_parts) > 0 ? array.join(bear_parts, "+") : ""

bool bull_base_s1 = false
bool bull_base_s2 = false
bool bull_base_s3 = false
bool bull_base_s4 = false
bool bull_base_valid = false
string bull_base_type = ""

if entry_last_valid_dir == "bull" and not entry_lv_broken and scalp_last_valid_dir == "bull" and not scalp_lv_broken
    int scalp_bull_total = scalp_bull_em_est + scalp_bull_em_forming
    int entry_bull_total = entry_bull_em_est + entry_bull_em_forming
    bull_base_s1 := scalp_bull_total > 0 and entry_bull_total > 0 and entry_bull_em_ret > 0
    bull_base_s2 := scalp_bull_total > 0 and scalp_bull_em_ret > 0 and entry_bull_total > 0 and entry_bull_em_ret > 0
    bull_base_s3 := scalp_bull_em_forming >= 1 and entry_bull_total > 0 and entry_bull_em_ret > 0
    bull_base_s4 := entry_bull_hcs_m1 >= 1
    bull_base_valid := bull_base_s1 or bull_base_s2 or bull_base_s3 or bull_base_s4
    if bull_base_s4
        bull_base_type := "S4"
    else
        string[] bull_parts = array.new_string()
        if bull_base_s1
            array.push(bull_parts, "S1")
        if bull_base_s2
            array.push(bull_parts, "S2")
        if bull_base_s3
            array.push(bull_parts, "S3")
        bull_base_type := array.size(bull_parts) > 0 ? array.join(bull_parts, "+") : ""

bool bear_has_base_foundation = false
if entry_last_valid_dir == "bear" and not entry_lv_broken and scalp_last_valid_dir == "bear" and not scalp_lv_broken
    int scalp_bear_total = scalp_bear_em_est + scalp_bear_em_forming
    int entry_bear_total = entry_bear_em_est + entry_bear_em_forming
    bool s1_met = scalp_bear_total > 0 and entry_bear_total > 0 and entry_bear_em_ret > 0
    bool s2_met = scalp_bear_total > 0 and scalp_bear_em_ret > 0 and entry_bear_total > 0 and entry_bear_em_ret > 0
    bool s3_met = scalp_bear_em_forming >= 1 and entry_bear_total > 0 and entry_bear_em_ret > 0
    bool s4_met = entry_bear_hcs_m1 >= 1
    bear_has_base_foundation := s1_met or s2_met or s3_met or s4_met

bool bear_intra_est_valid = false
bool bear_intra_em_valid = false
bool bear_intra_lv_valid = false
bool bear_intra_neg_valid = false
bool bear_zone_valid = false

if bear_has_base_foundation
    bear_intra_est_valid := intra_last_valid_dir == "bear" and not intra_lv_broken and intra_bear_est_ret_dir_found and intra_bear_est_ret_box_found
    bear_intra_em_valid := intra_last_valid_dir == "bear" and not intra_lv_broken and intra_bear_em_form_found
    bear_intra_lv_valid := intra_last_valid_dir == "bear" and not intra_lv_broken
    bool bear_neg_hcs_condition = intra_bear_hcs_retesting or intra_bull_hcs_retesting or (intra_bear_em_form_found and str.contains(intra_bear_negating_pattern, "HCS"))
    bear_intra_neg_valid := intra_last_valid_original_dir == "bull" and not intra_lv_broken and intra_bear_negating and bear_neg_hcs_condition
    bear_zone_valid := intra_bear_hcs_retesting and intra_bear_negating

bool bull_has_base_foundation = false
if entry_last_valid_dir == "bull" and not entry_lv_broken and scalp_last_valid_dir == "bull" and not scalp_lv_broken
    int scalp_bull_total = scalp_bull_em_est + scalp_bull_em_forming
    int entry_bull_total = entry_bull_em_est + entry_bull_em_forming
    bool s1_met = scalp_bull_total > 0 and entry_bull_total > 0 and entry_bull_em_ret > 0
    bool s2_met = scalp_bull_total > 0 and scalp_bull_em_ret > 0 and entry_bull_total > 0 and entry_bull_em_ret > 0
    bool s3_met = scalp_bull_em_forming >= 1 and entry_bull_total > 0 and entry_bull_em_ret > 0
    bool s4_met = entry_bull_hcs_m1 >= 1
    bull_has_base_foundation := s1_met or s2_met or s3_met or s4_met

bool bull_intra_est_valid = false
bool bull_intra_em_valid = false
bool bull_intra_lv_valid = false
bool bull_intra_neg_valid = false
bool bull_zone_valid = false
show_setups_s1_s4 = true

if bull_has_base_foundation
    bull_intra_est_valid := intra_last_valid_dir == "bull" and not intra_lv_broken and intra_bull_est_ret_dir_found and intra_bull_est_ret_box_found
    bull_intra_em_valid := intra_last_valid_dir == "bull" and not intra_lv_broken and intra_bull_em_form_found
    bull_intra_lv_valid := intra_last_valid_dir == "bull" and not intra_lv_broken
    bool bull_neg_hcs_condition = intra_bear_hcs_retesting or intra_bull_hcs_retesting or (intra_bull_em_form_found and str.contains(intra_bull_negating_pattern, "HCS"))
    bull_intra_neg_valid := intra_last_valid_original_dir == "bear" and not intra_lv_broken and intra_bull_negating and bull_neg_hcs_condition
    bull_zone_valid := intra_bull_hcs_retesting and intra_bull_negating

bool bear_base_confirmed = bear_base_valid and m1_conf and show_setups_s1_s4
bool bear_intra_est_confirmed = bear_intra_est_valid and m1_conf and show_intra_est_retest
bool bear_intra_em_confirmed = bear_intra_em_valid and m1_conf and show_intra_em_forming
bool bear_intra_lv_confirmed = bear_intra_lv_valid and m1_conf and show_intra_lv_aligned
bool bear_intra_neg_confirmed = bear_intra_neg_valid and m1_conf and show_intra_negation
bool bear_zone_confirmed = bear_zone_valid and m1_conf and show_intra_negation

bool bull_base_confirmed = bull_base_valid and m1_conf and show_setups_s1_s4
bool bull_intra_est_confirmed = bull_intra_est_valid and m1_conf and show_intra_est_retest
bool bull_intra_em_confirmed = bull_intra_em_valid and m1_conf and show_intra_em_forming
bool bull_intra_lv_confirmed = bull_intra_lv_valid and m1_conf and show_intra_lv_aligned
bool bull_intra_neg_confirmed = bull_intra_neg_valid and m1_conf and show_intra_negation
bool bull_zone_confirmed = bull_zone_valid and m1_conf and show_intra_negation

f_get_broken_laol_recent(laol_line_data[] lines, bool require_multi, int lookback = 5) =>
    float result_level = na
    int result_tf_count = 0
    if array.size(lines) > 0
        for laol in lines
            if laol.is_broken and (bar_index - laol.break_bar) <= lookback
                if not require_multi or laol.tf_count >= 2
                    result_level := laol.level
                    result_tf_count := laol.tf_count
                    break
    [result_level, result_tf_count]

[bear_laol_broken_level, bear_laol_tf_count] = f_get_broken_laol_recent(bear_laol_lines, final_entry_multi_laol)
[bull_laol_broken_level, bull_laol_tf_count] = f_get_broken_laol_recent(bull_laol_lines, final_entry_multi_laol)

bool scalp_bear_fu_retest = false
bool scalp_bull_fu_retest = false
for i = SCALP_MIN_IDX to SCALP_MAX_IDX
    boxes = f_get_boxes(i)
    if array.size(boxes) > 0
        for bx in boxes
            if bx.has_been_retested and bx.state != "FORMING"
                if bx.direction == "bear" and (str.contains(bx.pattern_text, "FU") or str.contains(bx.pattern_text, "SN"))
                    scalp_bear_fu_retest := true
                if bx.direction == "bull" and (str.contains(bx.pattern_text, "FU") or str.contains(bx.pattern_text, "SN"))
                    scalp_bull_fu_retest := true

bool m1_bear_hcs = array.get(arr_bear_hcs, 0) or array.get(arr_bear_hcs_forming, 0)
bool m1_bull_hcs = array.get(arr_bull_hcs, 0) or array.get(arr_bull_hcs_forming, 0)
final_entry_require_hcs = false
bool bear_hcs_pass = not final_entry_require_hcs or m1_bear_hcs
bool bull_hcs_pass = not final_entry_require_hcs or m1_bull_hcs

f_generate_pattern(string base_type, bool est_ret, bool em_form, bool lv_aligned, bool negation, bool zone_rules) =>
    string[] parts = array.new_string()
    if zone_rules
        array.push(parts, "ZONE")
    if est_ret
        array.push(parts, "EST")
    if em_form
        array.push(parts, "EM")
    if lv_aligned
        array.push(parts, "LV")
    if negation and not zone_rules
        array.push(parts, "NEG")
    string intra_text = array.size(parts) > 0 ? "INTRA+" + array.join(parts, "+") : ""
    intra_text + (base_type != "" ? " [" + base_type + "]" : "")

f_should_record_setup(int last_setup_bar, bool condition) =>
    na(last_setup_bar) or (bar_index - last_setup_bar) > 5

if bear_base_valid and f_should_record_setup(final_entry_bear_setup_bar, true)
    final_entry_bear_setup_bar := bar_index
    final_entry_bear_pattern := bear_base_type
if f_should_record_setup(final_entry_bear_setup_bar, bear_intra_est_valid or bear_intra_em_valid or bear_intra_lv_valid or bear_intra_neg_valid or bear_zone_valid)
    final_entry_bear_setup_bar := bar_index
    final_entry_bear_pattern := f_generate_pattern(bear_base_type, bear_intra_est_valid, bear_intra_em_valid, bear_intra_lv_valid, bear_intra_neg_valid, bear_zone_valid)
if bull_base_valid and f_should_record_setup(final_entry_bull_setup_bar, true)
    final_entry_bull_setup_bar := bar_index
    final_entry_bull_pattern := bull_base_type
if f_should_record_setup(final_entry_bull_setup_bar, bull_intra_est_valid or bull_intra_em_valid or bull_intra_lv_valid or bull_intra_neg_valid or bull_zone_valid)
    final_entry_bull_setup_bar := bar_index
    final_entry_bull_pattern := f_generate_pattern(bull_base_type, bull_intra_est_valid, bull_intra_em_valid, bull_intra_lv_valid, bull_intra_neg_valid, bull_zone_valid)

bool bear_setup_within_window = not na(final_entry_bear_setup_bar) and (bar_index - final_entry_bear_setup_bar) <= 10
bool bull_setup_within_window = not na(final_entry_bull_setup_bar) and (bar_index - final_entry_bull_setup_bar) <= 10

bool bear_has_intra_final = (show_final_intra_est and str.contains(final_entry_bear_pattern, "EST")) or (show_final_intra_em and str.contains(final_entry_bear_pattern, "EM")) or (show_final_intra_lv and str.contains(final_entry_bear_pattern, "LV")) or (show_final_intra_negation and (str.contains(final_entry_bear_pattern, "NEG") or str.contains(final_entry_bear_pattern, "ZONE")))

bool final_entry_bear_base = show_final_entry and show_final_s1_s4 and bear_setup_within_window and str.contains(final_entry_bear_pattern, "S") and not bear_has_intra_final and not na(bear_laol_broken_level) and scalp_bear_fu_retest and scalp_last_valid_dir == "bear" and not scalp_lv_broken and bear_hcs_pass
bool final_entry_bear_intra_est = show_final_entry and show_final_intra_est and bear_setup_within_window and str.contains(final_entry_bear_pattern, "EST") and not na(bear_laol_broken_level) and scalp_bear_fu_retest and scalp_last_valid_dir == "bear" and not scalp_lv_broken and bear_hcs_pass
bool final_entry_bear_intra_em = show_final_entry and show_final_intra_em and bear_setup_within_window and str.contains(final_entry_bear_pattern, "EM") and not na(bear_laol_broken_level) and scalp_bear_fu_retest and scalp_last_valid_dir == "bear" and not scalp_lv_broken and bear_hcs_pass
bool final_entry_bear_intra_lv = show_final_entry and show_final_intra_lv and bear_setup_within_window and str.contains(final_entry_bear_pattern, "LV") and not na(bear_laol_broken_level) and scalp_bear_fu_retest and scalp_last_valid_dir == "bear" and not scalp_lv_broken and bear_hcs_pass
bool final_entry_bear_intra_neg = show_final_entry and show_final_intra_negation and bear_setup_within_window and str.contains(final_entry_bear_pattern, "NEG") and not na(bear_laol_broken_level) and scalp_bear_fu_retest and scalp_last_valid_dir == "bear" and not scalp_lv_broken and bear_hcs_pass
bool final_entry_bear_zone = show_final_entry and show_final_intra_negation and bear_setup_within_window and str.contains(final_entry_bear_pattern, "ZONE") and not na(bear_laol_broken_level) and scalp_bear_fu_retest and scalp_last_valid_dir == "bear" and not scalp_lv_broken and bear_hcs_pass

bool bull_has_intra_final = (show_final_intra_est and str.contains(final_entry_bull_pattern, "EST")) or (show_final_intra_em and str.contains(final_entry_bull_pattern, "EM")) or (show_final_intra_lv and str.contains(final_entry_bull_pattern, "LV")) or (show_final_intra_negation and (str.contains(final_entry_bull_pattern, "NEG") or str.contains(final_entry_bull_pattern, "ZONE")))

bool final_entry_bull_base = show_final_entry and show_final_s1_s4 and bull_setup_within_window and str.contains(final_entry_bull_pattern, "S") and not bull_has_intra_final and not na(bull_laol_broken_level) and scalp_bull_fu_retest and scalp_last_valid_dir == "bull" and not scalp_lv_broken and bull_hcs_pass
bool final_entry_bull_intra_est = show_final_entry and show_final_intra_est and bull_setup_within_window and str.contains(final_entry_bull_pattern, "EST") and not na(bull_laol_broken_level) and scalp_bull_fu_retest and scalp_last_valid_dir == "bull" and not scalp_lv_broken and bull_hcs_pass
bool final_entry_bull_intra_em = show_final_entry and show_final_intra_em and bull_setup_within_window and str.contains(final_entry_bull_pattern, "EM") and not na(bull_laol_broken_level) and scalp_bull_fu_retest and scalp_last_valid_dir == "bull" and not scalp_lv_broken and bull_hcs_pass
bool final_entry_bull_intra_lv = show_final_entry and show_final_intra_lv and bull_setup_within_window and str.contains(final_entry_bull_pattern, "LV") and not na(bull_laol_broken_level) and scalp_bull_fu_retest and scalp_last_valid_dir == "bull" and not scalp_lv_broken and bull_hcs_pass
bool final_entry_bull_intra_neg = show_final_entry and show_final_intra_negation and bull_setup_within_window and str.contains(final_entry_bull_pattern, "NEG") and not na(bull_laol_broken_level) and scalp_bull_fu_retest and scalp_last_valid_dir == "bull" and not scalp_lv_broken and bull_hcs_pass
bool final_entry_bull_zone = show_final_entry and show_final_intra_negation and bull_setup_within_window and str.contains(final_entry_bull_pattern, "ZONE") and not na(bull_laol_broken_level) and scalp_bull_fu_retest and scalp_last_valid_dir == "bull" and not scalp_lv_broken and bull_hcs_pass

bool final_entry_bear = final_entry_bear_base or final_entry_bear_intra_est or final_entry_bear_intra_em or final_entry_bear_intra_lv or final_entry_bear_intra_neg or final_entry_bear_zone
bool final_entry_bull = final_entry_bull_base or final_entry_bull_intra_est or final_entry_bull_intra_em or final_entry_bull_intra_lv or final_entry_bull_intra_neg or final_entry_bull_zone

bool bear_confirmed_triggered = bear_zone_confirmed or bear_intra_neg_confirmed or bear_intra_lv_confirmed or bear_intra_em_confirmed or bear_intra_est_confirmed or bear_base_confirmed
bool bull_confirmed_triggered = bull_zone_confirmed or bull_intra_neg_confirmed or bull_intra_lv_confirmed or bull_intra_em_confirmed or bull_intra_est_confirmed or bull_base_confirmed

// ==============================================================
//  SAVDO QISMI — asl kodda alert() bo'lgan joylarga qo'yildi
// ==============================================================
useFinalSig = sigMode == "FINAL ENTRY" or sigMode == "IKKALASI"
useConfSig  = sigMode == "CONFIRMED"   or sigMode == "IKKALASI"

shortSigFinal = useFinalSig and final_entry_bear
longSigFinal  = useFinalSig and final_entry_bull
shortSigConf  = useConfSig and bear_confirmed_triggered and not shortSigFinal
longSigConf   = useConfSig and bull_confirmed_triggered and not longSigFinal

shortSig = (shortSigFinal or shortSigConf) and strategy.position_size == 0 and barstate.isconfirmed
longSig  = (longSigFinal or longSigConf) and strategy.position_size == 0 and barstate.isconfirmed

tagShort = shortSigFinal ? "FINAL" : "CONF"
tagLong  = longSigFinal ? "FINAL" : "CONF"

slipVal = slipTick * syminfo.mintick
commVal = useComm ? commUsd : 0.0

// ============================================================
//  RADAR — TP yo'lidagi eng yaqin to'siqni topadi
//  isLong=true  -> yuqoridagi to'siqlarni qidiradi
//  isLong=false -> pastdagi to'siqlarni qidiradi
//  Qaytaradi: eng yaqin to'siq narxi (na = to'siq yo'q)
// ============================================================
f_radar(bool isLong, float entryPx) =>
    float nearest = na

    // --- 1) Qarama-qarshi OB/FVG qutilar ---
    if scanOB
        for i = 0 to TF_COUNT - 1
            bxs = f_get_boxes(i)
            if array.size(bxs) > 0
                for bx in bxs
                    if bx.state == "FORMING"
                        continue
                    // LONG uchun: yuqorida turgan BEAR zona to'siq
                    if isLong and bx.direction == "bear" and bx.original_bottom > entryPx
                        if na(nearest) or bx.original_bottom < nearest
                            nearest := bx.original_bottom
                    // SHORT uchun: pastda turgan BULL zona to'siq
                    if not isLong and bx.direction == "bull" and bx.original_top < entryPx
                        if na(nearest) or bx.original_top > nearest
                            nearest := bx.original_top

    // --- 2) Yechilmagan likvidlik (LAOL chiziqlari) ---
    if scanLQ
        for ll in bear_laol_lines
            if not ll.is_broken and isLong and ll.level > entryPx
                if na(nearest) or ll.level < nearest
                    nearest := ll.level
        for ll in bull_laol_lines
            if not ll.is_broken and not isLong and ll.level < entryPx
                if na(nearest) or ll.level > nearest
                    nearest := ll.level
        for ll in bear_scalp_laol_lines
            if not ll.is_broken and isLong and ll.level > entryPx
                if na(nearest) or ll.level < nearest
                    nearest := ll.level
        for ll in bull_scalp_laol_lines
            if not ll.is_broken and not isLong and ll.level < entryPx
                if na(nearest) or ll.level > nearest
                    nearest := ll.level

    // --- 3) HCS zonalar ---
    if scanHCS
        for h in hcs_boxes_bear
            if isLong and h.bottom_val > entryPx
                if na(nearest) or h.bottom_val < nearest
                    nearest := h.bottom_val
        for h in hcs_boxes_bull
            if not isLong and h.top_val < entryPx
                if na(nearest) or h.top_val > nearest
                    nearest := h.top_val

    nearest

// --- pozitsiya boshqaruvi holati ---
var int   radarBlocked = 0
var float radarDistL = na
var float radarDistS = na
var float posEntry = na
var float posSL    = na
var float posTP    = na
var float posR     = na
var bool  posLong  = false
var bool  beMoved  = false
var float bestPrice = na

if shortSig
    e = math.max(open, close)
    s = high
    ext = f_find_next_extreme_candle("bear", s)
    if not na(ext) and ext > e
        s := ext
    rng = s - e
    if rng > 0
        tp = useTP40 ? e - (PIP_TARGET * pip_value) : e - (rng * TP_MULTIPLIER)

        // --- RADAR ---
        bool blocked = false
        if useRadar
            obst = f_radar(false, e)
            if not na(obst)
                distR = (e - obst) / rng
                radarDistS := distR
                if (radarMode == "Kirish filtri" or radarMode == "Hammasi") and distR < blockBelow
                    blocked := true
                if radarMode == "Dinamik TP" or radarMode == "Hammasi"
                    newTP = obst + rng * radarBuf
                    if newTP > tp
                        tp := math.min(newTP, e - rng * minTPr)
            else
                radarDistS := na
        if blocked
            radarBlocked += 1
        rAmt = riskMode == "Dollar $" ? riskUsd : strategy.equity * riskPct / 100
        q = rAmt / (rng + slipVal)
        if not blocked
            strategy.entry("S", strategy.short, qty = q, comment = tagShort + "|" + final_entry_bear_pattern)
        if not blocked and usePartial
            strategy.exit("Sx1", "S", qty_percent = p1Pct, stop = s + slipVal, limit = e - rng * p1R)
            if p2Pct > 0
                strategy.exit("Sx2", "S", qty_percent = p2Pct, stop = s + slipVal, limit = e - rng * p2R)
            strategy.exit("Sx3", "S", stop = s + slipVal, limit = tp)
        else if not blocked
            strategy.exit("Sx", "S", stop = s + slipVal, limit = tp)
        if not blocked
            posEntry := e
            posSL := s + slipVal
            posTP := tp
            posR := rng
            posLong := false
            beMoved := false
            bestPrice := e

if longSig
    e = math.min(open, close)
    s = low
    ext = f_find_next_extreme_candle("bull", s)
    if not na(ext) and ext < e
        s := ext
    rng = e - s
    if rng > 0
        tp = useTP40 ? e + (PIP_TARGET * pip_value) : e + (rng * TP_MULTIPLIER)

        // --- RADAR ---
        bool blocked = false
        if useRadar
            obst = f_radar(true, e)
            if not na(obst)
                distR = (obst - e) / rng
                radarDistL := distR
                if (radarMode == "Kirish filtri" or radarMode == "Hammasi") and distR < blockBelow
                    blocked := true
                if radarMode == "Dinamik TP" or radarMode == "Hammasi"
                    newTP = obst - rng * radarBuf
                    if newTP < tp
                        tp := math.max(newTP, e + rng * minTPr)
            else
                radarDistL := na
        if blocked
            radarBlocked += 1
        rAmt = riskMode == "Dollar $" ? riskUsd : strategy.equity * riskPct / 100
        q = rAmt / (rng + slipVal)
        if not blocked
            strategy.entry("L", strategy.long, qty = q, comment = tagLong + "|" + final_entry_bull_pattern)
        if not blocked and usePartial
            strategy.exit("Lx1", "L", qty_percent = p1Pct, stop = s - slipVal, limit = e + rng * p1R)
            if p2Pct > 0
                strategy.exit("Lx2", "L", qty_percent = p2Pct, stop = s - slipVal, limit = e + rng * p2R)
            strategy.exit("Lx3", "L", stop = s - slipVal, limit = tp)
        else if not blocked
            strategy.exit("Lx", "L", stop = s - slipVal, limit = tp)
        if not blocked
            posEntry := e
            posSL := s - slipVal
            posTP := tp
            posR := rng
            posLong := true
            beMoved := false
            bestPrice := e

// ============================================================
//  BREAKEVEN va TRAILING (ixtiyoriy, default o'chiq)
// ============================================================
if strategy.position_size != 0 and not na(posR) and posR > 0
    // eng yaxshi narxni kuzatish
    bestPrice := posLong ? math.max(nz(bestPrice, posEntry), high)
         : math.min(nz(bestPrice, posEntry), low)
    mfeR = posLong ? (bestPrice - posEntry) / posR : (posEntry - bestPrice) / posR

    float newSL = posSL

    // --- 1) Breakeven ---
    if useBE and not beMoved and mfeR >= beAtR
        beMoved := true
        newSL := posLong ? posEntry + posR * beOffset : posEntry - posR * beOffset

    // --- 1.5) ADAPTIV SL (radar) ---
    // Yo'lda to'siq juda yaqinlashsa -> SL ni BE ga suramiz
    if useRadar and (radarMode == "Adaptiv SL" or radarMode == "Hammasi") and mfeR >= 0.5
        obst2 = f_radar(posLong, close)
        if not na(obst2)
            distNow = posLong ? (obst2 - close) / posR : (close - obst2) / posR
            if distNow < 0.5
                cand = posLong ? posEntry + posR * beOffset : posEntry - posR * beOffset
                newSL := posLong ? math.max(newSL, cand) : math.min(newSL, cand)

    // --- 2) Trailing ---
    if useTrail and mfeR >= trailStartR
        tsl = posLong ? bestPrice - posR * trailR : bestPrice + posR * trailR
        newSL := posLong ? math.max(newSL, tsl) : math.min(newSL, tsl)

    // SL faqat foyda tomonga suriladi
    if posLong and newSL > posSL
        posSL := newSL
        if usePartial
            strategy.exit("Lx1", "L", qty_percent = p1Pct, stop = posSL, limit = posEntry + posR * p1R)
            if p2Pct > 0
                strategy.exit("Lx2", "L", qty_percent = p2Pct, stop = posSL, limit = posEntry + posR * p2R)
            strategy.exit("Lx3", "L", stop = posSL, limit = posTP)
        else
            strategy.exit("Lx", "L", stop = posSL, limit = posTP)
    if not posLong and newSL < posSL
        posSL := newSL
        if usePartial
            strategy.exit("Sx1", "S", qty_percent = p1Pct, stop = posSL, limit = posEntry - posR * p1R)
            if p2Pct > 0
                strategy.exit("Sx2", "S", qty_percent = p2Pct, stop = posSL, limit = posEntry - posR * p2R)
            strategy.exit("Sx3", "S", stop = posSL, limit = posTP)
        else
            strategy.exit("Sx", "S", stop = posSL, limit = posTP)

// pozitsiya yopilganda tozalash
if strategy.position_size == 0
    posR := na
    bestPrice := na

// joriy SL/TP chiziqlari
plot(strategy.position_size != 0 ? posSL : na, "SL", color.new(color.red, 0), 2, plot.style_linebr)
plot(strategy.position_size != 0 ? posTP : na, "TP", color.new(color.green, 0), 2, plot.style_linebr)
plot(strategy.position_size != 0 ? posEntry : na, "Entry", color.new(color.blue, 0), 1, plot.style_linebr)

// radar to'sig'i chizig'i
var line radarLine = na
if useRadar and barstate.islast
    line.delete(radarLine)
    ob = f_radar(true, close)
    ob2 = f_radar(false, close)
    lvl = na(ob) ? ob2 : (na(ob2) ? ob : (math.abs(ob-close) < math.abs(ob2-close) ? ob : ob2))
    if not na(lvl)
        radarLine := line.new(bar_index - 50, lvl, bar_index + 20, lvl,
             color = color.new(color.orange, 20), style = line.style_dashed, width = 2)

plotshape(longSig,  "LONG",  shape.triangleup,   location.belowbar, color.new(color.green,0), size = size.small)
plotshape(shortSig, "SHORT", shape.triangledown, location.abovebar, color.new(color.red,0),   size = size.small)

// ---------------- DASHBOARD ----------------
var table dsh = na
if barstate.islast
    table.delete(dsh)
    dsh := table.new(position.top_right, 2, 12, border_width = 1, frame_color = color.new(color.gray, 50), frame_width = 1)
    cGood = color.new(color.green, 60)
    cBad  = color.new(color.red, 60)
    cNeut = color.new(color.gray, 60)
    table.cell(dsh, 0, 0, "BETA 1 + LAOL", text_color = color.white, text_size = size.normal, bgcolor = color.new(color.blue, 35))
    table.cell(dsh, 1, 0, syminfo.ticker + " " + timeframe.period, text_color = color.white, text_size = size.normal, bgcolor = color.new(color.blue, 35))
    table.cell(dsh, 0, 1, "Signal rejimi", text_color = color.white, text_size = size.small, bgcolor = color.new(color.black, 25))
    table.cell(dsh, 1, 1, sigMode, text_color = color.white, text_size = size.small, bgcolor = color.new(color.purple, 60))
    table.cell(dsh, 0, 2, "TP", text_color = color.white, text_size = size.small, bgcolor = color.new(color.black, 25))
    table.cell(dsh, 1, 2, useTP40 ? "40 pip" : "SL x " + str.tostring(TP_MULTIPLIER), text_color = color.white, text_size = size.small, bgcolor = cNeut)
    table.cell(dsh, 0, 3, "Risk", text_color = color.white, text_size = size.small, bgcolor = color.new(color.black, 25))
    table.cell(dsh, 1, 3, riskMode == "Dollar $" ? "$" + str.tostring(riskUsd) : str.tostring(riskPct) + "%", text_color = color.white, text_size = size.small, bgcolor = cNeut)
    table.cell(dsh, 0, 4, "Savdolar", text_color = color.white, text_size = size.small, bgcolor = color.new(color.black, 25))
    table.cell(dsh, 1, 4, str.tostring(strategy.closedtrades), text_color = color.white, text_size = size.small, bgcolor = strategy.closedtrades >= 50 ? cGood : color.new(color.orange, 60))
    wrv = strategy.closedtrades > 0 ? strategy.wintrades * 100.0 / strategy.closedtrades : 0
    table.cell(dsh, 0, 5, "Win rate", text_color = color.white, text_size = size.small, bgcolor = color.new(color.black, 25))
    table.cell(dsh, 1, 5, str.tostring(wrv, "#.#") + "%", text_color = color.white, text_size = size.small, bgcolor = wrv > 100.0/(1.0+TP_MULTIPLIER) ? cGood : cBad)
    table.cell(dsh, 0, 6, "Kutilgan WR (1:" + str.tostring(TP_MULTIPLIER) + ")", text_color = color.white, text_size = size.small, bgcolor = color.new(color.black, 25))
    table.cell(dsh, 1, 6, str.tostring(100.0/(1.0+TP_MULTIPLIER), "#.#") + "%", text_color = color.white, text_size = size.small, bgcolor = cNeut)
    table.cell(dsh, 0, 7, "Net profit", text_color = color.white, text_size = size.small, bgcolor = color.new(color.black, 25))
    table.cell(dsh, 1, 7, str.tostring(strategy.netprofit, "#.##"), text_color = color.white, text_size = size.small, bgcolor = strategy.netprofit > 0 ? cGood : cBad)
    table.cell(dsh, 0, 11, "Radar", text_color = color.white, text_size = size.small, bgcolor = color.new(color.black, 25))
    table.cell(dsh, 1, 11, useRadar ? radarMode + (radarBlocked > 0 ? "  (bloklandi: " + str.tostring(radarBlocked) + ")" : "") : "o'chiq", text_color = color.white, text_size = size.small, bgcolor = useRadar ? color.new(color.orange, 50) : cNeut)
    table.cell(dsh, 0, 10, "Chiqish sxemasi", text_color = color.white, text_size = size.small, bgcolor = color.new(color.black, 25))
    table.cell(dsh, 1, 10, usePartial ? str.tostring(p1Pct) + "%@" + str.tostring(p1R) + "R" + (p2Pct > 0 ? " + " + str.tostring(p2Pct) + "%@" + str.tostring(p2R) + "R" : "") + " + qolgani@8R" : "100% @ 8R", text_color = color.white, text_size = size.small, bgcolor = usePartial ? color.new(color.teal, 50) : cNeut)
    table.cell(dsh, 0, 9, "Poz. boshqaruvi", text_color = color.white, text_size = size.small, bgcolor = color.new(color.black, 25))
    table.cell(dsh, 1, 9, (useBE ? "BE " + str.tostring(beAtR) + "R" : "") + (useTrail ? " Trail " + str.tostring(trailR) + "R" : "") + (not useBE and not useTrail ? "yo'q" : ""), text_color = color.white, text_size = size.small, bgcolor = useBE or useTrail ? color.new(color.purple, 60) : cNeut)
    table.cell(dsh, 0, 8, "Max DD", text_color = color.white, text_size = size.small, bgcolor = color.new(color.black, 25))
    table.cell(dsh, 1, 8, str.tostring(strategy.max_drawdown, "#.##"), text_color = color.white, text_size = size.small, bgcolor = cNeut)

alertcondition(longSig,  "LONG",  "BETA1 LONG")
alertcondition(shortSig, "SHORT", "BETA1 SHORT")
