f_calculate_patterns(int idx, float p_o2, float p_h2, float p_l2, float p_c2, float p_o1, float p_h1, float p_l1, float p_c1, float p_o, float p_h, float p_l, float p_c, int p_t, bool p_conf) =>
    valid_data   = not na(p_h) and not na(p_l) and not na(p_c) and not na(p_o)
    valid_data_1 = not na(p_h1) and not na(p_l1) and not na(p_c1) and not na(p_o1)
    valid_data_2 = not na(p_h2) and not na(p_l2) and not na(p_c2) and not na(p_o2)
    both_sides   = valid_data   ? f_has_both_wicks(p_o, p_h, p_l, p_c)     : false
    both_sides_1 = valid_data_1 ? f_has_both_wicks(p_o1, p_h1, p_l1, p_c1) : false
    body_top    = valid_data ? math.max(p_o, p_c) : na
    body_bottom = valid_data ? math.min(p_o, p_c) : na
    is_ib = valid_data and valid_data_1 ? f_is_inside_bar(p_h, p_l, p_h1, p_l1) : false
    bear_x3 = valid_data and valid_data_1 and p_h > p_h1 and p_l < p_l1 and both_sides and p_c < p_o
    bull_x3 = valid_data and valid_data_1 and p_h > p_h1 and p_l < p_l1 and both_sides and p_c > p_o
    is_x3   = bear_x3 or bull_x3
    bear_x3_1 = valid_data_1 and valid_data_2 ? p_h1 > p_h2 and p_l1 < p_l2 and both_sides_1 and p_c1 < p_o1 : false
    bull_x3_1 = valid_data_1 and valid_data_2 ? p_h1 > p_h2 and p_l1 < p_l2 and both_sides_1 and p_c1 > p_o1 : false
    is_x3_1   = bear_x3_1 or bull_x3_1
    sn_bull = p_h > p_h1 and p_l < p_l1 and math.max(p_o, p_c) < p_h1 and math.min(p_o, p_c) > p_l1 and p_o < p_c
    sn_bear = p_h > p_h1 and p_l < p_l1 and math.min(p_o, p_c) > p_l1 and math.max(p_o, p_c) < p_h1 and p_o > p_c
    sn_together = (sn_bull or sn_bear) and not is_x3
    sn_bull_candle_1 = p_h1 > p_h2 and p_l1 < p_l2 and p_c1 > p_o1 and math.max(p_o1, p_c1) < p_h2
    sn_bear_candle_1 = p_h1 > p_h2 and p_l1 < p_l2 and p_c1 < p_o1 and math.min(p_o1, p_c1) > p_l2
    sn_together_1 = (sn_bull_candle_1 or sn_bear_candle_1) and not is_x3_1
    bull_laol_first = valid_data and valid_data_1 and valid_data_2 and p_l1 == math.min(p_o1, p_c1) and p_h1 < p_h2 and p_h < p_h1 and p_l < p_l1
    bear_laol_first = valid_data and valid_data_1 and valid_data_2 and p_h1 == math.max(p_o1, p_c1) and p_l1 > p_l2 and p_l > p_l1 and p_h > p_h1
    bear_first_em = (bull_x3_1 or sn_together_1) and p_h > p_h1 and p_l > p_l1
    bull_first_em = (bear_x3_1 or sn_together_1) and p_l < p_l1 and p_h < p_h1
    bear_laol_candle = is_ib
    bull_laol_candle = is_ib
    fu_bear_em = valid_data and valid_data_1 and p_h > p_h1 and p_c < p_h1 and p_c > p_l1 and not is_x3 and not sn_together
    fu_bull_em = valid_data and valid_data_1 and p_l < p_l1 and p_c > p_l1 and p_c < p_h1 and not is_x3 and not sn_together
    array.set(arr_fu_bear,        idx, fu_bear_em)
    array.set(arr_fu_bull,        idx, fu_bull_em)
    array.set(arr_sn_bear,        idx, sn_bear)
    array.set(arr_sn_bull,        idx, sn_bull)
    array.set(arr_first_bear,     idx, bear_first_em)
    array.set(arr_first_bull,     idx, bull_first_em)
    array.set(arr_laol_bear,      idx, bear_laol_first)
    array.set(arr_laol_bull,      idx, bull_laol_first)
    array.set(arr_laol_first_bear, idx, bear_laol_first)
    array.set(arr_laol_first_bull, idx, bull_laol_first)
    array.set(arr_tf_h,           idx, p_h)
    array.set(arr_tf_l,           idx, p_l)
    array.set(arr_tf_bt,          idx, body_top)
    array.set(arr_tf_bb,          idx, body_bottom)
    array.set(arr_tf_t,           idx, p_t)
    array.set(arr_tf_conf,        idx, p_conf)
    array.set(arr_laol_candle_bear, idx, bear_laol_candle)
    array.set(arr_laol_candle_bull, idx, bull_laol_candle)

