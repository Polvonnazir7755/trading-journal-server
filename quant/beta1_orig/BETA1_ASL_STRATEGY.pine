f_calculate_patterns(11, tf12_o2, tf12_h2, tf12_l2, tf12_c2, tf12_o1, tf12_h1, tf12_l1, tf12_c1, tf12_o, tf12_h, tf12_l, tf12_c, tf12_t, tf12_conf)
f_calculate_patterns(12, tf13_o2, tf13_h2, tf13_l2, tf13_c2, tf13_o1, tf13_h1, tf13_l1, tf13_c1, tf13_o, tf13_h, tf13_l, tf13_c, tf13_t, tf13_conf)
f_calculate_patterns(13, tf14_o2, tf14_h2, tf14_l2, tf14_c2, tf14_o1, tf14_h1, tf14_l1, tf14_c1, tf14_o, tf14_h, tf14_l, tf14_c, tf14_t, tf14_conf)
f_calculate_patterns(14, tf15_o2, tf15_h2, tf15_l2, tf15_c2, tf15_o1, tf15_h1, tf15_l1, tf15_c1, tf15_o, tf15_h, tf15_l, tf15_c, tf15_t, tf15_conf)
f_calculate_patterns(15, tf16_o2, tf16_h2, tf16_l2, tf16_c2, tf16_o1, tf16_h1, tf16_l1, tf16_c1, tf16_o, tf16_h, tf16_l, tf16_c, tf16_t, tf16_conf)

