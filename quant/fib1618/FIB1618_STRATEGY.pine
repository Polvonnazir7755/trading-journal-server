// =====================================================================
//  "1.618 LEGENDA" — W/M pattern + Fibonachi kengaytmasi
//  Manba: TIGERS TRADING (MUSLIM ALI) YouTube efiri, 11.01.2026
//  https://www.youtube.com/watch?v=G9HxpUnBAGY
//
//  VIDEO QOIDALARI (aynan):
//   1. Faqat RAZVOROT (trend burilishi) holatida
//   2. W pattern (long): downtrend -> 2 ta minimum -> neckline
//      M pattern (short): uptrend  -> 2 ta maksimum -> neckline
//   3. Neckline TANA bilan yorilishi shart (soya bilan emas!)
//   4. Fibonachi: yorgan shamning TANASIDAN -> oxirgi MINIMUMGACHA
//   5. 6 ta kirish nuqtasi:
//        1) yorib yopilgan sham ("majburiy")
//        2) neckline ustiga retest
//        3) trend chizig'i retest
//        4) OTE 0.5-0.618 ("optimalniy trade zone")
//        5) imbalans (FVG)
//        6) order block
//   6. TP1 = 1.618 ("garant"), 70% yopiladi
//      TP2 = 2.618 ("prognoz"), qolgan 30%, SL breakevenga
//
//  BU KOD NIMA QILADI:
//   - Har kirish nuqtasini ALOHIDA o'lchaydi (video buni qilmagan)
//   - "Garant 1.618" da'vosini raqamga aylantiradi
//   - Statistika jadvali: nechta W topildi, nechtasi TP1/TP2 ga yetdi
// =====================================================================

//@version=6
strategy("1.618 LEGENDA — W/M Fibo Strategy", overlay = true,
     max_lines_count = 300, max_labels_count = 300, max_boxes_count = 300,
     initial_capital = 1000,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 100,
     commission_type = strategy.commission.cash_per_order, commission_value = 0,
     slippage = 0, calc_on_every_tick = false, process_orders_on_close = true,
     margin_long = 0, margin_short = 0)

// ---------------------------------------------------------------
//  SOZLAMALAR
// ---------------------------------------------------------------
gP = "PATTERN ANIQLASH"
pivLen    = input.int(5, "Pivot uzunligi", minval = 2, maxval = 30, group = gP,
     tooltip = "Minimum/maksimum topish uchun chap va o'ngdagi barlar soni.\nKichik = ko'p pattern, katta = kam lekin sifatli.")
maxBase   = input.int(60, "W/M eni (max bar)", minval = 5, group = gP,
     tooltip = "Ikki minimum orasidagi maksimal masofa")
minBase   = input.int(5,  "W/M eni (min bar)", minval = 2, group = gP)
tolPct    = input.float(25.0, "Ikki minimum farqi (% dan bo'y)", minval = 1, maxval = 100, group = gP,
     tooltip = "W ning ikki oyog'i qanchalik teng bo'lishi kerak.\n25% = ikkinchi minimum birinchisidan bo'yning 25% ichida")
needTrend = input.bool(true, "Razvorot sharti (oldin trend bo'lsin)", group = gP,
     tooltip = "Video: 'faqat razvorotda ishlaydi'.\nW dan oldin downtrend, M dan oldin uptrend bo'lishi tekshiriladi")
trendLook = input.int(30, "Trend tekshirish oynasi (bar)", minval = 5, group = gP)
bodyBreak = input.bool(true, "Neckline TANA bilan yorilsin", group = gP,
     tooltip = "Video qat'iy talab qiladi: soya bilan emas, tana bilan.\nO'chirsangiz — soya bilan yorish ham qabul qilinadi (taqqoslash uchun)")

gE = "KIRISH NUQTASI (bittasini tanlang)"
entryMode = input.string("4-OTE 0.5-0.618", "Kirish usuli", group = gE,
     options = ["1-Majburiy sham", "2-Neckline retest", "4-OTE 0.5-0.618", "5-Imbalans (FVG)", "6-Order block"],
     tooltip = "Video 6 ta nuqta beradi. Har birini ALOHIDA sinang!\nMening hisobim: OTE eng yaxshi (RR 2.15), majburiy sham eng yomon (RR 0.61)")
oteLo     = input.float(0.5,   "OTE quyi chegara", minval = 0.1, maxval = 0.9, step = 0.01, group = gE)
oteHi     = input.float(0.618, "OTE yuqori chegara", minval = 0.1, maxval = 0.95, step = 0.01, group = gE)
waitBars  = input.int(30, "Kirishni kutish (bar)", minval = 1, group = gE,
     tooltip = "Neckline yorilgandan keyin shuncha bar ichida kirish nuqtasi kutiladi")
limitMode = input.bool(true, "LIMIT ORDER rejimi (realistik)", group = gE,
     tooltip = "YOQ (tavsiya): aynan limit order kabi ishlaydi.\nNarx zona chegarasiga TEGSA — savdo ochiladi, keyin narx qayerga ketishidan qat'i nazar.\nKirish narxi = zona chegarasi (limit narxi).\n\nO'CHIQ (eski): sham zona ICHIDA qolishi ham talab qilinadi.\nBu SELEKSIYA BIASI beradi (+8 pp WR) — narx zonaga kirib yuqoriga otilgan\nZARARLI savdolar hisobga olinmaydi, lekin real limit order ularni OLADI.\n\nAUDIT_KIRISH.md ga qarang.")

gX = "CHIQISH (video qoidasi)"
tp1Fib    = input.float(1.618, "TP1 'garant' (fib)", step = 0.1, group = gX)
tp2Fib    = input.float(2.618, "TP2 'prognoz' (fib)", step = 0.1, group = gX)
tp1Pct    = input.int(70, "TP1 da yopiladigan hajm (%)", minval = 0, maxval = 100, group = gX,
     tooltip = "Video: 1.618 da 70% yopiladi")
useBEafter = input.bool(true, "TP1 dan keyin SL -> breakeven", group = gX,
     tooltip = "Video: qolgan 30% uchun SL bezubitkaga (breakeven) suriladi")
slBufPct  = input.float(2.0, "SL bufer (% dan bo'y)", minval = 0, step = 0.5, group = gX,
     tooltip = "SL minimumdan shuncha pastga qo'yiladi (W bo'yining % i)")

gC = "REALISTIK XARAJAT (real hisobga yaqinlashtirish)"
useCost   = input.bool(false, "Realistik xarajatni yoqish", group = gC,
     tooltip = "Backtest default 0 xarajat bilan ishlaydi \u2014 bu ALDAMCHI.\nBu yerda spred + komissiya + slippage + swap hisobga olinadi.\nHar savdo natijasidan ayiriladi.")
costSpread = input.float(0.2, "Spred (pip)", minval = 0.0, step = 0.1, group = gC,
     tooltip = "EURUSD raw ~0.2, standart ~1.0, XAUUSD ~2.0 (0.20 dollar)")
costComm   = input.float(0.7, "Komissiya (pip ekvivalent)", minval = 0.0, step = 0.1, group = gC,
     tooltip = "Exness Raw: $3.5/lot bir tomonga = 0.35 pip x 2 = 0.7 pip")
costSlip   = input.float(0.4, "Slippage (pip)", minval = 0.0, step = 0.1, group = gC,
     tooltip = "Kirish + chiqishdagi o'rtacha siljish")
costSwap   = input.float(0.6, "Swap (pip, o'rtacha)", minval = 0.0, step = 0.1, group = gC,
     tooltip = "Pozitsiyani tunga qoldirish narxi. M30 da ~1-2 kun ushlanadi.")
pipAuto    = input.bool(true, "1 pip qiymatini AVTOMATIK aniqlash", group = gC,
     tooltip = "YOQ = simvolga qarab o'zi tanlaydi (TAVSIYA).\nBu XAUUSD da 0.0001 qoldirib yuborish xatosini oldini oladi.")
pipSize    = input.float(0.0001, "1 pip (qo'lda, avtomatik o'chiq bo'lsa)", minval = 0.00001, step = 0.00001, group = gC,
     tooltip = "EURUSD/GBPUSD = 0.0001\nUSDJPY = 0.01\nXAUUSD = 0.10")

gR = "RISK"
riskMode = input.string("Foiz %", "Risk turi", options = ["Foiz %", "Dollar $"], group = gR,
     tooltip = "Foiz % = compounding (hisob o'sgani sari pozitsiya ham o'sadi).\nDollar $ = qat'iy summa, compounding yo'q.")
riskPct  = input.float(5.0, "Risk %", minval = 0.1, step = 0.5, group = gR,
     tooltip = "Monte-Carlo (20k sinov, 21 yil):\n 1% -> CAGR 3.2%, DD 4.9%\n 3% -> CAGR 9.6%, DD 13.9%\n 5% -> CAGR 16.0%, DD 22.2%\n10% -> CAGR 32.1%, DD 39.9%")
riskUsd  = input.float(20.0, "Risk $", minval = 1.0, step = 5.0, group = gR)
slipTick = input.int(2, "Slippage (tick)", minval = 0, group = gR)

gRD = "RADAR — yechilmagan likvidlik (EQH/EQL)"
useRadar   = input.bool(false, "Radarni yoqish", group = gRD,
     tooltip = "TP yo'lidagi YECHILMAGAN likvidlikni (EQH/EQL) topadi.\nManba mantiq: LuxAlgo EQH/EQL Liquidity Zones.\nDefault O'CHIQ \u2014 asl 1.618 mantiqiga tegmaydi.")
radarMode  = input.string("Faqat o'lchov", "Radar rejimi", group = gRD,
     options = ["Faqat o'lchov", "Dinamik TP", "Kirish filtri", "Hammasi"],
     tooltip = "Faqat o'lchov = savdoga TA'SIR QILMAYDI, faqat statistika yig'adi (AVVAL SHUNI ISHLATING)\nDinamik TP = TP ni to'siq oldiga qo'yadi\nKirish filtri = to'siq juda yaqin bo'lsa savdo ochmaydi\nHammasi = ikkalasi")
eqLeft     = input.int(10, "EQ pivot chap", minval = 1, group = gRD)
eqRight    = input.int(2,  "EQ pivot o'ng", minval = 1, group = gRD,
     tooltip = "Pivot tasdig'i uchun o'ngdagi barlar. Kechikish = shu qiymat.")
eqTolPct   = input.float(0.03, "Tenglik chegarasi (%)", minval = 0.0, step = 0.01, group = gRD,
     tooltip = "Ikki cho'qqi/tub 'teng' hisoblanishi uchun maksimal farq")
eqMaxZones = input.int(60, "Maks faol zona", minval = 5, maxval = 200, group = gRD)
radarBuf   = input.float(0.15, "TP buferi (R)", minval = 0.0, step = 0.05, group = gRD,
     tooltip = "TP to'siqdan shuncha R oldin qo'yiladi")
minTPr     = input.float(0.8, "Minimal TP (R)", minval = 0.1, step = 0.1, group = gRD,
     tooltip = "To'siq juda yaqin bo'lsa \u2014 shundan kam TP qo'yilmaydi")
blockBelow = input.float(1.0, "Kirish filtri: min bo'sh yo'l (R)", minval = 0.1, step = 0.1, group = gRD,
     tooltip = "To'siqqacha shundan kam bo'lsa savdoga kirmaydi")
showEQ     = input.bool(true, "EQH/EQL zonalarini chizish", group = gRD)

gV = "KO'RINISH"
showViz  = input.bool(true, "Chizmalarni ko'rsatish", group = gV)
showStat = input.bool(true, "Statistika jadvali", group = gV)

gPL = "SAVDO REJASI (ENTRY / SL / TP chiziqlari)"
showPlan  = input.bool(true, "Savdo rejasini ko'rsatish", group = gPL,
     tooltip = "Faol setup uchun ENTRY (ko'k), SL (qizil), TP1 (yashil) chiziqlarini\nyozuvlari bilan chizadi. Limit orderni qayerga qo'yishni ko'rsatadi.")
planRight = input.int(14, "Chiziqlar o'ngga cho'zilishi (bar)", minval = 2, maxval = 60, group = gPL)
planWidth = input.int(2, "Chiziq qalinligi", minval = 1, maxval = 4, group = gPL)
planSize  = input.string("normal", "Yozuv o'lchami", options = ["tiny", "small", "normal", "large"], group = gPL)
planBal   = input.float(1000.0, "Hisob balansi ($) — lot hisobi uchun", minval = 10, step = 100, group = gPL)
planRisk  = input.float(2.0, "Risk (%) — lot hisobi uchun", minval = 0.1, step = 0.5, group = gPL)
showPanel = input.bool(true, "Savdo rejasi panelini ko'rsatish", group = gPL,
     tooltip = "Pastki o'ng burchakda: Entry/SL/TP raqamlari, lot, risk $, RR, oyna qolgan bar")

gD = "SANA ORALIG'I (bepul)"
useDate  = input.bool(false, "Sana oralig'ini cheklash", group = gD)
dtStart  = input.time(timestamp("01 Jul 2026 00:00 +0000"), "Boshlanish", group = gD)
dtEnd    = input.time(timestamp("14 Aug 2026 23:59 +0000"), "Tugash", group = gD)

// ===============================================================
//  RADAR: EQH/EQL YECHILMAGAN LIKVIDLIK
//  Mantiq manbasi: LuxAlgo "EQH/EQL Liquidity Zones"
//  Bu yerda faqat SAVDO uchun kerakli qism: sweepLevel + isSwept
// ===============================================================
type EqZone
    float sweepLevel      // supurilish narxi (EQH uchun top, EQL uchun bottom)
    float vol             // ikki pivot hajmi yig'indisi
    int   bornBar         // qachon yaratilgan
    bool  isHigh          // true = EQH (yuqorida), false = EQL (pastda)
    box   bx

var EqZone[] eqZones = array.new<EqZone>()
var float[]  eqHiVal = array.new_float()
var int[]    eqHiBar = array.new_int()
var float[]  eqHiVol = array.new_float()
var float[]  eqLoVal = array.new_float()
var int[]    eqLoBar = array.new_int()
var float[]  eqLoVol = array.new_float()

float eqPH = useRadar ? ta.pivothigh(eqLeft, eqRight) : na
float eqPL = useRadar ? ta.pivotlow(eqLeft, eqRight)  : na

// --- yangi EQH
if not na(eqPH)
    int   pIdx = bar_index - eqRight
    float pVol = nz(volume[eqRight], 1.0)
    if array.size(eqHiVal) > 0
        for i = 0 to array.size(eqHiVal) - 1
            float prevP = array.get(eqHiVal, i)
            if prevP > 0 and math.abs(eqPH - prevP) / prevP * 100 <= eqTolPct
                float top = math.max(eqPH, prevP)
                float bot = math.min(eqPH, prevP)
                box bx = na
                if showEQ and showViz
                    bx := box.new(array.get(eqHiBar, i), top, bar_index, bot,
                         border_color = color.new(#f23645, 40), bgcolor = color.new(#f23645, 85))
                array.push(eqZones, EqZone.new(top, array.get(eqHiVol, i) + pVol, bar_index, true, bx))
                break
    array.unshift(eqHiVal, eqPH)
    array.unshift(eqHiBar, pIdx)
    array.unshift(eqHiVol, pVol)
    if array.size(eqHiVal) > 50
        array.pop(eqHiVal)
        array.pop(eqHiBar)
        array.pop(eqHiVol)

// --- yangi EQL
if not na(eqPL)
    int   pIdx = bar_index - eqRight
    float pVol = nz(volume[eqRight], 1.0)
    if array.size(eqLoVal) > 0
        for i = 0 to array.size(eqLoVal) - 1
            float prevP = array.get(eqLoVal, i)
            if prevP > 0 and math.abs(eqPL - prevP) / prevP * 100 <= eqTolPct
                float top = math.max(eqPL, prevP)
                float bot = math.min(eqPL, prevP)
                box bx = na
                if showEQ and showViz
                    bx := box.new(array.get(eqLoBar, i), top, bar_index, bot,
                         border_color = color.new(#089981, 40), bgcolor = color.new(#089981, 85))
                array.push(eqZones, EqZone.new(bot, array.get(eqLoVol, i) + pVol, bar_index, false, bx))
                break
    array.unshift(eqLoVal, eqPL)
    array.unshift(eqLoBar, pIdx)
    array.unshift(eqLoVol, pVol)
    if array.size(eqLoVal) > 50
        array.pop(eqLoVal)
        array.pop(eqLoBar)
        array.pop(eqLoVol)

// --- supurilganlarni olib tashlash (faqat YECHILMAGAN qoladi)
var int eqSweptCnt = 0
if array.size(eqZones) > 0
    for i = array.size(eqZones) - 1 to 0
        if i >= array.size(eqZones)
            continue
        EqZone z = array.get(eqZones, i)
        bool swept = bar_index > z.bornBar and (z.isHigh ? high > z.sweepLevel : low < z.sweepLevel)
        if swept
            eqSweptCnt += 1
            if not na(z.bx)
                box.delete(z.bx)
            array.remove(eqZones, i)
        else
            if not na(z.bx)
                box.set_right(z.bx, bar_index)
    while array.size(eqZones) > eqMaxZones
        EqZone z0 = array.get(eqZones, 0)
        if not na(z0.bx)
            box.delete(z0.bx)
        array.remove(eqZones, 0)

// --- radar: entry va target orasidagi eng yaqin YECHILMAGAN to'siq
//     isLong = true  -> yuqoridagi EQH lar to'siq
//     isLong = false -> pastdagi EQL lar to'siq
f_radar(bool isLong, float entryPx, float targetPx) =>
    float nearest = na
    float nvol    = 0.0
    int   cnt     = 0
    if array.size(eqZones) > 0
        for z in eqZones
            float lv = z.sweepLevel
            bool inPath = isLong ? (lv > entryPx and lv < targetPx) : (lv < entryPx and lv > targetPx)
            if inPath
                cnt += 1
                bool closer = na(nearest) or (isLong ? lv < nearest : lv > nearest)
                if closer
                    nearest := lv
                    nvol    := z.vol
    [nearest, cnt, nvol]

// ---------------------------------------------------------------
//  PIVOTLAR (W/M pattern uchun)
// ---------------------------------------------------------------
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low,  pivLen, pivLen)

var float[] phVal = array.new_float()
var int[]   phBar = array.new_int()
var float[] plVal = array.new_float()
var int[]   plBar = array.new_int()

if not na(ph)
    array.push(phVal, ph)
    array.push(phBar, bar_index - pivLen)
    if array.size(phVal) > 50
        array.shift(phVal)
        array.shift(phBar)
if not na(pl)
    array.push(plVal, pl)
    array.push(plBar, bar_index - pivLen)
    if array.size(plVal) > 50
        array.shift(plVal)
        array.shift(plBar)

// ---------------------------------------------------------------
//  W / M PATTERN HOLATI
// ---------------------------------------------------------------
// W (long): min1 -> maks(neckline) -> min2 -> neckline yorilishi
var float wMin1 = na
var int   wMin1B = na
var float wNeck = na
var int   wNeckB = na
var float wMin2 = na
var int   wMin2B = na
var bool  wArmed = false          // pattern shakllandi, neckline yorilishi kutilmoqda
var int   wArmBar = na

var float mMax1 = na
var int   mMax1B = na
var float mNeck = na
var int   mNeckB = na
var float mMax2 = na
var int   mMax2B = na
var bool  mArmed = false
var int   mArmBar = na

// oldin downtrend bormi? (W uchun)
f_wasDown() =>
    not needTrend or (close[trendLook] > close and high[trendLook] > high)
f_wasUp() =>
    not needTrend or (close[trendLook] < close and low[trendLook] < low)

// --- W pattern qidirish: oxirgi 2 ta minimum + orasidagi maksimum
if not na(pl) and array.size(plVal) >= 2 and array.size(phVal) >= 1
    int    n   = array.size(plVal)
    float  l2  = array.get(plVal, n - 1)      // oxirgi minimum
    int    l2b = array.get(plBar, n - 1)
    float  l1  = array.get(plVal, n - 2)      // undan oldingi
    int    l1b = array.get(plBar, n - 2)
    // orasidagi eng baland maksimum = neckline
    float  nk  = na
    int    nkb = na
    for i = 0 to array.size(phVal) - 1
        int hb = array.get(phBar, i)
        if hb > l1b and hb < l2b
            float hv = array.get(phVal, i)
            if na(nk) or hv > nk
                nk  := hv
                nkb := hb
    if not na(nk)
        float baseH = nk - math.min(l1, l2)          // W ning bo'yi
        int   width = l2b - l1b
        bool  okW   = width >= minBase and width <= maxBase
        bool  okTol = baseH > 0 and math.abs(l2 - l1) <= baseH * tolPct / 100
        if okW and okTol and f_wasDown()
            wMin1 := l1
            wMin1B := l1b
            wMin2 := l2
            wMin2B := l2b
            wNeck := nk
            wNeckB := nkb
            wArmed := true
            wArmBar := bar_index

// --- M pattern
if not na(ph) and array.size(phVal) >= 2 and array.size(plVal) >= 1
    int    n   = array.size(phVal)
    float  h2  = array.get(phVal, n - 1)
    int    h2b = array.get(phBar, n - 1)
    float  h1  = array.get(phVal, n - 2)
    int    h1b = array.get(phBar, n - 2)
    float  nk  = na
    int    nkb = na
    for i = 0 to array.size(plVal) - 1
        int lb = array.get(plBar, i)
        if lb > h1b and lb < h2b
            float lv = array.get(plVal, i)
            if na(nk) or lv < nk
                nk  := lv
                nkb := lb
    if not na(nk)
        float baseH = math.max(h1, h2) - nk
        int   width = h2b - h1b
        bool  okW   = width >= minBase and width <= maxBase
        bool  okTol = baseH > 0 and math.abs(h2 - h1) <= baseH * tolPct / 100
        if okW and okTol and f_wasUp()
            mMax1 := h1
            mMax1B := h1b
            mMax2 := h2
            mMax2B := h2b
            mNeck := nk
            mNeckB := nkb
            mArmed := true
            mArmBar := bar_index

// ---------------------------------------------------------------
//  NECKLINE YORILISHI (video: TANA bilan!)
// ---------------------------------------------------------------
bool wBodyBrk = close > wNeck and (open <= wNeck or close[1] <= wNeck)
bool wBreak = wArmed and not na(wNeck) and (bodyBreak ? wBodyBrk : high > wNeck)
bool mBodyBrk = close < mNeck and (open >= mNeck or close[1] >= mNeck)
bool mBreak = mArmed and not na(mNeck) and (bodyBreak ? mBodyBrk : low < mNeck)

// --- setup holati (yorilgandan keyin kirish kutiladi)
var bool  wSetup = false
var float wFib0 = na
var float wFib1 = na
var int   wBreakBar = na
var float wImbTop = na
var float wImbBot = na
var float wObTop = na
var float wObBot = na

var bool  mSetup = false
var float mFib0 = na
var float mFib1 = na
var int   mBreakBar = na
var float mImbTop = na
var float mImbBot = na
var float mObTop = na
var float mObBot = na

var int totalW = 0
var int totalM = 0

if wBreak and not wSetup and strategy.position_size == 0
    wSetup    := true
    wFib0     := wMin2
    wFib1     := close
    wBreakBar := bar_index
    wArmed    := false
    totalW    += 1
    // imbalans (FVG): 1-sham maksimum soyasi va 3-sham minimum soyasi orasi
    wImbBot := high[2]
    wImbTop := low
    if wImbTop <= wImbBot
        wImbTop := na
        wImbBot := na
    // order block: oxirgi bearish shamning tanasi (yorishdan oldin)
    wObTop := na
    wObBot := na
    for i = 1 to 10
        if close[i] < open[i]
            wObTop := open[i]
            wObBot := close[i]
            break

if mBreak and not mSetup and strategy.position_size == 0
    mSetup    := true
    mFib0     := mMax2
    mFib1     := close
    mBreakBar := bar_index
    mArmed    := false
    totalM    += 1
    mImbTop := low[2]
    mImbBot := high
    if mImbBot >= mImbTop
        mImbTop := na
        mImbBot := na
    mObTop := na
    mObBot := na
    for i = 1 to 10
        if close[i] > open[i]
            mObBot := open[i]
            mObTop := close[i]
            break

// oyna tugasa setup bekor
if wSetup and bar_index - wBreakBar > waitBars
    wSetup := false
if mSetup and bar_index - mBreakBar > waitBars
    mSetup := false

// ---------------------------------------------------------------
//  KIRISH NUQTASI
// ---------------------------------------------------------------
inDate = not useDate or (time >= dtStart and time <= dtEnd)

// fib darajalari (W uchun: 0 = min, 1 = yorgan tana)
wRange = wFib1 - wFib0
mRange = mFib0 - mFib1

// fib darajasi: 0 = oxirgi minimum, 1 = yorgan shamning tanasi
f_lvl(float base, float rng, float f) => base + rng * f

bool wEntry = false
float wPx = na
if wSetup and wRange > 0 and strategy.position_size == 0 and inDate and barstate.isconfirmed
    if entryMode == "1-Majburiy sham"
        wEntry := bar_index == wBreakBar
        wPx := close
    else if entryMode == "2-Neckline retest"
        wEntry := low <= wNeck and close > wNeck and bar_index > wBreakBar
        wPx := wNeck
    else if entryMode == "4-OTE 0.5-0.618"
        float zLo = f_lvl(wFib0, wRange, oteLo)
        float zHi = f_lvl(wFib0, wRange, oteHi)
        // LONG: BUY LIMIT zona YUQORI chegarasida (zHi = fib 0.618, birinchi tegiladigan)
        // limitMode: narx zHi ga tushsa yetarli (pastga otilib ketsa ham order to'lgan bo'lardi)
        // eski rejim: sham zona ICHIDA qolishi ham talab qilinadi -> seleksiya biasi
        // limitMode: order oldindan qo'yiladi (siz Exness'da shunday qilasiz).
        //   Trigger = setupning BIRINCHI bari; narx zHi ga tegsa TradingView limitni to'ldiradi.
        //   Narx tegmasa order osilib qoladi va oyna tugaganda bekor qilinadi.
        // eski rejim: sham zona ICHIDA yopilishini kutadi -> seleksiya biasi
        wEntry := limitMode ? (bar_index == wBreakBar + 1) : (low <= zHi and low >= zLo and bar_index > wBreakBar)
        wPx := limitMode ? zHi : math.min(close, zHi)
    else if entryMode == "5-Imbalans (FVG)"
        wEntry := not na(wImbBot) and low <= wImbTop and low >= wImbBot and bar_index > wBreakBar
        wPx := math.min(close, wImbTop)
    else if entryMode == "6-Order block"
        wEntry := not na(wObBot) and low <= wObTop and low >= wObBot and bar_index > wBreakBar
        wPx := math.min(close, wObTop)

bool mEntry = false
float mPx = na
if mSetup and mRange > 0 and strategy.position_size == 0 and inDate and barstate.isconfirmed
    if entryMode == "1-Majburiy sham"
        mEntry := bar_index == mBreakBar
        mPx := close
    else if entryMode == "2-Neckline retest"
        mEntry := high >= mNeck and close < mNeck and bar_index > mBreakBar
        mPx := mNeck
    else if entryMode == "4-OTE 0.5-0.618"
        float zHi = f_lvl(mFib0, -mRange, oteLo)
        float zLo = f_lvl(mFib0, -mRange, oteHi)
        // SHORT: SELL LIMIT zona QUYI chegarasida (zLo = fib 0.618, birinchi tegiladigan)
        // limitMode: narx zLo ga ko'tarilsa yetarli (yuqoriga otilib ketsa ham order to'lgan bo'lardi)
        // eski rejim: sham zona ICHIDA qolishi ham talab qilinadi -> seleksiya biasi
        // limitMode: order oldindan qo'yiladi (siz Exness'da shunday qilasiz).
        //   Trigger = setupning BIRINCHI bari; narx zLo ga tegsa TradingView limitni to'ldiradi.
        //   Narx tegmasa order osilib qoladi va oyna tugaganda bekor qilinadi.
        // eski rejim: sham zona ICHIDA yopilishini kutadi -> seleksiya biasi
        mEntry := limitMode ? (bar_index == mBreakBar + 1) : (high >= zLo and high <= zHi and bar_index > mBreakBar)
        mPx := limitMode ? zLo : math.max(close, zLo)
    else if entryMode == "5-Imbalans (FVG)"
        mEntry := not na(mImbBot) and high >= mImbBot and high <= mImbTop and bar_index > mBreakBar
        mPx := math.max(close, mImbBot)
    else if entryMode == "6-Order block"
        mEntry := not na(mObBot) and high >= mObBot and high <= mObTop and bar_index > mBreakBar
        mPx := math.max(close, mObBot)

// ---------------------------------------------------------------
//  SAVDO
// ---------------------------------------------------------------
var float posEntry = na
var float posSL = na
var float posTP1 = na
var float posTP2 = na
var bool  posLong = false
var bool  tp1Hit = false
var float posR = na
var int   tp1Cnt = 0
var int   tp2Cnt = 0
var int   entriesW = 0
var int   entriesM = 0

// --- RADAR statistikasi (H1 gipotezasini sinash uchun) ---
var int   radBlocked   = 0    // kirish filtri bloklagan savdolar
var int   radTPcut     = 0    // TP qisqartirilgan savdolar
var int   nClear       = 0    // yo'lda to'siq YO'Q savdolar
var int   nObst        = 0    // yo'lda to'siq BOR savdolar
var int   winClear     = 0    // to'siqsiz savdolardan TP1 ga yetganlar
var int   winObst      = 0    // to'siqli savdolardan TP1 ga yetganlar
var bool  curHadObst   = false
var float curObstDist  = na
var float sumObstDist  = 0.0
var int   prevClosedN  = 0

slipVal = slipTick * syminfo.mintick

// ---------- REALISTIK XARAJAT ----------
// Barcha xarajat NARX BIRLIGIDA hisoblanadi va kirish/chiqishga qo'llanadi.
// Kirish narxi yomonlashadi, SL yaqinlashadi, TP uzoqlashadi.
// pip qiymatini simvolga qarab aniqlash (XAUUSD/JPY xatosini oldini oladi)
f_autoPip() =>
    float mt = syminfo.mintick
    mt >= 0.01 and mt < 0.5 ? 0.10 : mt >= 0.001 ? 0.01 : mt * 10
float pipVal   = pipAuto ? f_autoPip() : pipSize
float costPips = useCost ? (costSpread + costComm + costSlip + costSwap) : 0.0
float costPx   = costPips * pipVal        // umumiy xarajat, narx birligida
float costHalf = costPx / 2.0             // kirish va chiqishga bo'linadi

if wEntry
    float e  = wPx + costHalf              // LONG: qimmatroq kiramiz
    float sl = wFib0 - wRange * slBufPct / 100 - costHalf   // SL uzoqroq (yomonroq)
    float r  = e - sl
    if r > 0
        float t1 = f_lvl(wFib0, wRange, tp1Fib) + costHalf   // TP uzoqroq
        float t2 = f_lvl(wFib0, wRange, tp2Fib) + costHalf
        if t1 > e
            // ---------- RADAR ----------
            bool  blocked = false
            bool  hadObst = false
            float obstR   = na
            if useRadar
                [obst, ocnt, ovol] = f_radar(true, e, t1)
                if not na(obst)
                    hadObst := true
                    obstR   := (obst - e) / r
                    if (radarMode == "Kirish filtri" or radarMode == "Hammasi") and obstR < blockBelow
                        blocked := true
                    if (radarMode == "Dinamik TP" or radarMode == "Hammasi") and not blocked
                        float newT1 = obst - r * radarBuf
                        if newT1 < t1 and newT1 > e
                            t1 := math.max(newT1, e + r * minTPr)
                            radTPcut += 1
            if blocked
                radBlocked += 1
            else
                float rAmt = riskMode == "Dollar $" ? riskUsd : strategy.equity * riskPct / 100
                float q = rAmt / (r + slipVal)
                string tag = "W|" + entryMode + (useRadar ? (hadObst ? "|OBST" : "|CLEAR") : "")
                // limitMode: HAQIQIY limit order (zHi narxida to'ladi, sham yopilishida emas)
                if limitMode and entryMode == "4-OTE 0.5-0.618"
                    strategy.entry("L", strategy.long, qty = q, limit = e, comment = tag)
                else
                    strategy.entry("L", strategy.long, qty = q, comment = tag)
                strategy.exit("Lx1", "L", qty_percent = tp1Pct, stop = sl - slipVal, limit = t1)
                if tp1Pct < 100
                    strategy.exit("Lx2", "L", stop = sl - slipVal, limit = t2)
                posEntry := e
                posSL := sl
                posTP1 := t1
                posTP2 := t2
                posLong := true
                tp1Hit := false
                posR := r
                entriesW += 1
                curHadObst  := hadObst
                curObstDist := obstR
                if useRadar
                    if hadObst
                        nObst += 1
                        sumObstDist += obstR
                    else
                        nClear += 1

if mEntry
    float e  = mPx - costHalf              // SHORT: arzonroq sotamiz
    float sl = mFib0 + mRange * slBufPct / 100 + costHalf
    float r  = sl - e
    if r > 0
        float t1 = f_lvl(mFib0, -mRange, tp1Fib) - costHalf  // TP uzoqroq
        float t2 = f_lvl(mFib0, -mRange, tp2Fib) - costHalf
        if t1 < e
            // ---------- RADAR ----------
            bool  blocked = false
            bool  hadObst = false
            float obstR   = na
            if useRadar
                [obst, ocnt, ovol] = f_radar(false, e, t1)
                if not na(obst)
                    hadObst := true
                    obstR   := (e - obst) / r
                    if (radarMode == "Kirish filtri" or radarMode == "Hammasi") and obstR < blockBelow
                        blocked := true
                    if (radarMode == "Dinamik TP" or radarMode == "Hammasi") and not blocked
                        float newT1 = obst + r * radarBuf
                        if newT1 > t1 and newT1 < e
                            t1 := math.min(newT1, e - r * minTPr)
                            radTPcut += 1
            if blocked
                radBlocked += 1
            else
                float rAmt = riskMode == "Dollar $" ? riskUsd : strategy.equity * riskPct / 100
                float q = rAmt / (r + slipVal)
                string tag = "M|" + entryMode + (useRadar ? (hadObst ? "|OBST" : "|CLEAR") : "")
                // limitMode: HAQIQIY limit order (zLo narxida to'ladi, sham yopilishida emas)
                if limitMode and entryMode == "4-OTE 0.5-0.618"
                    strategy.entry("S", strategy.short, qty = q, limit = e, comment = tag)
                else
                    strategy.entry("S", strategy.short, qty = q, comment = tag)
                strategy.exit("Sx1", "S", qty_percent = tp1Pct, stop = sl + slipVal, limit = t1)
                if tp1Pct < 100
                    strategy.exit("Sx2", "S", stop = sl + slipVal, limit = t2)
                posEntry := e
                posSL := sl
                posTP1 := t1
                posTP2 := t2
                posLong := false
                tp1Hit := false
                posR := r
                entriesM += 1
                curHadObst  := hadObst
                curObstDist := obstR
                if useRadar
                    if hadObst
                        nObst += 1
                        sumObstDist += obstR
                    else
                        nClear += 1

// ---------------------------------------------------------------
//  LIMIT ORDER MUDDATI (EXPIRY)
//  Siz Exness'da Expiry qo'yasiz. Backtest ham xuddi shunday qilishi kerak,
//  aks holda to'lmagan order abadiy osilib qoladi va kelajakda tasodifan to'ladi.
//  Oyna (waitBars) tugasa — kutayotgan order BEKOR qilinadi.
// ---------------------------------------------------------------
var int pendBar = na
var bool pendLong = false
if limitMode and entryMode == "4-OTE 0.5-0.618"
    if (wEntry or mEntry) and strategy.position_size == 0
        pendBar := bar_index
        pendLong := wEntry
    // order hali to'lmagan va oyna tugadi -> bekor
    if not na(pendBar) and strategy.position_size == 0
        int lifeBars = bar_index - pendBar
        if lifeBars > waitBars
            strategy.cancel(pendLong ? "L" : "S")
            pendBar := na
            posEntry := na
            posSL := na
            posTP1 := na
            posTP2 := na
            posR := na
    // savdo ochildi -> kuzatuvni tugatamiz
    if strategy.position_size != 0
        pendBar := na

// TP1 urilganini aniqlash -> SL breakevenga
// DIQQAT: tp1Pct=100 bo'lsa savdo TP1 da to'liq yopiladi va position_size 0 bo'ladi.
// Shuning uchun position_size sharti OLIB TASHLANDI — posTP1 mavjudligi yetarli.
if not na(posTP1) and not tp1Hit and not na(posR)
    bool hit = posLong ? high >= posTP1 : low <= posTP1
    if hit
        tp1Hit := true
        tp1Cnt += 1
        if useRadar
            if curHadObst
                winObst += 1
            else
                winClear += 1
        if useBEafter and tp1Pct < 100
            if posLong
                strategy.exit("Lx2", "L", stop = posEntry, limit = posTP2)
            else
                strategy.exit("Sx2", "S", stop = posEntry, limit = posTP2)

if strategy.position_size != 0 and tp1Hit and not na(posTP2)
    if (posLong and high >= posTP2) or (not posLong and low <= posTP2)
        tp2Cnt += 1
        posTP2 := na

if strategy.position_size == 0
    posR := na

if useDate and time > dtEnd and strategy.position_size != 0
    strategy.close_all(comment = "Davr tugadi")

// ---------------------------------------------------------------
//  CHIZMALAR
// ---------------------------------------------------------------
if showViz and wBreak
    line.new(wMin1B, wMin1, wMin2B, wMin2, color = color.new(color.lime, 40), style = line.style_dotted)
    line.new(wNeckB, wNeck, bar_index, wNeck, color = color.new(color.orange, 20), width = 2)
    label.new(bar_index, wNeck, "W", style = label.style_label_down, color = color.new(color.green, 30), textcolor = color.white, size = size.tiny)
if showViz and mBreak
    line.new(mMax1B, mMax1, mMax2B, mMax2, color = color.new(color.red, 40), style = line.style_dotted)
    line.new(mNeckB, mNeck, bar_index, mNeck, color = color.new(color.orange, 20), width = 2)
    label.new(bar_index, mNeck, "M", style = label.style_label_up, color = color.new(color.red, 30), textcolor = color.white, size = size.tiny)

plot(strategy.position_size != 0 ? posSL  : na, "SL",  color.new(color.red, 0),   2, plot.style_linebr)
plot(strategy.position_size != 0 ? posTP1 : na, "TP1", color.new(color.green, 0), 2, plot.style_linebr)
plot(strategy.position_size != 0 ? posTP2 : na, "TP2", color.new(color.teal, 30), 1, plot.style_linebr)
plot(strategy.position_size != 0 ? posEntry : na, "Entry", color.new(color.blue, 0), 1, plot.style_linebr)

// ---------------------------------------------------------------
//  STATISTIKA JADVALI
// ---------------------------------------------------------------
var table st = na
if showStat and barstate.islast
    table.delete(st)
    st := table.new(position.top_right, 2, 20, border_width = 1, frame_color = color.new(color.gray, 50), frame_width = 1)
    cG = color.new(color.green, 60)
    cB = color.new(color.red, 60)
    cN = color.new(color.gray, 60)
    cH = color.new(color.black, 25)
    table.cell(st, 0, 0, "1.618 LEGENDA", text_color = color.white, bgcolor = color.new(color.blue, 35))
    table.cell(st, 1, 0, syminfo.ticker + " " + timeframe.period, text_color = color.white, bgcolor = color.new(color.blue, 35))

    table.cell(st, 0, 1, "Kirish usuli", text_color = color.white, text_size = size.small, bgcolor = cH)
    table.cell(st, 1, 1, entryMode, text_color = color.white, text_size = size.small, bgcolor = color.new(color.purple, 55))

    table.cell(st, 0, 2, "W / M topildi", text_color = color.white, text_size = size.small, bgcolor = cH)
    table.cell(st, 1, 2, str.tostring(totalW) + " / " + str.tostring(totalM) + "  (jami " + str.tostring(totalW + totalM) + ")", text_color = color.white, text_size = size.small, bgcolor = cN)

    table.cell(st, 0, 3, "Savdo ochildi", text_color = color.white, text_size = size.small, bgcolor = cH)
    convPct = (totalW + totalM) > 0 ? (entriesW + entriesM) * 100.0 / (totalW + totalM) : 0
    table.cell(st, 1, 3, str.tostring(entriesW + entriesM) + "  (" + str.tostring(convPct, "#.#") + "% patterndan)", text_color = color.white, text_size = size.small, bgcolor = cN)

    nTr = strategy.closedtrades
    table.cell(st, 0, 4, "Yopilgan savdo", text_color = color.white, text_size = size.small, bgcolor = cH)
    table.cell(st, 1, 4, str.tostring(nTr), text_color = color.white, text_size = size.small, bgcolor = nTr >= 30 ? cG : color.new(color.orange, 60))

    // "GARANT" TEKSHIRUVI
    garPct = (entriesW + entriesM) > 0 ? tp1Cnt * 100.0 / (entriesW + entriesM) : 0
    table.cell(st, 0, 5, "TP1 1.618 'GARANT'", text_color = color.white, text_size = size.small, bgcolor = cH)
    table.cell(st, 1, 5, str.tostring(tp1Cnt) + "  =  " + str.tostring(garPct, "#.#") + "%" + (garPct >= 99 ? "  GARANT!" : "  (100% EMAS)"), text_color = color.white, text_size = size.small, bgcolor = garPct >= 99 ? cG : cB)

    prPct = (entriesW + entriesM) > 0 ? tp2Cnt * 100.0 / (entriesW + entriesM) : 0
    table.cell(st, 0, 6, "TP2 2.618 'prognoz'", text_color = color.white, text_size = size.small, bgcolor = cH)
    table.cell(st, 1, 6, str.tostring(tp2Cnt) + "  =  " + str.tostring(prPct, "#.#") + "%", text_color = color.white, text_size = size.small, bgcolor = cN)

    wr = nTr > 0 ? strategy.wintrades * 100.0 / nTr : 0
    table.cell(st, 0, 7, "Win rate", text_color = color.white, text_size = size.small, bgcolor = cH)
    table.cell(st, 1, 7, str.tostring(wr, "#.#") + "%", text_color = color.white, text_size = size.small, bgcolor = cN)

    table.cell(st, 0, 8, "Net profit", text_color = color.white, text_size = size.small, bgcolor = cH)
    table.cell(st, 1, 8, str.tostring(strategy.netprofit, "#.##"), text_color = color.white, text_size = size.small, bgcolor = strategy.netprofit > 0 ? cG : cB)

    table.cell(st, 0, 9, "Max DD", text_color = color.white, text_size = size.small, bgcolor = cH)
    table.cell(st, 1, 9, str.tostring(strategy.max_drawdown, "#.##"), text_color = color.white, text_size = size.small, bgcolor = cN)

    pf = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : 0
    table.cell(st, 0, 10, "Profit factor", text_color = color.white, text_size = size.small, bgcolor = cH)
    table.cell(st, 1, 10, str.tostring(pf, "#.###"), text_color = color.white, text_size = size.small, bgcolor = pf >= 1.3 ? cG : cB)

    rf = strategy.max_drawdown > 0 ? strategy.netprofit / strategy.max_drawdown : 0
    table.cell(st, 0, 11, "Recovery factor", text_color = color.white, text_size = size.small, bgcolor = cH)
    table.cell(st, 1, 11, str.tostring(rf, "#.##") + (rf >= 2 ? "  OK" : "  past"), text_color = color.white, text_size = size.small, bgcolor = rf >= 2 ? cG : cB)

    expR = nTr > 0 ? strategy.netprofit / nTr / (riskMode == "Dollar $" ? riskUsd : strategy.initial_capital * riskPct / 100) : 0
    // ---------- RADAR STATISTIKASI (H1 gipotezasi) ----------
    table.cell(st, 0, 13, "RADAR", text_color = color.white, text_size = size.small, bgcolor = color.new(color.blue, 40))
    table.cell(st, 1, 13, useRadar ? radarMode : "o'chiq", text_color = color.white, text_size = size.small, bgcolor = useRadar ? color.new(color.blue, 55) : cN)

    table.cell(st, 0, 14, "  Faol EQH/EQL", text_color = color.white, text_size = size.small, bgcolor = cH)
    table.cell(st, 1, 14, useRadar ? str.tostring(array.size(eqZones)) + " yechilmagan / " + str.tostring(eqSweptCnt) + " supurilgan" : "-", text_color = color.white, text_size = size.small, bgcolor = cN)

    int totRad = nClear + nObst
    table.cell(st, 0, 15, "  Yo'l toza / to'siqli", text_color = color.white, text_size = size.small, bgcolor = cH)
    table.cell(st, 1, 15, useRadar and totRad > 0 ? str.tostring(nClear) + " / " + str.tostring(nObst) + "  (" + str.tostring(nObst * 100.0 / totRad, "#.#") + "% to'siqli)" : "-", text_color = color.white, text_size = size.small, bgcolor = cN)

    float wrClear = nClear > 0 ? winClear * 100.0 / nClear : 0
    float wrObst  = nObst  > 0 ? winObst  * 100.0 / nObst  : 0
    table.cell(st, 0, 16, "  TP1%: toza vs to'siqli", text_color = color.white, text_size = size.small, bgcolor = cH)
    table.cell(st, 1, 16, useRadar and totRad > 0 ? str.tostring(wrClear, "#.#") + "%  vs  " + str.tostring(wrObst, "#.#") + "%" : "-", text_color = color.white, text_size = size.small, bgcolor = useRadar and nClear >= 10 and nObst >= 10 ? (wrClear > wrObst ? cG : cB) : cN)

    table.cell(st, 0, 18, "XARAJAT", text_color = color.white, text_size = size.small, bgcolor = useCost ? color.new(color.orange, 40) : color.new(color.black, 25))
    table.cell(st, 1, 18, useCost ? str.tostring(costPips, "#.#") + " pip/savdo  (REALISTIK)" : "0 pip  (ALDAMCHI!)", text_color = color.white, text_size = size.small, bgcolor = useCost ? color.new(color.orange, 55) : cB)

    table.cell(st, 0, 19, "KIRISH REJIMI", text_color = color.white, text_size = size.small, bgcolor = limitMode ? color.new(color.blue, 40) : color.new(color.red, 30))
    table.cell(st, 1, 19, limitMode ? "LIMIT ORDER (realistik)" : "sham ichida (BIASLI +8pp)", text_color = color.white, text_size = size.small, bgcolor = limitMode ? color.new(color.blue, 60) : cB)

    table.cell(st, 0, 17, "  Bloklandi / TP kesildi", text_color = color.white, text_size = size.small, bgcolor = cH)
    float avgObst = nObst > 0 ? sumObstDist / nObst : 0
    table.cell(st, 1, 17, useRadar ? str.tostring(radBlocked) + " / " + str.tostring(radTPcut) + "   (o'rt. to'siq " + str.tostring(avgObst, "#.##") + "R)" : "-", text_color = color.white, text_size = size.small, bgcolor = cN)

    table.cell(st, 0, 12, "Expectancy (R)", text_color = color.white, text_size = size.small, bgcolor = cH)
    table.cell(st, 1, 12, str.tostring(expR, "#.###") + "R", text_color = color.white, text_size = size.small, bgcolor = expR > 0 ? cG : cB)

// ---------------------------------------------------------------
//  ALERTLAR
// ---------------------------------------------------------------
// DIQQAT: strategy() skriptida alertcondition() ISHLAMAYDI —
// u faqat indicator() da ko'rinadi. Shuning uchun alert() ishlatamiz.
// TradingView'da: Alt+A -> Condition = strategiya nomi -> "Any alert() function call"

float wZoneHi = wSetup and wRange > 0 ? f_lvl(wFib0, wRange, oteHi) : na
float wZoneLo = wSetup and wRange > 0 ? f_lvl(wFib0, wRange, oteLo) : na
float wSLpre  = wSetup and wRange > 0 ? wFib0 - wRange * slBufPct / 100 : na
float wTPpre  = wSetup and wRange > 0 ? f_lvl(wFib0, wRange, tp1Fib) : na

float mZoneLo = mSetup and mRange > 0 ? f_lvl(mFib0, -mRange, oteHi) : na
float mZoneHi = mSetup and mRange > 0 ? f_lvl(mFib0, -mRange, oteLo) : na
float mSLpre  = mSetup and mRange > 0 ? mFib0 + mRange * slBufPct / 100 : na
float mTPpre  = mSetup and mRange > 0 ? f_lvl(mFib0, -mRange, tp1Fib) : na

bool wSetupNew = wBreak and wRange > 0
bool mSetupNew = mBreak and mRange > 0

f_px(float v) => str.tostring(v, format.mintick)

// --- 1) SETUP alerti: neckline yorildi, kirishgacha ~30 bar vaqt bor
if wSetupNew and barstate.isconfirmed
    alert("1.618 SETUP LONG | " + syminfo.ticker + " " + timeframe.period +
          "\nBUY LIMIT zona: " + f_px(wZoneLo) + " - " + f_px(wZoneHi) +
          "\nSL: " + f_px(wSLpre) + "   TP: " + f_px(wTPpre) +
          "\nOyna: " + str.tostring(waitBars) + " bar", alert.freq_once_per_bar_close)

if mSetupNew and barstate.isconfirmed
    alert("1.618 SETUP SHORT | " + syminfo.ticker + " " + timeframe.period +
          "\nSELL LIMIT zona: " + f_px(mZoneLo) + " - " + f_px(mZoneHi) +
          "\nSL: " + f_px(mSLpre) + "   TP: " + f_px(mTPpre) +
          "\nOyna: " + str.tostring(waitBars) + " bar", alert.freq_once_per_bar_close)

// --- 2) KIRISH alerti: savdo aynan hozir ochildi
if wEntry and barstate.isconfirmed
    alert("1.618 KIRISH LONG | " + syminfo.ticker + " " + timeframe.period +
          "\nNarx: " + f_px(close), alert.freq_once_per_bar_close)

if mEntry and barstate.isconfirmed
    alert("1.618 KIRISH SHORT | " + syminfo.ticker + " " + timeframe.period +
          "\nNarx: " + f_px(close), alert.freq_once_per_bar_close)

// Setup zonasini grafikda ko'rsatish (limit order qayerga qo'yishni ko'rish uchun)
plot(showViz and wSetup ? wZoneHi : na, "W OTE yuqori", color.new(color.green, 30), 1, plot.style_linebr)
plot(showViz and wSetup ? wZoneLo : na, "W OTE past",   color.new(color.green, 30), 1, plot.style_linebr)
plot(showViz and mSetup ? mZoneHi : na, "M OTE yuqori", color.new(color.red, 30),   1, plot.style_linebr)
plot(showViz and mSetup ? mZoneLo : na, "M OTE past",   color.new(color.red, 30),   1, plot.style_linebr)

// ===============================================================
//  SAVDO REJASI — ENTRY / SL / TP chiziqlari + yozuvlari
//  Maqsad: limit orderni qayerga qo'yishni ko'z bilan ko'rish.
//  Ustuvorlik: 1) ochiq savdo  2) faol M setup  3) faol W setup
// ===============================================================
planTxtSize = planSize == "tiny" ? size.tiny : planSize == "small" ? size.small : planSize == "large" ? size.large : size.normal

var line  plE   = na
var line  plS   = na
var line  plT   = na
var label lbE   = na
var label lbS   = na
var label lbT   = na
var box   plBox = na
var table plTab = na

// --- reja qiymatlari (global, har barda qayta hisoblanadi)
float pE = na
float pS = na
float pT = na
float pZ = na
bool  pLong  = false
int   pStart = bar_index
int   pLeft  = 0
string pState = ""

if strategy.position_size != 0 and not na(posEntry)
    pE     := posEntry
    pS     := posSL
    pT     := posTP1
    pLong  := posLong
    pState := "SAVDO OCHIQ"
    pStart := bar_index - 20
else if mSetup and mRange > 0
    pZ     := f_lvl(mFib0, -mRange, oteLo)     // zona yuqori (fib 0.5)
    pE     := f_lvl(mFib0, -mRange, oteHi)     // zona quyi (fib 0.618) = SELL LIMIT narxi
    pS     := mFib0 + mRange * slBufPct / 100
    pT     := f_lvl(mFib0, -mRange, tp1Fib)
    pLong  := false
    pStart := mBreakBar
    pLeft  := waitBars - (bar_index - mBreakBar)
    pState := pLeft > 0 ? "SELL LIMIT qo'ying" : "OYNA YOPILDI"
else if wSetup and wRange > 0
    pZ     := f_lvl(wFib0, wRange, oteLo)
    pE     := f_lvl(wFib0, wRange, oteHi)
    pS     := wFib0 - wRange * slBufPct / 100
    pT     := f_lvl(wFib0, wRange, tp1Fib)
    pLong  := true
    pStart := wBreakBar
    pLeft  := waitBars - (bar_index - wBreakBar)
    pState := pLeft > 0 ? "BUY LIMIT qo'ying" : "OYNA YOPILDI"

// --- lot / risk hisobi
float slDist   = na(pE) ? na : math.abs(pE - pS)
float tpDist   = na(pE) ? na : math.abs(pT - pE)
float planRR   = na(slDist) or slDist <= 0 ? na : tpDist / slDist
float slPip    = na(slDist) ? na : slDist / pipVal
float tpPip    = na(tpDist) ? na : tpDist / pipVal
float planAmt  = planBal * planRisk / 100
float lotRaw   = na(slPip) or slPip <= 0 ? na : planAmt / (slPip * 10)
float planLot  = na(lotRaw) ? na : math.round(lotRaw * 100) / 100
float planRiskUsd = na(planLot) ? na : planLot * slPip * 10
float planProfUsd = na(planLot) ? na : planLot * tpPip * 10

if showPlan and barstate.islast
    line.delete(plE)
    line.delete(plS)
    line.delete(plT)
    label.delete(lbE)
    label.delete(lbS)
    label.delete(lbT)
    box.delete(plBox)
    if not na(pE)
        int xR = bar_index + planRight
        // kirish zonasi (OTE 0.5-0.618)
        if not na(pZ)
            plBox := box.new(pStart, math.max(pE, pZ), xR, math.min(pE, pZ),
                 border_color = color.new(color.gray, 60), bgcolor = color.new(color.gray, 88))
        // chiziqlar
        plE := line.new(pStart, pE, xR, pE, color = #2962FF, width = planWidth)
        plS := line.new(pStart, pS, xR, pS, color = #F23645, width = planWidth)
        plT := line.new(pStart, pT, xR, pT, color = #089981, width = planWidth)
        // yozuvlar
        lbE := label.new(xR, pE, "ENTRY  " + str.tostring(pE, format.mintick),
             style = label.style_label_left, color = #2962FF, textcolor = color.white, size = planTxtSize)
        lbS := label.new(xR, pS, "SL  " + str.tostring(pS, format.mintick),
             style = label.style_label_left, color = #F23645, textcolor = color.white, size = planTxtSize)
        lbT := label.new(xR, pT, "TP  " + str.tostring(pT, format.mintick),
             style = label.style_label_left, color = #089981, textcolor = color.white, size = planTxtSize)

// --- panel
if showPlan and showPanel and barstate.islast
    table.delete(plTab)
    if not na(pE)
        plTab := table.new(position.bottom_right, 2, 10, border_width = 1, border_color = color.new(color.gray, 50))
        table.cell(plTab, 0, 0, "SAVDO REJASI", bgcolor = #1F3864, text_color = color.white, text_size = size.small)
        table.cell(plTab, 1, 0, pLong ? "LONG (sotib olish)" : "SHORT (sotish)",
             bgcolor = pLong ? #089981 : #F23645, text_color = color.white, text_size = size.small)

        table.cell(plTab, 0, 1, "Holat", bgcolor = color.new(color.black, 15), text_color = color.silver, text_size = size.small, text_halign = text.align_left)
        table.cell(plTab, 1, 1, pState, bgcolor = pLeft > 0 or pState == "SAVDO OCHIQ" ? color.new(#089981, 30) : color.new(#F23645, 30), text_color = color.white, text_size = size.small)

        table.cell(plTab, 0, 2, "ENTRY", bgcolor = color.new(color.black, 15), text_color = color.silver, text_size = size.small, text_halign = text.align_left)
        table.cell(plTab, 1, 2, str.tostring(pE, format.mintick), bgcolor = color.new(#2962FF, 25), text_color = color.white, text_size = size.small)

        table.cell(plTab, 0, 3, "SL", bgcolor = color.new(color.black, 15), text_color = color.silver, text_size = size.small, text_halign = text.align_left)
        table.cell(plTab, 1, 3, str.tostring(pS, format.mintick) + "   " + str.tostring(slPip, "#.#") + " pip", bgcolor = color.new(#F23645, 25), text_color = color.white, text_size = size.small)

        table.cell(plTab, 0, 4, "TP", bgcolor = color.new(color.black, 15), text_color = color.silver, text_size = size.small, text_halign = text.align_left)
        table.cell(plTab, 1, 4, str.tostring(pT, format.mintick) + "   " + str.tostring(tpPip, "#.#") + " pip", bgcolor = color.new(#089981, 25), text_color = color.white, text_size = size.small)

        table.cell(plTab, 0, 5, "RR", bgcolor = color.new(color.black, 15), text_color = color.silver, text_size = size.small, text_halign = text.align_left)
        table.cell(plTab, 1, 5, "1 : " + str.tostring(planRR, "#.##"), bgcolor = color.new(color.black, 15), text_color = color.white, text_size = size.small)

        table.cell(plTab, 0, 6, "LOT", bgcolor = color.new(color.black, 15), text_color = color.silver, text_size = size.small, text_halign = text.align_left)
        table.cell(plTab, 1, 6, str.tostring(planLot, "#.##"), bgcolor = color.new(color.orange, 35), text_color = color.white, text_size = size.small)

        table.cell(plTab, 0, 7, "Risk", bgcolor = color.new(color.black, 15), text_color = color.silver, text_size = size.small, text_halign = text.align_left)
        table.cell(plTab, 1, 7, "$" + str.tostring(planRiskUsd, "#.##") + "  (" + str.tostring(planRiskUsd / planBal * 100, "#.##") + "%)", bgcolor = color.new(color.black, 15), text_color = color.white, text_size = size.small)

        table.cell(plTab, 0, 8, "Foyda", bgcolor = color.new(color.black, 15), text_color = color.silver, text_size = size.small, text_halign = text.align_left)
        table.cell(plTab, 1, 8, "$" + str.tostring(planProfUsd, "#.##"), bgcolor = color.new(color.black, 15), text_color = color.white, text_size = size.small)

        table.cell(plTab, 0, 9, "Oyna", bgcolor = color.new(color.black, 15), text_color = color.silver, text_size = size.small, text_halign = text.align_left)
        table.cell(plTab, 1, 9, pState == "SAVDO OCHIQ" ? "-" : str.tostring(math.max(pLeft, 0)) + " bar qoldi",
             bgcolor = pLeft > 3 ? color.new(#089981, 30) : color.new(color.orange, 30), text_color = color.white, text_size = size.small)
