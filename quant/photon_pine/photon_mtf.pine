//@version=6
// =============================================================
//  PHOTON MTF — HTF Objective -> MTF POIs -> LTF Execution
//  Repaint YO'Q: barcha HTF ma'lumot faqat YOPILGAN shamdan.
//  Signal BERMAYDI — grafikni tayyorlaydi, qaror sizniki.
// =============================================================
indicator("Photon MTF", overlay = true, max_boxes_count = 500,
     max_lines_count = 500, max_labels_count = 500)

// ------------------------------------------------------------- INPUTS
gTF   = "Taymfreymlar"
htf_s = input.timeframe("240", "HTF (narrativ)",  group = gTF)
mtf_s = input.timeframe("60",  "MTF (POI)",       group = gTF)
ltf_s = input.timeframe("15",  "LTF (ijro)",      group = gTF)

gST   = "Struktura"
sw_l  = input.int(2, "Swing chap",  minval = 1, maxval = 5, group = gST)
sw_r  = input.int(2, "Swing o'ng",  minval = 1, maxval = 5, group = gST,
     tooltip = "Kattaroq = kamroq lekin ishonchliroq swing. Tasdiq uchun shuncha sham kutiladi.")
use_close_bos = input.bool(true, "BOS yopilish bilan tasdiqlansin", group = gST)

gZN   = "Zonalar"
show_ob   = input.bool(true,  "Order Block",       group = gZN)
show_fvg  = input.bool(true,  "FVG / Imbalance",   group = gZN)
show_lq   = input.bool(true,  "Likvidlik (EQH/EQL)", group = gZN)
show_pd   = input.bool(true,  "Premium / Discount", group = gZN)
max_zones = input.int(6, "Har turdan maks zona", minval = 1, maxval = 20, group = gZN)
eq_tol_atr= input.float(0.10, "EQH/EQL tolerans (ATR)", minval = 0.01, step = 0.01, group = gZN)

gSS   = "Sessiya"
show_sess = input.bool(true, "Sessiya oynalari", group = gSS)
ldn_s = input.session("0700-1000", "London", group = gSS)
ny_s  = input.session("1200-1600", "New York", group = gSS)

gRK   = "Risk"
risk_pct  = input.float(0.5, "Risk %",  minval = 0.1, step = 0.1, group = gRK)
rr_target = input.float(3.0, "TP (R)",  minval = 1.0, step = 0.5, group = gRK)
acct_size = input.float(10000, "Hisob", minval = 100, group = gRK)
spread_px = input.float(0.3, "Spred (pip)", minval = 0.0, step = 0.1, group = gRK,
     tooltip = "Real RR ni hisoblashda ishlatiladi")

gUI   = "Ko'rinish"
show_dash = input.bool(true, "Dashboard", group = gUI)
dash_pos  = input.string("top_right", "Joyi", options = ["top_right","top_left","bottom_right","bottom_left"], group = gUI)

// ------------------------------------------------------------- TYPES
type Swing
    int   bar
    float price
    bool  isHigh

type Zone
    box   b
    float top
    float bot
    bool  bull
    int   bar
    bool  mitigated
    string kind

type StructState
    float lastSH   = na
    float lastSL   = na
    float prevSH   = na
    float prevSL   = na
    string bias    = "RANGE"
    string lastEv  = ""
    int    lastEvBar = na

// ------------------------------------------------------------- HELPERS
// FAQAT YOPILGAN sham — repaint himoyasi
f_htf(simple string tf, series float src) =>
    request.security(syminfo.tickerid, tf, src[1], lookahead = barmerge.lookahead_off)

f_atr(simple string tf) =>
    request.security(syminfo.tickerid, tf, ta.atr(14)[1], lookahead = barmerge.lookahead_off)

// ------------------------------------------------------------- HTF DATA
htf_h = f_htf(htf_s, high)
htf_l = f_htf(htf_s, low)
htf_c = f_htf(htf_s, close)
htf_o = f_htf(htf_s, open)

mtf_h = f_htf(mtf_s, high)
mtf_l = f_htf(mtf_s, low)
mtf_c = f_htf(mtf_s, close)
mtf_o = f_htf(mtf_s, open)

atr_mtf = f_atr(mtf_s)
atr_cur = ta.atr(14)

// ------------------------------------------------------------- STRUCTURE
var StructState stH = StructState.new()
var StructState stM = StructState.new()
var StructState stL = StructState.new()

// swing aniqlash — ta.pivothigh/low tasdiqlangan qiymat qaytaradi
f_updateStruct(StructState st, float ph, float pl, float px_up, float px_dn) =>
    string ev = ""
    if not na(ph)
        st.prevSH := st.lastSH
        st.lastSH := ph
    if not na(pl)
        st.prevSL := st.lastSL
        st.lastSL := pl
    if not na(st.lastSH) and px_up > st.lastSH
        ev := st.bias == "BEAR" ? "CHoCH" : "BOS"
        st.bias := "BULL"
        st.lastEv := ev + "↑"
        st.lastEvBar := bar_index
        st.lastSH := na
    if not na(st.lastSL) and px_dn < st.lastSL
        ev := st.bias == "BULL" ? "CHoCH" : "BOS"
        st.bias := "BEAR"
        st.lastEv := ev + "↓"
        st.lastEvBar := bar_index
        st.lastSL := na
    ev

// LTF (joriy grafik) strukturasi
ph_l = ta.pivothigh(high, sw_l, sw_r)
pl_l = ta.pivotlow(low,  sw_l, sw_r)
ev_l = f_updateStruct(stL, ph_l, pl_l, use_close_bos ? close : high, use_close_bos ? close : low)

// MTF strukturasi — HTF seriyadan pivot
ph_m = ta.pivothigh(mtf_h, sw_l, sw_r)
pl_m = ta.pivotlow(mtf_l,  sw_l, sw_r)
ev_m = f_updateStruct(stM, ph_m, pl_m, use_close_bos ? mtf_c : mtf_h, use_close_bos ? mtf_c : mtf_l)

// HTF strukturasi
ph_h = ta.pivothigh(htf_h, sw_l, sw_r)
pl_h = ta.pivotlow(htf_l,  sw_l, sw_r)
ev_h = f_updateStruct(stH, ph_h, pl_h, use_close_bos ? htf_c : htf_h, use_close_bos ? htf_c : htf_l)

// ------------------------------------------------------------- ZONES
var array<Zone> zOB  = array.new<Zone>()
var array<Zone> zFVG = array.new<Zone>()

f_pushZone(array<Zone> arr, float t, float b, bool bull, string kind, color bg, color br) =>
    if array.size(arr) >= max_zones
        old = array.shift(arr)
        box.delete(old.b)
    bx = box.new(bar_index, t, bar_index + 20, b, bgcolor = bg,
         border_color = br, border_width = 1, extend = extend.right,
         text = kind, text_size = size.tiny, text_color = color.new(color.white, 40),
         text_halign = text.align_left, text_valign = bull ? text.align_bottom : text.align_top)
    array.push(arr, Zone.new(bx, t, b, bull, bar_index, false, kind))

// --- FVG (joriy TF, 3 sham) ---
if show_fvg and barstate.isconfirmed
    if low > high[2] and (low - high[2]) > atr_cur * 0.1
        f_pushZone(zFVG, low, high[2], true, "FVG",
             color.new(color.teal, 88), color.new(color.teal, 55))
    if low[2] > high and (low[2] - high) > atr_cur * 0.1
        f_pushZone(zFVG, low[2], high, false, "FVG",
             color.new(color.maroon, 88), color.new(color.maroon, 55))

// --- Order Block: BOS/CHoCH dan oldingi oxirgi qarama-qarshi sham ---
f_findOB(bool bullEvent) =>
    float t = na
    float b = na
    for i = 1 to 12
        bool opp = bullEvent ? (close[i] < open[i]) : (close[i] > open[i])
        if opp
            t := high[i]
            b := low[i]
            break
    [t, b]

if show_ob and ev_l != "" and barstate.isconfirmed
    bool bullEv = str.contains(stL.lastEv, "↑")
    [obT, obB] = f_findOB(bullEv)
    if not na(obT)
        f_pushZone(zOB, obT, obB, bullEv, "OB",
             bullEv ? color.new(color.green, 85) : color.new(color.red, 85),
             bullEv ? color.new(color.green, 45) : color.new(color.red, 45))

// --- mitigatsiya belgilash ---
f_markMitigation(array<Zone> arr) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            z = array.get(arr, i)
            if not z.mitigated and low <= z.top and high >= z.bot
                z.mitigated := true
                box.set_border_style(z.b, line.style_solid)
                box.set_border_width(z.b, 2)

f_markMitigation(zOB)
f_markMitigation(zFVG)

// ------------------------------------------------------------- LIQUIDITY
var array<line> lqLines = array.new<line>()
var float lastPH = na
var float lastPL = na

if show_lq and not na(ph_l)
    if not na(lastPH) and math.abs(ph_l - lastPH) <= atr_cur * eq_tol_atr
        ln = line.new(bar_index - sw_r * 3, ph_l, bar_index + 10, ph_l,
             color = color.new(color.orange, 30), style = line.style_dotted, width = 2)
        array.push(lqLines, ln)
        if array.size(lqLines) > 12
            line.delete(array.shift(lqLines))
        label.new(bar_index + 10, ph_l, "EQH", style = label.style_label_left,
             color = color.new(color.orange, 70), textcolor = color.white, size = size.tiny)
    lastPH := ph_l

if show_lq and not na(pl_l)
    if not na(lastPL) and math.abs(pl_l - lastPL) <= atr_cur * eq_tol_atr
        ln = line.new(bar_index - sw_r * 3, pl_l, bar_index + 10, pl_l,
             color = color.new(color.blue, 30), style = line.style_dotted, width = 2)
        array.push(lqLines, ln)
        if array.size(lqLines) > 12
            line.delete(array.shift(lqLines))
        label.new(bar_index + 10, pl_l, "EQL", style = label.style_label_left,
             color = color.new(color.blue, 70), textcolor = color.white, size = size.tiny)
    lastPL := pl_l

// ------------------------------------------------------------- PREMIUM / DISCOUNT
var box pdPrem = na
var box pdDisc = na
var line pdEq  = na

f_pd(float hi, float lo, float px) =>
    float pos = (hi - lo) > 0 ? (px - lo) / (hi - lo) : na
    string zone = na(pos) ? "—" :
         pos > 0.79 ? "EXT PREM" : pos > 0.5 ? "PREMIUM" :
         pos < 0.21 ? "EXT DISC" : "DISCOUNT"
    [pos, zone]

mtfSH = nz(stM.lastSH, stM.prevSH)
mtfSL = nz(stM.lastSL, stM.prevSL)
[pdPos, pdZone] = f_pd(mtfSH, mtfSL, close)

if show_pd and not na(mtfSH) and not na(mtfSL) and barstate.islast
    box.delete(pdPrem)
    box.delete(pdDisc)
    line.delete(pdEq)
    mid = (mtfSH + mtfSL) / 2
    pdPrem := box.new(bar_index - 60, mtfSH, bar_index + 15, mid,
         bgcolor = color.new(color.red, 94), border_color = color.new(color.red, 70))
    pdDisc := box.new(bar_index - 60, mid, bar_index + 15, mtfSL,
         bgcolor = color.new(color.green, 94), border_color = color.new(color.green, 70))
    pdEq := line.new(bar_index - 60, mid, bar_index + 15, mid,
         color = color.new(color.gray, 30), style = line.style_dashed)

// ------------------------------------------------------------- MTF PHASE (A/B/C/D)
// Photon jadvali:
//   A = Pro Swing + Pro Internal      C = Counter Swing + Pro Internal
//   B = Pro Swing + Counter Internal  D = Counter Swing + Counter Internal
f_phase(string htfB, string mtfB, string ltfB) =>
    if htfB == "RANGE" or mtfB == "RANGE"
        "RANGE"
    else
        bool proSwing   = htfB == mtfB
        bool proInternal= mtfB == ltfB
        proSwing and proInternal      ? "A" :
         proSwing and not proInternal ? "B" :
         not proSwing and proInternal ? "C" : "D"

phase = f_phase(stH.bias, stM.bias, stL.bias)
phaseDesc = phase == "A" ? "Pro Swing + Pro Internal" :
     phase == "B" ? "Pro Swing + Counter Internal" :
     phase == "C" ? "Counter Swing + Pro Internal" :
     phase == "D" ? "AVOID — Counter + Counter" : "Range — chetda turing"

// ------------------------------------------------------------- LC ENTRY MODELS
// LC-1  : LID sweep — MTF oyog'idagi kuchli likvidlik olindi, PBID yo'q
// LC-2A : Fake break — LTF fraktal buzildi va darhol qaytdi
var float lcLevel = na
var string lcType = ""
var int lcBar = na

sweepUp   = not na(ph_l[1]) and high > ph_l[1] and close < ph_l[1]
sweepDown = not na(pl_l[1]) and low  < pl_l[1] and close > pl_l[1]

// zona ichida bo'lsa — sifatliroq
f_inAnyZone(float px) =>
    bool res = false
    if array.size(zOB) > 0
        for i = 0 to array.size(zOB) - 1
            z = array.get(zOB, i)
            if px <= z.top and px >= z.bot
                res := true
                break
    if not res and array.size(zFVG) > 0
        for i = 0 to array.size(zFVG) - 1
            z = array.get(zFVG, i)
            if px <= z.top and px >= z.bot
                res := true
                break
    res

if barstate.isconfirmed and (sweepUp or sweepDown)
    bool inZone = f_inAnyZone(sweepUp ? high : low)
    lcType := inZone ? "LC-2A" : "LC-1"
    lcLevel := sweepUp ? high : low
    lcBar := bar_index
    label.new(bar_index, sweepUp ? high : low,
         lcType + (sweepUp ? " ↓" : " ↑"),
         style = sweepUp ? label.style_label_down : label.style_label_up,
         color = color.new(sweepUp ? color.red : color.green, 25),
         textcolor = color.white, size = size.tiny)

// ------------------------------------------------------------- SESSIONS
inLDN = show_sess and not na(time(timeframe.period, ldn_s))
inNY  = show_sess and not na(time(timeframe.period, ny_s))
bgcolor(inLDN ? color.new(color.blue, 95) : inNY ? color.new(color.purple, 95) : na)

// ------------------------------------------------------------- RISK CALC
pipSize = syminfo.mintick * (syminfo.type == "forex" ? 10 : 1)
slDist  = na(lcLevel) ? atr_cur * 1.5 : math.abs(close - lcLevel)
slPips  = slDist / pipSize
riskUsd = acct_size * risk_pct / 100
realRR  = slPips > 0 ? (slPips * rr_target - spread_px) / (slPips + spread_px) : na

// ------------------------------------------------------------- DASHBOARD
var table dash = na

cBull = color.new(color.green, 60)
cBear = color.new(color.red, 60)
cNeut = color.new(color.gray, 60)

f_biasCol(string b) => b == "BULL" ? cBull : b == "BEAR" ? cBear : cNeut

f_row(table t, int r, string k, string v, color bg) =>
    table.cell(t, 0, r, k, text_color = color.new(color.white, 20),
         text_size = size.small, bgcolor = color.new(color.black, 20),
         text_halign = text.align_left)
    table.cell(t, 1, r, v, text_color = color.white,
         text_size = size.small, bgcolor = bg, text_halign = text.align_right)

if show_dash and barstate.islast
    table.delete(dash)
    pos = dash_pos == "top_right" ? position.top_right :
         dash_pos == "top_left" ? position.top_left :
         dash_pos == "bottom_right" ? position.bottom_right : position.bottom_left
    dash := table.new(pos, 2, 11, border_width = 1,
         frame_color = color.new(color.gray, 50), frame_width = 1)

    table.cell(dash, 0, 0, "PHOTON MTF", text_color = color.white,
         text_size = size.normal, bgcolor = color.new(color.blue, 40))
    table.cell(dash, 1, 0, syminfo.ticker, text_color = color.white,
         text_size = size.normal, bgcolor = color.new(color.blue, 40))

    f_row(dash, 1, "HTF " + htf_s, stH.bias + " " + stH.lastEv, f_biasCol(stH.bias))
    f_row(dash, 2, "MTF " + mtf_s, stM.bias + " " + stM.lastEv, f_biasCol(stM.bias))
    f_row(dash, 3, "LTF " + ltf_s, stL.bias + " " + stL.lastEv, f_biasCol(stL.bias))
    f_row(dash, 4, "MTF Faza", phase, phase == "A" ? cBull : phase == "D" ? cBear : cNeut)
    f_row(dash, 5, "Izoh", phaseDesc, cNeut)
    f_row(dash, 6, "P&D", pdZone + (na(pdPos) ? "" : " " + str.tostring(pdPos * 100, "#") + "%"),
         pdZone == "DISCOUNT" or pdZone == "EXT DISC" ? cBull :
         pdZone == "PREMIUM" or pdZone == "EXT PREM" ? cBear : cNeut)
    f_row(dash, 7, "Oxirgi LC", na(lcBar) ? "—" : lcType + " (" + str.tostring(bar_index - lcBar) + " bar)", cNeut)
    f_row(dash, 8, "Sessiya", inLDN ? "LONDON" : inNY ? "NEW YORK" : "—",
         inLDN or inNY ? color.new(color.blue, 60) : cNeut)
    f_row(dash, 9, "SL / Risk", str.tostring(slPips, "#.#") + " pip / $" + str.tostring(riskUsd, "#.##"), cNeut)
    f_row(dash, 10, "Real RR", na(realRR) ? "—" : "1:" + str.tostring(realRR, "#.##"),
         na(realRR) ? cNeut : realRR >= rr_target * 0.9 ? cBull : cBear)

// ------------------------------------------------------------- ALERTS
alertcondition(ev_h != "", "HTF struktura", "HTF BOS/CHoCH")
alertcondition(ev_m != "", "MTF struktura", "MTF BOS/CHoCH")
alertcondition(sweepUp or sweepDown, "LC sweep", "LC-1/LC-2A likvidlik olindi")
