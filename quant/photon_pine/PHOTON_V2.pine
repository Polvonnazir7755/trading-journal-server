//@version=6
// ==============================================================
//  PHOTON MTF v2 — Swing / Internal ajratilgan
//
//  V1 dan farqi:
//   1) SWING va INTERNAL struktura ALOHIDA (turli fraktal o'lchami)
//      -> Photon fazalari TO'G'RI hisoblanadi
//   2) Signal manbai kengaytirildi (ko'p TF sweep + POI retest)
//   3) Entry / SL / TP grafikda chiziladi
//   4) Dashboard: har faza bo'yicha SAVDO SONI va WIN RATE
//   5) Default: faqat A + B faza
//
//  Repaint YO'Q — HTF ma'lumot faqat yopilgan shamdan.
// ==============================================================
strategy("Photon MTF v2", overlay = true,
     initial_capital         = 10000,
     default_qty_type        = strategy.percent_of_equity,
     default_qty_value       = 100,
     commission_type         = strategy.commission.cash_per_order,
     commission_value        = 3.5,
     slippage                = 2,
     calc_on_every_tick      = false,
     process_orders_on_close = true,
     max_boxes_count         = 500,
     max_lines_count         = 500,
     max_labels_count        = 500,
     margin_long = 0, margin_short = 0)

// -------------------------------------------------------------- MODE
gMD  = "① Rejim"
mode = input.string("Backtest", "Rejim", options = ["Backtest", "Faqat indikator"], group = gMD)
tradingOn = mode == "Backtest"

// --------------------------------------------------------- TIMEFRAMES
gTF   = "② Taymfreymlar"
htf_s = input.timeframe("240", "HTF — narrativ",  group = gTF,
     tooltip = "Umumiy yo'nalish. Photon: 1D yoki 4H")
mtf_s = input.timeframe("60",  "MTF — POI",       group = gTF,
     tooltip = "Asosiy ish TF. Swing VA internal shu yerda hisoblanadi")
// LTF = joriy grafik

// ------------------------------------------------ SWING vs INTERNAL
gST   = "③ Struktura (Swing / Internal)"
sw_big   = input.int(5, "SWING fraktal", minval = 3, maxval = 12, group = gST,
     tooltip = "Katta struktura. Kattaroq = kamroq lekin muhimroq swing")
sw_small = input.int(2, "INTERNAL fraktal", minval = 1, maxval = 4, group = gST,
     tooltip = "Ichki struktura. Kichikroq = tezroq reaksiya")
use_close_bos = input.bool(true, "BOS yopilish bilan tasdiqlansin", group = gST)

// ------------------------------------------------------- SIGNAL SOURCE
gSG = "④ Signal manbalari (ko'proq savdo uchun)"
sig_sweep_ltf = input.bool(true,  "LTF likvidlik sweep",     group = gSG)
sig_sweep_mtf = input.bool(true,  "MTF likvidlik sweep",     group = gSG)
sig_poi_tap   = input.bool(true,  "POI (OB/FVG) mitigatsiya", group = gSG)
sig_choch     = input.bool(false, "LTF CHoCH (agressiv)",    group = gSG)
cooldown_bars = input.int(5, "Signallar orasi min bar", minval = 0, group = gSG)

// -------------------------------------------------------- PHASE FILTER
gEN   = "⑤ Faza filtri"
usePhaseA = input.bool(true,  "A — Pro Swing + Pro Internal",     group = gEN)
usePhaseB = input.bool(true,  "B — Pro Swing + Counter Internal", group = gEN)
usePhaseC = input.bool(false, "C — Counter Swing + Pro Internal", group = gEN)
usePhaseD = input.bool(false, "D — AVOID",                        group = gEN)
needPD    = input.bool(false, "Faqat discount(L)/premium(S)",     group = gEN)

// --------------------------------------------------------------- RISK
gRK   = "⑥ Risk"
risk_pct   = input.float(0.5, "Risk %", minval = 0.1, step = 0.1, group = gRK)
rr_target  = input.float(3.0, "TP (R)", minval = 1.0, step = 0.5, group = gRK)
slMode     = input.string("Swing", "SL joyi", options = ["Swing", "ATR", "Signal shami"], group = gRK)
slBufATR   = input.float(0.3, "SL bufer (ATR)", minval = 0.0, step = 0.1, group = gRK)
maxLossDay = input.int(3, "Kunlik maks zarar", minval = 1, maxval = 20, group = gRK)

// --------------------------------------------------------------- TIME
gTM   = "⑦ Vaqt"
useSess = input.bool(false, "Sessiya filtri", group = gTM,
     tooltip = "Boshida O'CHIQ — ko'proq savdo uchun")
sessStr = input.session("0700-1000,1200-1600", "Sessiyalar", group = gTM)

// --------------------------------------------------------------- VIEW
gUI   = "⑧ Ko'rinish"
show_dash   = input.bool(true, "Dashboard", group = gUI)
show_levels = input.bool(true, "Entry / SL / TP chiziqlari", group = gUI)
show_zones  = input.bool(true, "OB / FVG zonalar", group = gUI)
max_zones   = input.int(6, "Maks zona (ekranni tozalash)", minval = 2, maxval = 20, group = gUI)
zone_len    = input.int(30, "Zona uzunligi (bar)", minval = 5, maxval = 200, group = gUI)
show_debug  = input.bool(true, "DEBUG panel (nega savdo yo'q?)", group = gUI)
show_struct = input.bool(true, "Swing / Internal belgilar", group = gUI)
dash_pos    = input.string("top_right", "Dashboard joyi",
     options = ["top_right","top_left","bottom_right","bottom_left"], group = gUI)

// -------------------------------------------------------------- TYPES
type Zone
    box    b
    float  top
    float  bot
    bool   bull
    bool   tapped
    int    bar

type St
    float  sh = na
    float  sl = na
    string bias = "RANGE"
    string ev = ""
    int    evBar = na

// ------------------------------------------------------------ HELPERS
f_htf(simple string tf, series float src) =>
    request.security(syminfo.tickerid, tf, src[1], lookahead = barmerge.lookahead_off)

f_upd(St s, float ph, float pl, float pxu, float pxd) =>
    string e = ""
    if not na(ph)
        s.sh := ph
    if not na(pl)
        s.sl := pl
    if not na(s.sh) and pxu > s.sh
        e := s.bias == "BEAR" ? "CHoCH↑" : "BOS↑"
        s.bias := "BULL"
        s.ev := e
        s.evBar := bar_index
        s.sh := na
    if not na(s.sl) and pxd < s.sl
        e := s.bias == "BULL" ? "CHoCH↓" : "BOS↓"
        s.bias := "BEAR"
        s.ev := e
        s.evBar := bar_index
        s.sl := na
    e

// --------------------------------------------------------------- DATA
htf_h = f_htf(htf_s, high)
htf_l = f_htf(htf_s, low)
htf_c = f_htf(htf_s, close)
mtf_h = f_htf(mtf_s, high)
mtf_l = f_htf(mtf_s, low)
mtf_c = f_htf(mtf_s, close)
atr   = ta.atr(14)

// ============================================================
//  STRUKTURA — SWING va INTERNAL ALOHIDA
// ============================================================
// HTF swing (narrativ)
var St htfSwing = St.new()
ev_htf = f_upd(htfSwing,
     ta.pivothigh(htf_h, sw_big, sw_big), ta.pivotlow(htf_l, sw_big, sw_big),
     use_close_bos ? htf_c : htf_h, use_close_bos ? htf_c : htf_l)

// MTF SWING (katta fraktal) — Photon "Swing structure"
var St mtfSwing = St.new()
ph_mS = ta.pivothigh(mtf_h, sw_big, sw_big)
pl_mS = ta.pivotlow(mtf_l,  sw_big, sw_big)
ev_mS = f_upd(mtfSwing, ph_mS, pl_mS,
     use_close_bos ? mtf_c : mtf_h, use_close_bos ? mtf_c : mtf_l)

// MTF INTERNAL (kichik fraktal) — Photon "Internal structure"
var St mtfInt = St.new()
ph_mI = ta.pivothigh(mtf_h, sw_small, sw_small)
pl_mI = ta.pivotlow(mtf_l,  sw_small, sw_small)
ev_mI = f_upd(mtfInt, ph_mI, pl_mI,
     use_close_bos ? mtf_c : mtf_h, use_close_bos ? mtf_c : mtf_l)

// LTF (joriy grafik) — ijro
var St ltfInt = St.new()
ph_L = ta.pivothigh(high, sw_small, sw_small)
pl_L = ta.pivotlow(low,   sw_small, sw_small)
ev_L = f_upd(ltfInt, ph_L, pl_L,
     use_close_bos ? close : high, use_close_bos ? close : low)

// LTF swing (SL uchun)
var float ltfSwHi = na
var float ltfSwLo = na
ltfSwHi := nz(ta.pivothigh(high, sw_big, sw_big), ltfSwHi)
ltfSwLo := nz(ta.pivotlow(low,  sw_big, sw_big),  ltfSwLo)

// ============================================================
//  PHOTON FAZASI — to'g'ri ta'rif
//    Pro Swing    = MTF swing bias == HTF bias
//    Pro Internal = MTF internal bias == MTF swing bias
// ============================================================
proSwing    = htfSwing.bias != "RANGE" and mtfSwing.bias != "RANGE" and
     mtfSwing.bias == htfSwing.bias
proInternal = mtfSwing.bias != "RANGE" and mtfInt.bias != "RANGE" and
     mtfInt.bias == mtfSwing.bias

phase = (htfSwing.bias == "RANGE" or mtfSwing.bias == "RANGE") ? "RANGE" :
     proSwing and proInternal      ? "A" :
     proSwing and not proInternal  ? "B" :
     not proSwing and proInternal  ? "C" : "D"

phaseDesc = phase == "A" ? "Pro Swing + Pro Internal" :
     phase == "B" ? "Pro Swing + Counter Internal" :
     phase == "C" ? "Counter Swing + Pro Internal" :
     phase == "D" ? "AVOID" : "Range"

phaseOK = (phase == "A" and usePhaseA) or (phase == "B" and usePhaseB) or
     (phase == "C" and usePhaseC) or (phase == "D" and usePhaseD)

// Savdo yo'nalishi: MTF swing bias bo'yicha (Photon: HTF objective)
dirBull = mtfSwing.bias == "BULL"
dirBear = mtfSwing.bias == "BEAR"

// ============================================================
//  ZONES — OB / FVG
// ============================================================
var array<Zone> zAll = array.new<Zone>()

f_pushZone(float t, float b, bool bull, string kind, color bg, color br) =>
    if array.size(zAll) >= max_zones
        old = array.shift(zAll)
        box.delete(old.b)
    bx = show_zones ? box.new(bar_index, t, bar_index + zone_len, b, bgcolor = bg,
         border_color = br, border_width = 1,
         text = kind, text_size = size.tiny, text_color = color.new(color.white, 50),
         text_halign = text.align_left) : na
    array.push(zAll, Zone.new(bx, t, b, bull, false, bar_index))

if barstate.isconfirmed
    if low > high[2] and (low - high[2]) > atr * 0.08
        f_pushZone(low, high[2], true, "FVG", color.new(color.teal, 90), color.new(color.teal, 60))
    if low[2] > high and (low[2] - high) > atr * 0.08
        f_pushZone(low[2], high, false, "FVG", color.new(color.maroon, 90), color.new(color.maroon, 60))

f_findOB(bool bullEv) =>
    float t = na
    float b = na
    for i = 1 to 10
        if bullEv ? (close[i] < open[i]) : (close[i] > open[i])
            t := high[i]
            b := low[i]
            break
    [t, b]

if ev_L != "" and barstate.isconfirmed
    bool bullEv = str.contains(ev_L, "↑")
    [t, b] = f_findOB(bullEv)
    if not na(t)
        f_pushZone(t, b, bullEv, "OB",
             bullEv ? color.new(color.green, 87) : color.new(color.red, 87),
             bullEv ? color.new(color.green, 50) : color.new(color.red, 50))

// mitigatsiya
var bool zoneTappedBull = false
var bool zoneTappedBear = false
zoneTappedBull := false
zoneTappedBear := false
if array.size(zAll) > 0
    for i = 0 to array.size(zAll) - 1
        z = array.get(zAll, i)
        if not z.tapped and (bar_index - z.bar) >= 2 and low <= z.top and high >= z.bot
            z.tapped := true
            if z.bull
                zoneTappedBull := true
            else
                zoneTappedBear := true
            if not na(z.b)
                box.set_right(z.b, bar_index)
                box.set_bgcolor(z.b, color.new(color.gray, 92))
                box.set_border_color(z.b, color.new(color.gray, 70))

// ============================================================
//  P&D
// ============================================================
var float mSH = na
var float mSL = na
mSH := nz(ph_mS, mSH)
mSL := nz(pl_mS, mSL)
pdPos = (not na(mSH) and not na(mSL) and mSH > mSL) ? (close - mSL) / (mSH - mSL) : na
pdZone = na(pdPos) ? "—" : pdPos > 0.79 ? "EXT PREM" : pdPos > 0.5 ? "PREMIUM" :
     pdPos < 0.21 ? "EXT DISC" : "DISCOUNT"
inDisc = not na(pdPos) and pdPos < 0.5
inPrem = not na(pdPos) and pdPos > 0.5

// ============================================================
//  SIGNALLAR (ko'p manba)
// ============================================================
var float lastPH = na
var float lastPL = na
lastPH := nz(ph_L, lastPH)
lastPL := nz(pl_L, lastPL)

// LTF sweep
swLtfUp   = sig_sweep_ltf and not na(lastPH) and high > lastPH and close < lastPH
swLtfDn   = sig_sweep_ltf and not na(lastPL) and low  < lastPL and close > lastPL
// MTF sweep
var float mLastPH = na
var float mLastPL = na
mLastPH := nz(ph_mI, mLastPH)
mLastPL := nz(pl_mI, mLastPL)
swMtfUp   = sig_sweep_mtf and not na(mLastPH) and high > mLastPH and close < mLastPH
swMtfDn   = sig_sweep_mtf and not na(mLastPL) and low  < mLastPL and close > mLastPL
// POI tap
poiUp     = sig_poi_tap and zoneTappedBear
poiDn     = sig_poi_tap and zoneTappedBull
// LTF CHoCH
chUp      = sig_choch and str.contains(ev_L, "CHoCH↓")
chDn      = sig_choch and str.contains(ev_L, "CHoCH↑")

rawLong  = swLtfDn or swMtfDn or poiDn or chDn
rawShort = swLtfUp or swMtfUp or poiUp or chUp

sigName = swLtfDn or swLtfUp ? "SWEEP-LTF" : swMtfDn or swMtfUp ? "SWEEP-MTF" :
     poiDn or poiUp ? "POI-TAP" : "CHoCH"

// cooldown
var int lastSigBar = na
cooldownOK = na(lastSigBar) or (bar_index - lastSigBar) >= cooldown_bars

// ============================================================
//  GUARDS
// ============================================================
inSess = not useSess or not na(time(timeframe.period, sessStr))

var int lossToday = 0
var int lastDay = na
if dayofmonth != lastDay
    lossToday := 0
    lastDay := dayofmonth
if strategy.closedtrades > nz(strategy.closedtrades[1])
    if strategy.closedtrades.profit(strategy.closedtrades - 1) < 0
        lossToday += 1
guardOK = lossToday < maxLossDay

canTrade = tradingOn and phaseOK and inSess and guardOK and cooldownOK and
     strategy.position_size == 0 and barstate.isconfirmed

// --- DEBUG hisoblagichlari: nega savdo yo'q? ---
var int nRawSig   = 0
var int nPhaseOK  = 0
var int nDirOK    = 0
var int nAllOK    = 0
var int nPhA = 0
var int nPhB = 0
var int nPhC = 0
var int nPhD = 0
var int nPhR = 0

if barstate.isconfirmed
    if phase == "A"
        nPhA += 1
    if phase == "B"
        nPhB += 1
    if phase == "C"
        nPhC += 1
    if phase == "D"
        nPhD += 1
    if phase == "RANGE"
        nPhR += 1
    if rawLong or rawShort
        nRawSig += 1
        if phaseOK
            nPhaseOK += 1
            if (rawLong and dirBull) or (rawShort and dirBear)
                nDirOK += 1
                if inSess and guardOK and cooldownOK
                    nAllOK += 1

longCond  = canTrade and rawLong  and dirBull and (not needPD or inDisc)
shortCond = canTrade and rawShort and dirBear and (not needPD or inPrem)

// ============================================================
//  FAZA BO'YICHA HISOBLAGICH
// ============================================================
var int cntA = 0
var int cntB = 0
var int cntC = 0
var int cntD = 0
var int winA = 0
var int winB = 0
var int winC = 0
var int winD = 0
var float pnlA = 0.0
var float pnlB = 0.0
var float pnlC = 0.0
var float pnlD = 0.0

// natijani ro'yxatga yozish
// strategy.closedtrades.entry_comment() dan fazani o'qiymiz — ishonchliroq
if strategy.closedtrades > nz(strategy.closedtrades[1])
    idx = strategy.closedtrades - 1
    p = strategy.closedtrades.profit(idx)
    cmt = strategy.closedtrades.entry_comment(idx)
    ph = str.contains(cmt, "A·") ? "A" : str.contains(cmt, "B·") ? "B" :
         str.contains(cmt, "C·") ? "C" : str.contains(cmt, "D·") ? "D" : "?"
    if ph == "A"
        cntA += 1
        pnlA += p
        if p > 0
            winA += 1
    if ph == "B"
        cntB += 1
        pnlB += p
        if p > 0
            winB += 1
    if ph == "C"
        cntC += 1
        pnlC += p
        if p > 0
            winC += 1
    if ph == "D"
        cntD += 1
        pnlD += p
        if p > 0
            winD += 1

// ============================================================
//  ENTRY
// ============================================================
var float curEntry = na
var float curSL = na
var float curTP = na
var string curDir = ""

f_slLong() =>
    slMode == "Swing" and not na(ltfSwLo) ? math.min(ltfSwLo, low) - atr * slBufATR :
     slMode == "ATR" ? close - atr * (1.0 + slBufATR) : low - atr * slBufATR

f_slShort() =>
    slMode == "Swing" and not na(ltfSwHi) ? math.max(ltfSwHi, high) + atr * slBufATR :
     slMode == "ATR" ? close + atr * (1.0 + slBufATR) : high + atr * slBufATR

if longCond
    sl = f_slLong()
    risk = close - sl
    if risk > 0 and risk < atr * 8
        tp = close + risk * rr_target
        qty = (strategy.equity * risk_pct / 100) / risk
        strategy.entry("L", strategy.long, qty = qty, comment = phase + "·" + sigName)
        strategy.exit("Lx", "L", stop = sl, limit = tp)
        curEntry := close
        curSL := sl
        curTP := tp
        curDir := "LONG"
        lastSigBar := bar_index

if shortCond
    sl = f_slShort()
    risk = sl - close
    if risk > 0 and risk < atr * 8
        tp = close - risk * rr_target
        qty = (strategy.equity * risk_pct / 100) / risk
        strategy.entry("S", strategy.short, qty = qty, comment = phase + "·" + sigName)
        strategy.exit("Sx", "S", stop = sl, limit = tp)
        curEntry := close
        curSL := sl
        curTP := tp
        curDir := "SHORT"
        lastSigBar := bar_index

// ============================================================
//  ENTRY / SL / TP CHIZIQLARI
// ============================================================
inPos = strategy.position_size != 0
plot(show_levels and inPos ? curEntry : na, "Entry", color.new(color.blue, 0), 2, plot.style_linebr)
plot(show_levels and inPos ? curSL    : na, "SL",    color.new(color.red, 0),  2, plot.style_linebr)
plot(show_levels and inPos ? curTP    : na, "TP",    color.new(color.green, 0),2, plot.style_linebr)

if show_levels and (longCond or shortCond)
    label.new(bar_index, curDir == "LONG" ? curSL : curTP,
         curDir + " " + phase + "\nE " + str.tostring(curEntry, format.mintick) +
         "\nSL " + str.tostring(curSL, format.mintick) +
         "\nTP " + str.tostring(curTP, format.mintick),
         style = curDir == "LONG" ? label.style_label_up : label.style_label_down,
         color = color.new(curDir == "LONG" ? color.green : color.red, 20),
         textcolor = color.white, size = size.tiny)

plotshape(longCond,  "LONG",  shape.triangleup,   location.belowbar, color.new(color.green,0), size = size.small)
plotshape(shortCond, "SHORT", shape.triangledown, location.abovebar, color.new(color.red,0),   size = size.small)

// struktura belgilari
plotchar(show_struct and not na(ph_L) ? ph_L : na, "iH", "▪", location.absolute, color.new(color.gray,40), size=size.tiny)
plotchar(show_struct and not na(pl_L) ? pl_L : na, "iL", "▪", location.absolute, color.new(color.gray,40), size=size.tiny)

// ============================================================
//  DASHBOARD
// ============================================================
var table dash = na
cB = color.new(color.green, 60)
cR = color.new(color.red, 60)
cN = color.new(color.gray, 60)
f_bc(string b) => b == "BULL" ? cB : b == "BEAR" ? cR : cN

f_row(table t, int r, string k, string v, color bg) =>
    table.cell(t, 0, r, k, text_color = color.new(color.white,15), text_size = size.small,
         bgcolor = color.new(color.black,25), text_halign = text.align_left)
    table.cell(t, 1, r, v, text_color = color.white, text_size = size.small,
         bgcolor = bg, text_halign = text.align_right)

f_wr(int w, int c) => c > 0 ? str.tostring(w) + "/" + str.tostring(c) + "  " +
     str.tostring(w * 100.0 / c, "#") + "%" : "—"

if show_dash and barstate.islast
    table.delete(dash)
    pos = dash_pos == "top_right" ? position.top_right : dash_pos == "top_left" ? position.top_left :
         dash_pos == "bottom_right" ? position.bottom_right : position.bottom_left
    dash := table.new(pos, 2, 15, border_width = 1, frame_color = color.new(color.gray,50), frame_width = 1)

    table.cell(dash, 0, 0, "PHOTON v2", text_color = color.white, text_size = size.normal,
         bgcolor = color.new(color.blue,35))
    table.cell(dash, 1, 0, syminfo.ticker + " " + timeframe.period, text_color = color.white,
         text_size = size.normal, bgcolor = color.new(color.blue,35))

    f_row(dash, 1, "HTF " + htf_s + " swing", htfSwing.bias + " " + htfSwing.ev, f_bc(htfSwing.bias))
    f_row(dash, 2, "MTF " + mtf_s + " SWING", mtfSwing.bias + " " + mtfSwing.ev, f_bc(mtfSwing.bias))
    f_row(dash, 3, "MTF " + mtf_s + " internal", mtfInt.bias + " " + mtfInt.ev, f_bc(mtfInt.bias))
    f_row(dash, 4, "LTF internal", ltfInt.bias + " " + ltfInt.ev, f_bc(ltfInt.bias))
    f_row(dash, 5, "Pro Swing / Internal", (proSwing ? "✓" : "✗") + "  /  " + (proInternal ? "✓" : "✗"),
         proSwing and proInternal ? cB : cN)
    f_row(dash, 6, "FAZA", phase + " — " + phaseDesc,
         phase == "A" ? cB : phase == "B" ? color.new(color.olive,60) : phase == "D" ? cR : cN)
    f_row(dash, 7, "P&D", pdZone + (na(pdPos) ? "" : "  " + str.tostring(pdPos*100, "#") + "%"),
         inDisc ? cB : inPrem ? cR : cN)

    table.cell(dash, 0, 8, "FAZA STATISTIKASI", text_color = color.white, text_size = size.small,
         bgcolor = color.new(color.blue,50))
    table.cell(dash, 1, 8, "win/jami  WR", text_color = color.white, text_size = size.small,
         bgcolor = color.new(color.blue,50))
    f_row(dash,  9, "A  (Pro+Pro)",     f_wr(winA, cntA), cntA > 0 ? (pnlA > 0 ? cB : cR) : cN)
    f_row(dash, 10, "B  (Pro+Counter)", f_wr(winB, cntB), cntB > 0 ? (pnlB > 0 ? cB : cR) : cN)
    f_row(dash, 11, "C  (Counter+Pro)", f_wr(winC, cntC), cntC > 0 ? (pnlC > 0 ? cB : cR) : cN)
    f_row(dash, 12, "D  (AVOID)",       f_wr(winD, cntD), cntD > 0 ? (pnlD > 0 ? cB : cR) : cN)
    f_row(dash, 13, "JAMI savdo", str.tostring(strategy.closedtrades) +
         (strategy.closedtrades < 50 ? "  (50 kerak!)" : "  ✓"),
         strategy.closedtrades >= 50 ? cB : color.new(color.orange,60))
    f_row(dash, 14, "Net / DD", str.tostring(strategy.netprofit, "#.#") + " / " +
         str.tostring(strategy.max_drawdown, "#.#"), strategy.netprofit > 0 ? cB : cR)

// ============================================================
//  DEBUG PANEL — nega savdo yo'q?
// ============================================================
var table dbg = na
if show_debug and barstate.islast
    table.delete(dbg)
    dbg := table.new(position.bottom_left, 2, 10, border_width = 1,
         frame_color = color.new(color.gray, 50), frame_width = 1)

    table.cell(dbg, 0, 0, "DEBUG — nega savdo yo'q?", text_color = color.white,
         text_size = size.small, bgcolor = color.new(color.orange, 40))
    table.cell(dbg, 1, 0, "soni", text_color = color.white,
         text_size = size.small, bgcolor = color.new(color.orange, 40))

    f_row(dbg, 1, "Xom signal (sweep/POI)", str.tostring(nRawSig),
         nRawSig > 100 ? cB : color.new(color.orange, 60))
    f_row(dbg, 2, "  + faza filtridan o'tdi", str.tostring(nPhaseOK),
         nPhaseOK > 50 ? cB : color.new(color.orange, 60))
    f_row(dbg, 3, "  + yo'nalish mos", str.tostring(nDirOK),
         nDirOK > 50 ? cB : color.new(color.orange, 60))
    f_row(dbg, 4, "  + sessiya/guard/cooldown", str.tostring(nAllOK),
         nAllOK >= 50 ? cB : cR)
    f_row(dbg, 5, "JAMI OCHILGAN SAVDO", str.tostring(strategy.closedtrades),
         strategy.closedtrades >= 50 ? cB : cR)

    table.cell(dbg, 0, 6, "Faza barlar soni", text_color = color.white,
         text_size = size.small, bgcolor = color.new(color.blue, 50))
    table.cell(dbg, 1, 6, "bar", text_color = color.white,
         text_size = size.small, bgcolor = color.new(color.blue, 50))
    tot = nPhA + nPhB + nPhC + nPhD + nPhR
    f_row(dbg, 7, "A / B", str.tostring(nPhA) + " / " + str.tostring(nPhB),
         (nPhA + nPhB) > 0 ? cB : cR)
    f_row(dbg, 8, "C / D", str.tostring(nPhC) + " / " + str.tostring(nPhD), cN)
    f_row(dbg, 9, "RANGE", str.tostring(nPhR) + (tot > 0 ?
         "  (" + str.tostring(nPhR * 100.0 / tot, "#") + "%)" : ""),
         nPhR * 2 > tot ? color.new(color.orange, 60) : cN)

// ------------------------------------------------------------ ALERTS
alertcondition(longCond,  "LONG",  "Photon v2 LONG")
alertcondition(shortCond, "SHORT", "Photon v2 SHORT")
