//@version=6
// =============================================================
//  PHOTON STRATEGY — backtest versiyasi
//  Maqsad: "ishlaydimi?" degan savolga RAQAM bilan javob.
//  Repaint YO'Q. Komissiya va slippage HISOBGA OLINGAN.
// =============================================================
strategy("Photon Strategy", overlay = true,
     initial_capital       = 10000,
     default_qty_type      = strategy.percent_of_equity,
     default_qty_value     = 100,
     commission_type       = strategy.commission.cash_per_order,
     commission_value      = 3.5,
     slippage              = 2,
     calc_on_every_tick    = false,
     process_orders_on_close = true,
     margin_long = 0, margin_short = 0)

// ------------------------------------------------------------- INPUTS
gTF   = "Taymfreymlar"
htf_s = input.timeframe("240", "HTF", group = gTF)
mtf_s = input.timeframe("60",  "MTF", group = gTF)

gST   = "Struktura"
sw_l  = input.int(2, "Swing chap", minval = 1, maxval = 5, group = gST)
sw_r  = input.int(2, "Swing o'ng", minval = 1, maxval = 5, group = gST)

gEN   = "Kirish filtri"
usePhaseA = input.bool(true,  "A faza (Pro+Pro)",        group = gEN)
usePhaseB = input.bool(true,  "B faza (Pro+Counter)",    group = gEN)
usePhaseC = input.bool(true,  "C faza (Counter+Pro)",    group = gEN)
usePhaseD = input.bool(false, "D faza (AVOID)",          group = gEN)
useLC1    = input.bool(true,  "LC-1 (sweep, zonasiz)",   group = gEN)
useLC2A   = input.bool(true,  "LC-2A (sweep zonada)",    group = gEN)
needDisc  = input.bool(false, "Faqat discount/premium",  group = gEN,
     tooltip = "Long faqat discount, short faqat premium zonada")

gRK   = "Risk"
risk_pct  = input.float(0.5, "Risk %", minval = 0.1, step = 0.1, group = gRK)
rr_target = input.float(3.0, "TP (R)", minval = 1.0, step = 0.5, group = gRK)
slBufATR  = input.float(0.2, "SL bufer (ATR)", minval = 0.0, step = 0.1, group = gRK)
maxLossDay= input.int(3, "Kunlik maks zarar", minval = 1, group = gRK)

gTM   = "Vaqt"
useSess = input.bool(true, "Sessiya filtri", group = gTM)
sessStr = input.session("0700-1000,1200-1600", "Sessiyalar", group = gTM)

// ------------------------------------------------------------- HELPERS
f_htf(simple string tf, series float src) =>
    request.security(syminfo.tickerid, tf, src[1], lookahead = barmerge.lookahead_off)

htf_h = f_htf(htf_s, high)
htf_l = f_htf(htf_s, low)
htf_c = f_htf(htf_s, close)
mtf_h = f_htf(mtf_s, high)
mtf_l = f_htf(mtf_s, low)
mtf_c = f_htf(mtf_s, close)
atr   = ta.atr(14)

// ------------------------------------------------------------- STRUCTURE
type St
    float sh = na
    float sl = na
    string bias = "RANGE"

var St sH = St.new()
var St sM = St.new()
var St sL = St.new()

f_upd(St s, float ph, float pl, float pxu, float pxd) =>
    if not na(ph)
        s.sh := ph
    if not na(pl)
        s.sl := pl
    if not na(s.sh) and pxu > s.sh
        s.bias := "BULL"
        s.sh := na
    if not na(s.sl) and pxd < s.sl
        s.bias := "BEAR"
        s.sl := na
    s.bias

bH = f_upd(sH, ta.pivothigh(htf_h, sw_l, sw_r), ta.pivotlow(htf_l, sw_l, sw_r), htf_c, htf_c)
bM = f_upd(sM, ta.pivothigh(mtf_h, sw_l, sw_r), ta.pivotlow(mtf_l, sw_l, sw_r), mtf_c, mtf_c)
bL = f_upd(sL, ta.pivothigh(high, sw_l, sw_r),  ta.pivotlow(low, sw_l, sw_r),   close, close)

// ------------------------------------------------------------- PHASE
f_phase(string h, string m, string l) =>
    if h == "RANGE" or m == "RANGE"
        "RANGE"
    else
        pS = h == m
        pI = m == l
        pS and pI ? "A" : pS and not pI ? "B" : not pS and pI ? "C" : "D"

phase = f_phase(bH, bM, bL)
phaseOK = (phase == "A" and usePhaseA) or (phase == "B" and usePhaseB) or
     (phase == "C" and usePhaseC) or (phase == "D" and usePhaseD)

// ------------------------------------------------------------- ZONES (FVG)
var array<float> fvgT = array.new<float>()
var array<float> fvgB = array.new<float>()
var array<bool>  fvgU = array.new<bool>()

if barstate.isconfirmed
    if low > high[2] and (low - high[2]) > atr * 0.1
        array.push(fvgT, low), array.push(fvgB, high[2]), array.push(fvgU, true)
    if low[2] > high and (low[2] - high) > atr * 0.1
        array.push(fvgT, low[2]), array.push(fvgB, high), array.push(fvgU, false)
    while array.size(fvgT) > 20
        array.shift(fvgT), array.shift(fvgB), array.shift(fvgU)

f_inZone(float px) =>
    bool r = false
    if array.size(fvgT) > 0
        for i = 0 to array.size(fvgT) - 1
            if px <= array.get(fvgT, i) and px >= array.get(fvgB, i)
                r := true
                break
    r

// ------------------------------------------------------------- P&D
f_pdPos(float hi, float lo, float px) =>
    (hi - lo) > 0 ? (px - lo) / (hi - lo) : na

var float mSH = na
var float mSL = na
mSH := nz(ta.pivothigh(mtf_h, sw_l, sw_r), mSH)
mSL := nz(ta.pivotlow(mtf_l, sw_l, sw_r), mSL)
pdPos = f_pdPos(mSH, mSL, close)
inDiscount = not na(pdPos) and pdPos < 0.5
inPremium  = not na(pdPos) and pdPos > 0.5

// ------------------------------------------------------------- SESSION
inSess = not useSess or not na(time(timeframe.period, sessStr))

// ------------------------------------------------------------- DAILY LOSS GUARD
var int lossToday = 0
var int lastDay = na
if dayofmonth != lastDay
    lossToday := 0
    lastDay := dayofmonth
if strategy.closedtrades > strategy.closedtrades[1]
    if strategy.closedtrades.profit(strategy.closedtrades - 1) < 0
        lossToday += 1
guardOK = lossToday < maxLossDay

// ------------------------------------------------------------- LC SIGNALS
ph1 = ta.pivothigh(high, sw_l, sw_r)
pl1 = ta.pivotlow(low, sw_l, sw_r)
var float lastPH = na
var float lastPL = na
lastPH := nz(ph1, lastPH)
lastPL := nz(pl1, lastPL)

sweepUp   = not na(lastPH) and high > lastPH and close < lastPH
sweepDown = not na(lastPL) and low  < lastPL and close > lastPL

lcTypeUp   = f_inZone(high) ? "LC-2A" : "LC-1"
lcTypeDown = f_inZone(low)  ? "LC-2A" : "LC-1"
lcOKUp     = (lcTypeUp == "LC-1" and useLC1) or (lcTypeUp == "LC-2A" and useLC2A)
lcOKDown   = (lcTypeDown == "LC-1" and useLC1) or (lcTypeDown == "LC-2A" and useLC2A)

// ------------------------------------------------------------- ENTRY
canTrade = phaseOK and inSess and guardOK and strategy.position_size == 0

longCond = canTrade and sweepDown and lcOKDown and bM == "BULL" and
     (not needDisc or inDiscount)
shortCond = canTrade and sweepUp and lcOKUp and bM == "BEAR" and
     (not needDisc or inPremium)

if longCond
    slPrice = low - atr * slBufATR
    risk = close - slPrice
    if risk > 0
        tpPrice = close + risk * rr_target
        qty = (strategy.equity * risk_pct / 100) / risk
        strategy.entry("L", strategy.long, qty = qty,
             comment = phase + "/" + lcTypeDown)
        strategy.exit("Lx", "L", stop = slPrice, limit = tpPrice)

if shortCond
    slPrice = high + atr * slBufATR
    risk = slPrice - close
    if risk > 0
        tpPrice = close - risk * rr_target
        qty = (strategy.equity * risk_pct / 100) / risk
        strategy.entry("S", strategy.short, qty = qty,
             comment = phase + "/" + lcTypeUp)
        strategy.exit("Sx", "S", stop = slPrice, limit = tpPrice)

// ------------------------------------------------------------- VISUAL
plotshape(longCond,  "LONG",  shape.triangleup,   location.belowbar,
     color.new(color.green, 0), size = size.tiny)
plotshape(shortCond, "SHORT", shape.triangledown, location.abovebar,
     color.new(color.red, 0),   size = size.tiny)

var label phLbl = na
if barstate.islast
    label.delete(phLbl)
    phLbl := label.new(bar_index + 5, close,
         "Faza: " + phase + "\nHTF " + bH + " | MTF " + bM + " | LTF " + bL +
         "\nP&D: " + (na(pdPos) ? "—" : str.tostring(pdPos * 100, "#") + "%"),
         style = label.style_label_left,
         color = color.new(color.black, 20), textcolor = color.white,
         size = size.small)
