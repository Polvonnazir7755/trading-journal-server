//@version=6
// ==============================================================
//  BETA 1 + LAOL — BACKTEST VERSIYASI
//
//  Asl indikatordan farqi:
//   1) REPAINT YO'Q — barcha HTF ma'lumot faqat YOPILGAN shamdan
//      (asl kod yopilmagan shamni o'qiydi -> tarixda mukammal,
//       jonli savdoda titraydi)
//   2) strategy() -> win rate, profit factor, drawdown chiqadi
//   3) 25 TF -> 9 TF (3 ENTRY + 3 SCALP + 3 INTRA), sozlanadi
//   4) Setup turi bo'yicha alohida statistika (S1/S2/S3/S4)
//   5) SL "500 bar ichida cheksiz kengayish" -> chegaralangan
//
//  Mantiq ASL KODDAN ko'chirilgan: FU, SN, X3, LAOL, HCS, TBE, S1-S4
// ==============================================================
strategy("BETA 1 + LAOL — Backtest", overlay = true,
     initial_capital         = 1000,
     default_qty_type        = strategy.percent_of_equity,
     default_qty_value       = 100,
     commission_type         = strategy.commission.cash_per_order,
     commission_value        = 3.5,
     slippage                = 2,
     calc_on_every_tick      = false,
     process_orders_on_close = true,
     max_boxes_count         = 500,
     max_lines_count         = 500,
     max_labels_count        = 500,
     margin_long = 0, margin_short = 0)

// ---------------------------------------------------------- ① REJIM
gMD  = "① Rejim"
mode = input.string("Backtest", "Rejim",
     options = ["Backtest", "Faqat indikator"], group = gMD)
tradingOn = mode == "Backtest"

// ---------------------------------------------------- ② TAYMFREYMLAR
gTF = "② Taymfreymlar"
e1 = input.timeframe("1",  "ENTRY 1", group = gTF)
e2 = input.timeframe("3",  "ENTRY 2", group = gTF)
e3 = input.timeframe("5",  "ENTRY 3", group = gTF)
s1 = input.timeframe("10", "SCALP 1", group = gTF)
s2 = input.timeframe("15", "SCALP 2", group = gTF)
s3 = input.timeframe("20", "SCALP 3", group = gTF)
i1 = input.timeframe("30", "INTRA 1", group = gTF)
i2 = input.timeframe("45", "INTRA 2", group = gTF)
i3 = input.timeframe("60", "INTRA 3", group = gTF)

// ------------------------------------------------------ ③ PATTERNLAR
gPT = "③ Patternlar"
useFU   = input.bool(true,  "FU  — fakeout",        group = gPT)
useSN   = input.bool(true,  "SN  — snap",           group = gPT)
useX3   = input.bool(true,  "X3  — First / Third",  group = gPT)
useLAOL = input.bool(true,  "LAOL — inside bar",    group = gPT)
useHCS  = input.bool(true,  "HCS — qayta test",     group = gPT)
useTBE  = input.bool(true,  "TBE — 5 bosqich",      group = gPT)

// --------------------------------------------------------- ④ SETUP
gSU = "④ Kirish darajasi"
entryLevel = input.string("FINAL (sifatli)", "Kirish darajasi",
     options = ["CONFIRMED (ko'p savdo)", "FINAL (sifatli)", "IKKALASI (solishtirish)"],
     group = gSU,
     tooltip = "CONFIRMED = S1-S4 baza yetarli (ko'p signal, o'rtacha sifat)\nFINAL = + LAOL buzilishi + SCALP retest + oyna (kam signal, yuqori sifat)\nIKKALASI = ikkalasi ham savdo ochadi, statistika alohida")
useCONF  = entryLevel == "CONFIRMED (ko'p savdo)" or entryLevel == "IKKALASI (solishtirish)"
useFINAL = entryLevel == "FINAL (sifatli)" or entryLevel == "IKKALASI (solishtirish)"
setupWindow = input.int(10, "FINAL: setup oynasi (bar)", minval = 1, maxval = 50, group = gSU,
     tooltip = "Baza shakllangandan keyin necha bar ichida FINAL shartlari bajarilishi kerak")
useS1 = input.bool(true, "S1 — scalp EM + entry retest",       group = gSU)
useS2 = input.bool(true, "S2 — S1 + scalp retest",             group = gSU)
useS3 = input.bool(true, "S3 — scalp forming + entry retest",  group = gSU)
useS4 = input.bool(true, "S4 — ENTRY-1 HCS",                   group = gSU)
needLAOLbreak = input.bool(true, "LAOL buzilishi shart",       group = gSU)
needScalpRet  = input.bool(true, "SCALP FU/SN retest shart",   group = gSU)
laolWindow    = input.int(10, "LAOL buzilishi amal qiladi (bar)", minval = 1, maxval = 50, group = gSU,
     tooltip = "LAOL buzilgandan keyin necha bar davomida signal kuchda qoladi")

// --- WIN RATE oshirish filtrlari ---
gWR = "⑤ Win rate filtrlari"
needMTFalign = input.bool(false, "HTF trend bilan bir yo'nalishda", group = gWR,
     tooltip = "INTRA (30m-1h) trendiga qarshi savdo qilmaydi.\nWR oshadi, savdo kamayadi.")
needPDzone   = input.bool(false, "Faqat discount(L) / premium(S)", group = gWR,
     tooltip = "Long faqat pastki yarmida, short faqat yuqori yarmida")
minSetupCnt  = input.int(1, "Min tasdiq soni (S+INTRA+LAOL)", minval = 1, maxval = 4, group = gWR,
     tooltip = "Nechta mustaqil tasdiq bo'lsa savdo ochiladi.\n2-3 = kamroq lekin sifatliroq")
avoidRange   = input.bool(false, "Range (yon harakat) da savdo qilmaslik", group = gWR,
     tooltip = "ATR past bo'lsa savdo qilmaydi")
rangeATRmult = input.float(0.7, "Range chegarasi (ATR nisbati)", minval = 0.3, step = 0.1, group = gWR)

// ----------------------------------------------------------- ⑤ RISK
gRK = "⑤ Risk"
riskMode  = input.string("Foiz %", "Risk turi", options = ["Foiz %", "Dollar $"], group = gRK)
risk_pct  = input.float(1.0, "Risk %", minval = 0.1, step = 0.1, group = gRK)
risk_usd  = input.float(20.0, "Risk $ (Dollar rejimida)", minval = 1.0, step = 5.0, group = gRK,
     tooltip = "$1000 hisobda: $10=1%, $20=2%, $50=5%\nOGOHLANTIRISH: 5% da 200 savdoda DD 73% ga chiqadi!")
tpMult    = input.float(3.0, "TP = SL × (RR)", minval = 0.5, step = 0.5, group = gRK,
     tooltip = "1:8 da TP ga yetish ehtimoli atigi 11% — WR shuning uchun past edi.\n1:2-1:4 tavsiya qilinadi.")

usePartial = input.bool(false, "Qismiy chiqish (partial)", group = gRK,
     tooltip = "Pozitsiyaning bir qismini yaqinroq TP da yopadi — WR oshadi")
p1Pct     = input.int(50, "1-qism hajmi %", minval = 10, maxval = 90, group = gRK)
p1RR      = input.float(1.5, "1-qism TP (RR)", minval = 0.5, step = 0.5, group = gRK)

useBE     = input.bool(false, "Breakeven ko'chirish", group = gRK,
     tooltip = "Narx belgilangan RR ga yetsa, SL ni kirish narxiga ko'chiradi")
beAtRR    = input.float(1.0, "BE ga ko'chirish (RR)", minval = 0.3, step = 0.1, group = gRK)
slMode    = input.string("Signal shami", "SL joyi",
     options = ["Signal shami", "Swing", "Kengaytirilgan"], group = gRK)
slBufATR  = input.float(0.2, "SL bufer (ATR)", minval = 0.0, step = 0.1, group = gRK)
slMaxATR  = input.float(5.0, "SL maks (ATR)",  minval = 1.0, step = 0.5, group = gRK,
     tooltip = "Asl kodda SL 500 bar ichida cheksiz kengayardi — bu chegara")
useDayGuard = input.bool(false, "Kunlik zarar limiti", group = gRK,
     tooltip = "Backtestda O'CHIQ tavsiya qilinadi — statistika to'plash uchun.\nJonli savdoda YOQING.")
maxLossDay= input.int(3, "Kunlik maks zarar", minval = 1, maxval = 50, group = gRK)
coolBars  = input.int(5, "Signallar orasi min bar", minval = 0, group = gRK)
allowPyramid = input.bool(false, "Pozitsiya ochiq bo'lsa ham kirish", group = gRK,
     tooltip = "Yoqilsa: bir vaqtda bir necha pozitsiya. Risk oshadi!")

// ----------------------------------------------------------- ⑥ VAQT
gTM = "⑥ Vaqt"
useSess = input.bool(false, "Sessiya filtri", group = gTM)
sessStr = input.session("0700-1000,1200-1600", "Sessiyalar", group = gTM)

// ------------------------------------------------------- ⑦ KO'RINISH
gUI = "⑦ Ko'rinish"
showDash  = input.bool(true, "Dashboard", group = gUI)
showDebug = input.bool(true, "DEBUG panel", group = gUI)
showBoxes = input.bool(true, "Pattern qutilari", group = gUI)
showLevels= input.bool(true, "Entry / SL / TP", group = gUI)
maxBoxes  = input.int(8, "Maks quti", minval = 2, maxval = 30, group = gUI)
boxLen    = input.int(30, "Quti uzunligi (bar)", minval = 5, group = gUI)

// ============================================================ TYPES
type TFD
    float o  = na
    float h  = na
    float l  = na
    float c  = na
    float o1 = na
    float h1 = na
    float l1 = na
    float c1 = na
    float o2 = na
    float h2 = na
    float l2 = na
    float c2 = na
    int   t  = na
    bool  isNew = false

type Pat
    bool fuB = false
    bool fuS = false
    bool snB = false
    bool snS = false
    bool x3B = false
    bool x3S = false
    bool ibB = false
    bool ibS = false

type PBox
    box    obj  = na
    int    tfi  = 0
    string cat  = ""
    string dir  = ""
    string ptxt = ""
    float  top  = na
    float  bot  = na
    float  otop = na
    float  obot = na
    int    bar  = na
    string state = "EST"
    bool   retested = false
    int    hcs  = 0
    bool   isEM = false

type Laol
    float  lvl = na
    string cat = ""
    int    bar = na
    bool   bear = false
    bool   broken = false
    int    bbar = na

// =========================================================== HELPERS
// FAQAT YOPILGAN sham — [1], [2], [3] indekslari
f_tf(simple string tf) =>
    [ro, rh, rl, rc, ro1, rh1, rl1, rc1, ro2, rh2, rl2, rc2, rt] =
         request.security(syminfo.tickerid, tf,
             [open[1], high[1], low[1], close[1],
              open[2], high[2], low[2], close[2],
              open[3], high[3], low[3], close[3], time[1]],
             lookahead = barmerge.lookahead_off)
    TFD.new(o = ro, h = rh, l = rl, c = rc, o1 = ro1, h1 = rh1, l1 = rl1, c1 = rc1, o2 = ro2, h2 = rh2, l2 = rl2, c2 = rc2, t = rt, isNew = false)

d1 = f_tf(e1)
d2 = f_tf(e2)
d3 = f_tf(e3)
d4 = f_tf(s1)
d5 = f_tf(s2)
d6 = f_tf(s3)
d7 = f_tf(i1)
d8 = f_tf(i2)
d9 = f_tf(i3)

atr = ta.atr(14)

f_get(int i) =>
    switch i
        0 => d1
        1 => d2
        2 => d3
        3 => d4
        4 => d5
        5 => d6
        6 => d7
        7 => d8
        => d9

f_cat(int i) => i < 3 ? "ENTRY" : i < 6 ? "SCALP" : "INTRA"

f_tfs(int i) =>
    switch i
        0 => e1
        1 => e2
        2 => e3
        3 => s1
        4 => s2
        5 => s3
        6 => i1
        7 => i2
        => i3

// yangi HTF sham yopildimi?
var array<int> lastT = array.new<int>(9, 0)

// ================================================ PATTERN DETECTION
f_bothWicks(float o, float h, float l, float c) =>
    math.max(o, c) < h and math.min(o, c) > l

f_pat(TFD d) =>
    p = Pat.new()
    ok  = not na(d.h) and not na(d.l) and not na(d.c) and not na(d.o)
    ok1 = not na(d.h1) and not na(d.l1) and not na(d.c1) and not na(d.o1)
    ok2 = not na(d.h2) and not na(d.l2) and not na(d.c2) and not na(d.o2)
    if ok and ok1
        bw  = f_bothWicks(d.o, d.h, d.l, d.c)
        bw1 = ok2 ? f_bothWicks(d.o1, d.h1, d.l1, d.c1) : false

        // --- X3: oldingi diapazonni to'liq qamrab, ikki soyali ---
        x3b = d.h > d.h1 and d.l < d.l1 and bw and d.c < d.o
        x3s = d.h > d.h1 and d.l < d.l1 and bw and d.c > d.o
        isX3 = x3b or x3s

        // --- SN (snap): ikkala tomonni olib, tana ichkarida ---
        snS_ = d.h > d.h1 and d.l < d.l1 and math.max(d.o, d.c) < d.h1 and
             math.min(d.o, d.c) > d.l1 and d.o < d.c
        snB_ = d.h > d.h1 and d.l < d.l1 and math.min(d.o, d.c) > d.l1 and
             math.max(d.o, d.c) < d.h1 and d.o > d.c
        snTog = (snS_ or snB_) and not isX3

        // --- FU (fakeout): chiqib, ichkariga yopilish ---
        fub = d.h > d.h1 and d.c < d.h1 and d.c > d.l1 and not isX3 and not snTog
        fus = d.l < d.l1 and d.c > d.l1 and d.c < d.h1 and not isX3 and not snTog

        // --- LAOL: inside bar ---
        ib = d.h < d.h1 and d.l > d.l1

        // --- X3 First (oldingi sham x3/sn, joriy teskari siljish) ---
        x3b1 = ok2 and d.h1 > d.h2 and d.l1 < d.l2 and bw1 and d.c1 < d.o1
        x3s1 = ok2 and d.h1 > d.h2 and d.l1 < d.l2 and bw1 and d.c1 > d.o1
        firstB = (x3s1) and d.h > d.h1 and d.l > d.l1
        firstS = (x3b1) and d.l < d.l1 and d.h < d.h1

        p.fuB := useFU and fub
        p.fuS := useFU and fus
        p.snB := useSN and snB_
        p.snS := useSN and snS_
        p.x3B := useX3 and (x3b or firstB)
        p.x3S := useX3 and (x3s or firstS)
        p.ibB := useLAOL and ib
        p.ibS := useLAOL and ib
    p

// ======================================================= TBE (5 step)
var array<int>   seqStepB = array.new<int>(9, 0)
var array<float> seqLvlB  = array.new<float>(9, na)
var array<float> seqBodB  = array.new<float>(9, na)
var array<int>   seqCntB  = array.new<int>(9, 0)
var array<int>   seqStepS = array.new<int>(9, 0)
var array<float> seqLvlS  = array.new<float>(9, na)
var array<float> seqBodS  = array.new<float>(9, na)
var array<int>   seqCntS  = array.new<int>(9, 0)

f_seq(int i, bool bear, bool isFU, bool isX3, bool cFU, bool cX3,
      float lvl, float bod, float ph, float pl) =>
    step = bear ? array.get(seqStepB, i) : array.get(seqStepS, i)
    L    = bear ? array.get(seqLvlB, i)  : array.get(seqLvlS, i)
    B    = bear ? array.get(seqBodB, i)  : array.get(seqBodS, i)
    cnt  = bear ? array.get(seqCntB, i)  : array.get(seqCntS, i)
    bool valid = false

    if step > 0
        cnt += 1
    if step > 0 and step < 5 and cnt > 5
        step := 0
        L := na
        B := na
        cnt := 0

    broke = not na(L) and (bear ? ph > L : pl < L)

    if step == 5
        step := 0
        L := na
        B := na
        cnt := 0
    else if step == 4
        if broke
            step := 0
            L := na
            cnt := 0
        else if isFU
            step := 5
            valid := true
    else if step == 3
        inZ = not na(L) and not na(B) and (bear ? (ph > B and ph < L) : (pl < B and pl > L))
        if broke
            step := 0
            L := na
            cnt := 0
        else if inZ
            step := 4
    else if step == 2
        if broke
            step := 0
            L := na
            cnt := 0
        else if cFU or cX3
            step := 3
    else if step == 1
        inZ = not na(L) and not na(B) and (bear ? (ph >= B and ph <= L) : (pl <= B and pl >= L))
        if broke
            step := 0
            L := na
            cnt := 0
        else if inZ
            step := 2
        else
            step := 0
            L := na
            cnt := 0

    if (isFU or isX3) and step == 0
        step := 1
        L := lvl
        B := bod
        cnt := 0

    if bear
        array.set(seqStepB, i, step)
        array.set(seqLvlB, i, L)
        array.set(seqBodB, i, B)
        array.set(seqCntB, i, cnt)
    else
        array.set(seqStepS, i, step)
        array.set(seqLvlS, i, L)
        array.set(seqBodS, i, B)
        array.set(seqCntS, i, cnt)
    valid

// =========================================================== BOXES
var array<PBox> boxes = array.new<PBox>()
var array<Laol> laols = array.new<Laol>()

f_addBox(int tfi, string cat, string dir, float top, float bot,
         string ptxt, bool isEM) =>
    if array.size(boxes) >= maxBoxes * 3
        old = array.shift(boxes)
        if not na(old.obj)
            box.delete(old.obj)
    col = cat == "ENTRY" ? color.blue : cat == "SCALP" ? color.green : color.red
    bx = showBoxes and isEM ? box.new(bar_index, top, bar_index + boxLen, bot,
         bgcolor = color.new(col, 92), border_color = color.new(col, 60),
         border_width = 1, border_style = line.style_dashed,
         text = ptxt, text_size = size.tiny,
         text_color = color.new(color.white, 40),
         text_halign = text.align_left) : na
    array.push(boxes, PBox.new(obj = bx, tfi = tfi, cat = cat, dir = dir,
         ptxt = ptxt, top = top, bot = bot, otop = top, obot = bot,
         bar = bar_index, state = "EST", retested = false, hcs = 0, isEM = isEM))

f_addLaol(float lvl, string cat, bool bear) =>
    tol = syminfo.mintick * 3
    bool merged = false
    if array.size(laols) > 0
        for j = 0 to array.size(laols) - 1
            lo = array.get(laols, j)
            if not lo.broken and math.abs(lo.lvl - lvl) < tol and lo.bear == bear
                merged := true
                break
    if not merged
        if array.size(laols) >= 30
            array.shift(laols)
        array.push(laols, Laol.new(lvl = lvl, cat = cat, bar = bar_index,
             bear = bear, broken = false, bbar = na))

// ================================================= ASOSIY TF SIKLI
int cntEntryEM_B = 0
int cntEntryEM_S = 0
int cntScalpEM_B = 0
int cntScalpEM_S = 0
int cntIntraEM_B = 0
int cntIntraEM_S = 0
int cntEntryRet_B = 0
int cntEntryRet_S = 0
int cntScalpRet_B = 0
int cntScalpRet_S = 0
bool hcsM1_B = false
bool hcsM1_S = false
bool scalpFuRet_B = false
bool scalpFuRet_S = false

for i = 0 to 8
    d = f_get(i)
    if na(d.h) or na(d.l)
        continue
    isNew = d.t != array.get(lastT, i)
    if isNew
        array.set(lastT, i, d.t)
    cat = f_cat(i)
    p = f_pat(d)

    bodTop = math.max(d.o, d.c)
    bodBot = math.min(d.o, d.c)

    // --- TBE ---
    tbeB = useTBE and isNew ? f_seq(i, true,  p.fuB, p.x3B, p.fuS, p.x3S, d.h, bodTop, d.h, d.l) : false
    tbeS = useTBE and isNew ? f_seq(i, false, p.fuS, p.x3S, p.fuB, p.x3B, d.l, bodBot, d.h, d.l) : false

    // --- EM (kuchli) pattern bormi? ---
    emB = p.x3B or tbeB
    emS = p.x3S or tbeS
    fuSnB = p.fuB or p.snB
    fuSnS = p.fuS or p.snS

    // --- HCS: mavjud FU/SN qutiga qayta tegish ---
    bool hB = false
    bool hS = false
    if useHCS and array.size(boxes) > 0 and isNew
        for j = 0 to array.size(boxes) - 1
            bx = array.get(boxes, j)
            if bx.tfi != i or bx.bar == bar_index
                continue
            if not (str.contains(bx.ptxt, "FU") or str.contains(bx.ptxt, "SN"))
                continue
            if bx.dir == "bear" and fuSnB and d.h >= bx.bot and d.h <= bx.otop
                bx.hcs += 1
                hB := true
                if i == 0
                    hcsM1_B := true
            if bx.dir == "bull" and fuSnS and d.l <= bx.top and d.l >= bx.obot
                bx.hcs += 1
                hS := true
                if i == 0
                    hcsM1_S := true

    // --- pattern matni ---
    string ptB = ""
    if p.x3B
        ptB := "X3"
    if tbeB
        ptB := ptB == "" ? "TBE" : ptB + "+TBE"
    if p.snB
        ptB := ptB == "" ? "SN" : ptB + "+SN"
    if p.fuB
        ptB := ptB == "" ? "FU" : ptB + "+FU"
    if hB
        ptB := ptB == "" ? "HCS" : ptB + "+HCS"

    string ptS = ""
    if p.x3S
        ptS := "X3"
    if tbeS
        ptS := ptS == "" ? "TBE" : ptS + "+TBE"
    if p.snS
        ptS := ptS == "" ? "SN" : ptS + "+SN"
    if p.fuS
        ptS := ptS == "" ? "FU" : ptS + "+FU"
    if hS
        ptS := ptS == "" ? "HCS" : ptS + "+HCS"

    isEMb = emB or hB
    isEMs = emS or hS

    // --- quti yaratish ---
    if isNew and ptB != ""
        f_addBox(i, cat, "bear", d.h, bodTop, "[" + f_tfs(i) + "] " + ptB, isEMb)
    if isNew and ptS != ""
        f_addBox(i, cat, "bull", bodBot, d.l, "[" + f_tfs(i) + "] " + ptS, isEMs)

    // --- LAOL (inside bar darajasi) ---
    if isNew and p.ibB
        f_addLaol(d.h, cat, true)
    if isNew and p.ibS
        f_addLaol(d.l, cat, false)

    // --- hisoblagichlar ---
    if isEMb
        if cat == "ENTRY"
            cntEntryEM_B += 1
        else if cat == "SCALP"
            cntScalpEM_B += 1
        else
            cntIntraEM_B += 1
    if isEMs
        if cat == "ENTRY"
            cntEntryEM_S += 1
        else if cat == "SCALP"
            cntScalpEM_S += 1
        else
            cntIntraEM_S += 1

// ================================================ QUTI RETEST / MITIG
if array.size(boxes) > 0
    for j = array.size(boxes) - 1 to 0
        if j >= array.size(boxes)
            continue
        bx = array.get(boxes, j)
        // buzilgan quti -> o'chirish
        killed = bx.dir == "bear" ? (high > bx.otop) : (low < bx.obot)
        if killed
            if not na(bx.obj)
                box.delete(bx.obj)
            array.remove(boxes, j)
            continue
        touch = bx.dir == "bear" ? (high >= bx.bot and high <= bx.otop)
             : (low <= bx.top and low >= bx.obot)
        if touch and (bar_index - bx.bar) >= 1
            if not bx.retested
                bx.retested := true
                if not na(bx.obj)
                    box.set_border_style(bx.obj, line.style_solid)
                    box.set_border_width(bx.obj, 2)
                    box.set_right(bx.obj, bar_index)
            if bx.cat == "ENTRY"
                if bx.dir == "bear"
                    cntEntryRet_B += 1
                else
                    cntEntryRet_S += 1
            if bx.cat == "SCALP"
                if bx.dir == "bear"
                    cntScalpRet_B += 1
                else
                    cntScalpRet_S += 1
                if str.contains(bx.ptxt, "FU") or str.contains(bx.ptxt, "SN")
                    if bx.dir == "bear"
                        scalpFuRet_B := true
                    else
                        scalpFuRet_S := true

// ============================================== LAOL BUZILISHI
bool laolBrokeB = false
bool laolBrokeS = false
if array.size(laols) > 0
    for j = array.size(laols) - 1 to 0
        if j >= array.size(laols)
            continue
        lo = array.get(laols, j)
        if not lo.broken
            cross = lo.bear ? (high > lo.lvl) : (low < lo.lvl)
            if cross
                lo.broken := true
                lo.bbar := bar_index
        // OXIRGI laolWindow bar ichida buzilgan bo'lsa ham hisoblanadi
        if lo.broken and (bar_index - lo.bbar) <= laolWindow
            if lo.bear
                laolBrokeB := true
            else
                laolBrokeS := true
        if lo.broken and (bar_index - lo.bbar) > laolWindow + 3
            array.remove(laols, j)

// ============================================ WIN RATE FILTRLARI
// HTF trend: INTRA (i3) yo'nalishi
htfBull = not na(d9.c) and not na(d9.c1) and d9.c > d9.c1
htfBear = not na(d9.c) and not na(d9.c1) and d9.c < d9.c1

// P&D: oxirgi 50 bar diapazoni
pdHi = ta.highest(high, 50)
pdLo = ta.lowest(low, 50)
pdPos = (pdHi - pdLo) > 0 ? (close - pdLo) / (pdHi - pdLo) : 0.5
inDisc = pdPos < 0.5
inPrem = pdPos > 0.5

// Range aniqlash: joriy ATR o'rtachadan past
atrAvg = ta.sma(atr, 50)
isRange = avoidRange and not na(atrAvg) and atr < atrAvg * rangeATRmult

// ================================================== S1 – S4 SETUP
f_base(int scalpEM, int entryEM, int entryRet, int scalpRet,
       int intraEM, bool hcsM1) =>
    // S1: SCALP EM + ENTRY EM + ENTRY retest  (asosiy)
    bool a1 = useS1 and scalpEM > 0 and entryEM > 0 and entryRet > 0
    // S2: S1 + SCALP ham retest bo'lgan      (kuchliroq)
    bool a2 = useS2 and scalpEM > 0 and scalpRet > 0 and entryEM > 0 and entryRet > 0
    // S3: INTRA moslashuvi bor, ENTRY retest  (HTF qo'llab-quvvatlaydi)
    bool a3 = useS3 and intraEM > 0 and entryEM > 0 and entryRet > 0
    // S4: M1 HCS + ENTRY retest              (oldin faqat HCS edi -> 706 ta soxta)
    bool a4 = useS4 and hcsM1 and entryRet > 0
    string t = a2 ? "S2" : a1 ? "S1" : a3 ? "S3" : a4 ? "S4" : ""
    [a1 or a2 or a3 or a4, t]

[baseB, typeB] = f_base(cntScalpEM_B, cntEntryEM_B, cntEntryRet_B, cntScalpRet_B, cntIntraEM_B, hcsM1_B)
[baseS, typeS] = f_base(cntScalpEM_S, cntEntryEM_S, cntEntryRet_S, cntScalpRet_S, cntIntraEM_S, hcsM1_S)

// INTRA moslashuvi (bonus)
intraAlignB = cntIntraEM_B > 0
intraAlignS = cntIntraEM_S > 0

// ============================================================ GUARDS
inSess = not useSess or not na(time(timeframe.period, sessStr))

var int lossToday = 0
var int lastDay = na
if dayofmonth != lastDay
    lossToday := 0
    lastDay := dayofmonth
if strategy.closedtrades > nz(strategy.closedtrades[1])
    if strategy.closedtrades.profit(strategy.closedtrades - 1) < 0
        lossToday += 1
guardOK = not useDayGuard or lossToday < maxLossDay

var int lastSigBar = na
coolOK = na(lastSigBar) or (bar_index - lastSigBar) >= coolBars

// ======================================================= DEBUG SANOQ
var int nBase = 0
var int nLaol = 0
var int nScalp = 0
var int nAll = 0
var int nS1 = 0
var int nS2 = 0
var int nS3 = 0
var int nS4 = 0

rawB = baseB and barstate.isconfirmed
rawS = baseS and barstate.isconfirmed

var int nBlockPos = 0
var int nBlkSess = 0
var int nBlkGuard = 0
var int nBlkCool = 0

if rawB or rawS
    nBase += 1
    tt = rawB ? typeB : typeS
    if tt == "S1"
        nS1 += 1
    if tt == "S2"
        nS2 += 1
    if tt == "S3"
        nS3 += 1
    if tt == "S4"
        nS4 += 1
    // ikkala tomonni ham tekshirish
    lb = (rawB and (not needLAOLbreak or laolBrokeB)) or
         (rawS and (not needLAOLbreak or laolBrokeS))
    if lb
        nLaol += 1
        sr = (rawB and (not needScalpRet or scalpFuRet_B)) or
             (rawS and (not needScalpRet or scalpFuRet_S))
        if sr
            nScalp += 1
            if not inSess
                nBlkSess += 1
            else if not guardOK
                nBlkGuard += 1
            else if not coolOK
                nBlkCool += 1
            else if strategy.position_size != 0 and not allowPyramid
                nBlockPos += 1
            else
                nAll += 1

// ============================================================= ENTRY
canTrade = tradingOn and inSess and guardOK and coolOK and
     (allowPyramid or strategy.position_size == 0) and barstate.isconfirmed

// ---- BAZA (CONFIRMED darajasi): S1-S4 shakllandi ----
confB = baseB
confS = baseS

// ---- setup oynasi: baza qachon shakllangan? ----
var int baseBarB = na
var int baseBarS = na
if confB
    baseBarB := bar_index
if confS
    baseBarS := bar_index
inWinB = not na(baseBarB) and (bar_index - baseBarB) <= setupWindow
inWinS = not na(baseBarS) and (bar_index - baseBarS) <= setupWindow

// ---- FINAL darajasi: baza + qo'shimcha tasdiqlar ----
okLaolB  = not needLAOLbreak or laolBrokeB
okLaolS  = not needLAOLbreak or laolBrokeS
okScalpB = not needScalpRet  or scalpFuRet_B
okScalpS = not needScalpRet  or scalpFuRet_S

// --- tasdiqlar sonini hisoblash ---
confCntB = (baseB ? 1 : 0) + (cntIntraEM_B > 0 ? 1 : 0) +
     (laolBrokeB ? 1 : 0) + (scalpFuRet_B ? 1 : 0)
confCntS = (baseS ? 1 : 0) + (cntIntraEM_S > 0 ? 1 : 0) +
     (laolBrokeS ? 1 : 0) + (scalpFuRet_S ? 1 : 0)

// --- WR filtrlari ---
wrOKb = (not needMTFalign or htfBear) and (not needPDzone or inPrem) and
     confCntB >= minSetupCnt and not isRange
wrOKs = (not needMTFalign or htfBull) and (not needPDzone or inDisc) and
     confCntS >= minSetupCnt and not isRange

finalB = inWinB and okLaolB and okScalpB and wrOKb
finalS = inWinS and okLaolS and okScalpS and wrOKs

// ---- yakuniy shartlar ----
// FINAL ustunlikka ega: agar ikkalasi yoqilgan bo'lsa va FINAL bajarilsa,
// savdo FINAL sifatida belgilanadi
shortFinal = canTrade and useFINAL and finalB
longFinal  = canTrade and useFINAL and finalS
shortConf  = canTrade and useCONF  and confB and wrOKb and not shortFinal
longConf   = canTrade and useCONF  and confS and wrOKs and not longFinal

shortCond = shortFinal or shortConf
longCond  = longFinal or longConf

lvlTagB = shortFinal ? "FINAL" : "CONF"
lvlTagS = longFinal  ? "FINAL" : "CONF"

var float curE = na
var float curSL = na
var float curTP = na
var float curR = na
var string curDir = ""
var bool beDone = false

rAmt = riskMode == "Dollar $" ? risk_usd : strategy.equity * risk_pct / 100
lo10 = ta.lowest(low, 10)
hi10 = ta.highest(high, 10)

f_slLong(float lw, float lo10v) =>
    float b = slMode == "Swing" ? math.min(lw, nz(lo10v, lw)) : lw
    float e = b - atr * slBufATR
    math.max(e, close - atr * slMaxATR)

f_slShort(float hg, float hi10v) =>
    float b = slMode == "Swing" ? math.max(hg, nz(hi10v, hg)) : hg
    float e = b + atr * slBufATR
    math.min(e, close + atr * slMaxATR)

if longCond
    sl = f_slLong(low, lo10)
    r = close - sl
    if r > 0
        tp = close + r * tpMult
        q = rAmt / r
        strategy.entry("L", strategy.long, qty = q, comment = typeS + "|" + lvlTagS)
        if usePartial
            strategy.exit("L-p1", "L", qty_percent = p1Pct,
                 stop = sl, limit = close + r * p1RR)
            strategy.exit("L-p2", "L", stop = sl, limit = tp)
        else
            strategy.exit("Lx", "L", stop = sl, limit = tp)
        curE := close
        curSL := sl
        curTP := tp
        curR := r
        curDir := "LONG"
        beDone := false
        lastSigBar := bar_index

if shortCond
    sl = f_slShort(high, hi10)
    r = sl - close
    if r > 0
        tp = close - r * tpMult
        q = rAmt / r
        strategy.entry("S", strategy.short, qty = q, comment = typeB + "|" + lvlTagB)
        if usePartial
            strategy.exit("S-p1", "S", qty_percent = p1Pct,
                 stop = sl, limit = close - r * p1RR)
            strategy.exit("S-p2", "S", stop = sl, limit = tp)
        else
            strategy.exit("Sx", "S", stop = sl, limit = tp)
        curE := close
        curSL := sl
        curTP := tp
        curR := r
        curDir := "SHORT"
        beDone := false
        lastSigBar := bar_index

// ---- BREAKEVEN ko'chirish ----
if useBE and strategy.position_size != 0 and not beDone and not na(curR)
    if curDir == "LONG" and high >= curE + curR * beAtRR
        beDone := true
        curSL := curE
        if usePartial
            strategy.exit("L-p2", "L", stop = curE, limit = curTP)
        else
            strategy.exit("Lx", "L", stop = curE, limit = curTP)
    if curDir == "SHORT" and low <= curE - curR * beAtRR
        beDone := true
        curSL := curE
        if usePartial
            strategy.exit("S-p2", "S", stop = curE, limit = curTP)
        else
            strategy.exit("Sx", "S", stop = curE, limit = curTP)

inPos = strategy.position_size != 0
plot(showLevels and inPos ? curE  : na, "Entry", color.new(color.blue, 0), 2, plot.style_linebr)
plot(showLevels and inPos ? curSL : na, "SL",    color.new(color.red, 0),  2, plot.style_linebr)
plot(showLevels and inPos ? curTP : na, "TP",    color.new(color.green, 0),2, plot.style_linebr)

plotshape(longCond,  "LONG",  shape.triangleup,   location.belowbar, color.new(color.green,0), size = size.small)
plotshape(shortCond, "SHORT", shape.triangledown, location.abovebar, color.new(color.red,0),   size = size.small)

// ================================================ SETUP STATISTIKASI
var int cS1 = 0
var int cS2 = 0
var int cS3 = 0
var int cS4 = 0
var int wS1 = 0
var int wS2 = 0
var int wS3 = 0
var int wS4 = 0
var float pS1 = 0.0
var float pS2 = 0.0
var float pS3 = 0.0
var float pS4 = 0.0

var int cFIN = 0
var int wFIN = 0
var float pFIN = 0.0
var int cCNF = 0
var int wCNF = 0
var float pCNF = 0.0

if strategy.closedtrades > nz(strategy.closedtrades[1])
    ix = strategy.closedtrades - 1
    pr = strategy.closedtrades.profit(ix)
    cm = nz(strategy.closedtrades.entry_comment(ix), "")
    // --- setup turi ---
    if str.contains(cm, "S1")
        cS1 += 1
        pS1 += pr
        if pr > 0
            wS1 += 1
    if str.contains(cm, "S2")
        cS2 += 1
        pS2 += pr
        if pr > 0
            wS2 += 1
    if str.contains(cm, "S3")
        cS3 += 1
        pS3 += pr
        if pr > 0
            wS3 += 1
    if str.contains(cm, "S4")
        cS4 += 1
        pS4 += pr
        if pr > 0
            wS4 += 1
    // --- kirish darajasi ---
    if str.contains(cm, "FINAL")
        cFIN += 1
        pFIN += pr
        if pr > 0
            wFIN += 1
    else if str.contains(cm, "CONF")
        cCNF += 1
        pCNF += pr
        if pr > 0
            wCNF += 1

// ========================================================= DASHBOARD
var table dash = na
var table dbg  = na
cB = color.new(color.green, 60)
cR = color.new(color.red, 60)
cN = color.new(color.gray, 60)

f_row(table t, int r, string k, string v, color bg) =>
    table.cell(t, 0, r, k, text_color = color.new(color.white, 15),
         text_size = size.small, bgcolor = color.new(color.black, 25),
         text_halign = text.align_left)
    table.cell(t, 1, r, v, text_color = color.white, text_size = size.small,
         bgcolor = bg, text_halign = text.align_right)

f_wr(int w, int c) => c > 0 ?
     str.tostring(w) + "/" + str.tostring(c) + "  " +
     str.tostring(w * 100.0 / c, "#") + "%" : "—"

if showDash and barstate.islast
    table.delete(dash)
    dash := table.new(position.top_right, 2, 18, border_width = 1,
         frame_color = color.new(color.gray, 50), frame_width = 1)
    table.cell(dash, 0, 0, "BETA 1 + LAOL", text_color = color.white,
         text_size = size.normal, bgcolor = color.new(color.blue, 35))
    table.cell(dash, 1, 0, syminfo.ticker + " " + timeframe.period,
         text_color = color.white, text_size = size.normal,
         bgcolor = color.new(color.blue, 35))

    f_row(dash, 1, "ENTRY EM (B/S)",
         str.tostring(cntEntryEM_B) + " / " + str.tostring(cntEntryEM_S), cN)
    f_row(dash, 2, "SCALP EM (B/S)",
         str.tostring(cntScalpEM_B) + " / " + str.tostring(cntScalpEM_S), cN)
    f_row(dash, 3, "INTRA EM (B/S)",
         str.tostring(cntIntraEM_B) + " / " + str.tostring(cntIntraEM_S), cN)
    f_row(dash, 4, "Joriy setup",
         (typeB != "" ? "BEAR " + typeB : "") +
         (typeS != "" ? (typeB != "" ? " | " : "") + "BULL " + typeS : "") +
         (typeB == "" and typeS == "" ? "—" : ""),
         typeB != "" ? cR : typeS != "" ? cB : cN)

    table.cell(dash, 0, 5, "SETUP STATISTIKASI", text_color = color.white,
         text_size = size.small, bgcolor = color.new(color.blue, 50))
    table.cell(dash, 1, 5, "win/jami  WR", text_color = color.white,
         text_size = size.small, bgcolor = color.new(color.blue, 50))
    f_row(dash, 6, "S1", f_wr(wS1, cS1), cS1 > 0 ? (pS1 > 0 ? cB : cR) : cN)
    f_row(dash, 7, "S2", f_wr(wS2, cS2), cS2 > 0 ? (pS2 > 0 ? cB : cR) : cN)
    f_row(dash, 8, "S3", f_wr(wS3, cS3), cS3 > 0 ? (pS3 > 0 ? cB : cR) : cN)
    f_row(dash, 9, "S4", f_wr(wS4, cS4), cS4 > 0 ? (pS4 > 0 ? cB : cR) : cN)
    f_row(dash, 10, "JAMI / Net",
         str.tostring(strategy.closedtrades) + "  /  " +
         str.tostring(strategy.netprofit, "#.#"),
         strategy.closedtrades >= 50 ?
         (strategy.netprofit > 0 ? cB : cR) : color.new(color.orange, 60))

    table.cell(dash, 0, 11, "KIRISH DARAJASI", text_color = color.white,
         text_size = size.small, bgcolor = color.new(color.purple, 40))
    table.cell(dash, 1, 11, "win/jami  WR  avgPnL", text_color = color.white,
         text_size = size.small, bgcolor = color.new(color.purple, 40))
    f_row(dash, 12, "FINAL (sifatli)",
         f_wr(wFIN, cFIN) + (cFIN > 0 ? "  " + str.tostring(pFIN / cFIN, "#.#") : ""),
         cFIN > 0 ? (pFIN > 0 ? cB : cR) : cN)
    f_row(dash, 13, "CONFIRMED (ko'p)",
         f_wr(wCNF, cCNF) + (cCNF > 0 ? "  " + str.tostring(pCNF / cCNF, "#.#") : ""),
         cCNF > 0 ? (pCNF > 0 ? cB : cR) : cN)
    f_row(dash, 14, "Rejim", entryLevel, color.new(color.purple, 60))

    theoWR = 100.0 / (1.0 + tpMult)
    actWR = strategy.closedtrades > 0 ?
         strategy.wintrades * 100.0 / strategy.closedtrades : 0
    f_row(dash, 15, "RR / kutilgan WR",
         "1:" + str.tostring(tpMult, "#.#") + "  ->  " +
         str.tostring(theoWR, "#.#") + "%",
         tpMult > 5 ? color.new(color.orange, 60) : cN)
    f_row(dash, 16, "WR filtrlari",
         (needMTFalign ? "HTF " : "") + (needPDzone ? "P&D " : "") +
         (avoidRange ? "noRange " : "") + "min" + str.tostring(minSetupCnt) +
         "  (tasdiq: " + str.tostring(math.max(confCntB, confCntS)) + ")",
         cN)
    f_row(dash, 17, "Haqiqiy WR",
         str.tostring(actWR, "#.#") + "%" +
         (strategy.closedtrades > 20 ?
          (actWR > theoWR ? "  ✓ edge" : "  ✗ edge yo'q") : "  (n kam)"),
         strategy.closedtrades > 20 ? (actWR > theoWR ? cB : cR) : cN)

if showDebug and barstate.islast
    table.delete(dbg)
    dbg := table.new(position.bottom_left, 2, 13, border_width = 1,
         frame_color = color.new(color.gray, 50), frame_width = 1)
    table.cell(dbg, 0, 0, "DEBUG — nega savdo yo'q?", text_color = color.white,
         text_size = size.small, bgcolor = color.new(color.orange, 40))
    table.cell(dbg, 1, 0, "soni", text_color = color.white,
         text_size = size.small, bgcolor = color.new(color.orange, 40))
    f_row(dbg, 1, "① CONFIRMED (S1-S4 baza)", str.tostring(nBase),
         nBase > 100 ? cB : color.new(color.orange, 60))
    f_row(dbg, 2, "② + LAOL buzildi", str.tostring(nLaol),
         nLaol > 50 ? cB : color.new(color.orange, 60))
    f_row(dbg, 3, "③ + SCALP retest = FINAL", str.tostring(nScalp),
         nScalp > 50 ? cB : color.new(color.orange, 60))
    f_row(dbg, 4, "④ O'TDI (savdo ochilishi mumkin)", str.tostring(nAll),
         nAll >= 50 ? cB : cR)
    f_row(dbg, 5, "   ✗ sessiya to'sdi", str.tostring(nBlkSess),
         nBlkSess > 0 ? color.new(color.orange, 60) : cN)
    f_row(dbg, 6, "   ✗ kunlik limit to'sdi", str.tostring(nBlkGuard),
         nBlkGuard > 50 ? cR : cN)
    f_row(dbg, 7, "   ✗ cooldown to'sdi", str.tostring(nBlkCool),
         nBlkCool > 50 ? cR : cN)
    f_row(dbg, 8, "   ✗ pozitsiya band", str.tostring(nBlockPos),
         nBlockPos > 50 ? cR : cN)
    f_row(dbg, 9, "OCHILGAN SAVDO", str.tostring(strategy.closedtrades),
         strategy.closedtrades >= 50 ? cB : cR)
    f_row(dbg, 10, "Baza turlari S1/S2/S3/S4",
         str.tostring(nS1) + "/" + str.tostring(nS2) + "/" +
         str.tostring(nS3) + "/" + str.tostring(nS4), cN)
    f_row(dbg, 11, "Aktiv quti / LAOL",
         str.tostring(array.size(boxes)) + " / " + str.tostring(array.size(laols)), cN)
    f_row(dbg, 12, "FINAL filtri qoldirdi",
         nBase > 0 ? str.tostring(nScalp * 100.0 / nBase, "#") + "%  (" +
         str.tostring(nBase) + " -> " + str.tostring(nScalp) + ")" : "—",
         nBase > 0 and nScalp * 100.0 / nBase < 5 ? cR : cN)

// ============================================================ ALERTS
alertcondition(longCond,  "LONG",  "BETA1 LONG")
alertcondition(shortCond, "SHORT", "BETA1 SHORT")
